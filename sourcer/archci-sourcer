#!/bin/bash
# archci-sourcer -- claim src jobs from the master and fetch each one's
# sources into a source package. Runs on the sourcer host as root, as a
# service (archci-sourcer.service; the worker key is root's); the one host
# of the farm that talks to upstream.
# It is a worker for the arch "src": it claims with the worker key (`claim
# <host> src`, once a minute while idle), and for each job exports the
# PKGBUILD directory at the job's commit from a bare mirror of the PKGBUILD
# repository and runs the fetch in a clean chroot (devtools' mkarchroot,
# refreshed like a build's; a fresh copy per job, entered with
# arch-nspawn, network kept: this is the online pass): there, as the build
# user, the keys the PKGBUILD names are imported from keys/pgp/ and
# refreshed from the keyservers, and `makepkg --allsource --ignorearch`
# downloads every source of every arch, checksums and signature-checks
# them and packs <pkgbase>-<version>.src.tar.gz. A PKGBUILD is sourced
# only inside the container. SRCDEST is the host's, kept between jobs and
# pruned like a worker's. The source package is signed with this host's
# builder key (archci-worker-setup's; made here if missing, to authorize on
# the signer with archci authorize-builder) and handed in like a build's
# packages (rsync into incoming/, then `report`). The master pools it under
# <repo>/os/src, the signer releases it beside the arches, and a build
# claim then names it to the worker (sources=). A fetch that fails is a
# failed job: its makepkg log is the attempt's log, and housekeeping
# retries it like a build.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

# A package upgrade replaces this script and the library under a running
# sourcer; the loop notices and re-executes itself between jobs.
self=$(readlink -f "${BASH_SOURCE[0]}")
code_files=("$self" "$ARCHCI_ROOT/lib/archci-common.sh")
code_sig=$(stat -c '%i %Y %s' "${code_files[@]}" | tr '\n' ' ')

for tool in git gpg rsync mkarchroot arch-nspawn; do
	command -v "$tool" >/dev/null || archci_die "$tool is not installed"
done
[[ -n $ARCHCI_MASTER ]] || archci_die "ARCHCI_MASTER is not set in $ARCHCI_CONF"
[[ -r $ARCHCI_WORKER_KEY ]] || archci_die "no ssh key at $ARCHCI_WORKER_KEY"
(( EUID == 0 )) || archci_die "must run as root (the worker key is root's; the chroot needs it)"
export GIT_TERMINAL_PROMPT=0
me=${HOSTNAME%%.*}
archci_valid_worker "$me" || archci_die "hostname makes an invalid worker id: $me"
# the builder key signs every source package, as a worker's signs its
# packages; the signer takes only keys it was given (archci authorize-builder)
install -d -m 700 "$ARCHCI_BUILDER_GNUPGHOME"
if ! gpg --homedir "$ARCHCI_BUILDER_GNUPGHOME" --batch --list-secret-keys "archci-builder@$me" >/dev/null 2>&1; then
	gpg --homedir "$ARCHCI_BUILDER_GNUPGHOME" --batch --pinentry-mode loopback --passphrase "" \
		--quick-generate-key "archci builder $me <archci-builder@$me>" ed25519 sign never
	gpg --homedir "$ARCHCI_BUILDER_GNUPGHOME" --batch --yes --armor --export "archci-builder@$me" >/etc/archci/builder_key.pub
	archci_log "generated the builder key in $ARCHCI_BUILDER_GNUPGHOME; on the signer: archci authorize-builder builder_key.pub (this host's /etc/archci/builder_key.pub)"
fi

# devtools' own helpers: lock, lock_close, is_btrfs, is_subvolume,
# subvolume_delete_recursive (archci_chroot_copy uses them; the copy is made
# here, makechrootpkg keeps that to itself). Its common.sh is not
# nounset-clean, so drop -u before sourcing.
export DEVTOOLS_COLOR=never
set +u
source /usr/share/devtools/lib/common.sh
source /usr/share/devtools/lib/archroot.sh

user=archci
home=$ARCHCI_SOURCER_HOME
mirror=$home/pkgbuilds.git
srcdest=$home/srcdest
jobsdir=$home/jobs
gnupghome=$home/gnupg      # the upstream signing keys, the build user's inside the chroot
mkdir -p "$srcdest" "$jobsdir"
install -d -m 700 -o "$user" -g "$(id -gn "$user")" "$gnupghome"
chown "$user" "$srcdest"
uid=$(id -u "$user") gid=$(id -g "$user")

# --- the chroot: the sourcer's own, x86_64 with the mirrors' extra profile,
# base-devel plus what makepkg fetches with; one copy, remade per job.
# The chroots live on a btrfs subvolume when the filesystem allows (a
# snapshot per job), a plain directory otherwise (an rsync per job).
chroot=$ARCHCI_CHROOTS/src
copy=$chroot/fetch
pacconf=$(archci_arch_conf x86_64 extra.conf /usr/share/devtools/pacman.conf.d/extra.conf)
mkconf=$(archci_arch_conf x86_64 makepkg.conf /usr/share/devtools/makepkg.conf.d/x86_64.conf)
cachedir=$(pacman-conf --config "$pacconf" CacheDir | head -1)
: "${cachedir:=/var/cache/pacman/pkg/}"
base_packages=(base-devel git gnupg)
if [[ ! -e $ARCHCI_CHROOTS ]]; then
	if [[ $(stat -f -c %T "$(dirname "$ARCHCI_CHROOTS")") == btrfs ]]; then btrfs subvolume create "$ARCHCI_CHROOTS" >/dev/null
	else mkdir -p "$ARCHCI_CHROOTS"
	fi
fi
say() { printf '%s\n' "$*" | tee -a "$log"; }   # the fetch's log, and the journal for archci top

# the root from the mirrors; complete only with devtools' marker in it
create_root() {
	subvolume_delete_recursive "$chroot/root" 2>/dev/null || true
	rm -rf --one-file-system "$chroot/root"
	mkarchroot -C "$pacconf" -M "$mkconf" -c "$cachedir" "$chroot/root" "${base_packages[@]}" 2>&1 | tee -a "$log"
	[[ -f $chroot/root/.arch-chroot ]]
}
# create once (once more on failure: a cached package that fails its
# signature is dropped by pacman on the first try), refresh every
# ARCHCI_CHROOT_UPDATE_MINUTES, recreate on a devtools bump; under the
# root's lock, as a worker's. 1 without a usable root.
prepare_root() {
	local have=''
	[[ -f $chroot/root/.arch-chroot ]] && have=$(<"$chroot/root/.arch-chroot")
	if [[ ! -d $chroot/root || $have != "$CHROOT_VERSION" ]]; then
		say "==> Creating chroot $chroot/root (version $CHROOT_VERSION)"
		subvolume_delete_recursive "$copy" 2>/dev/null || true
		rm -rf --one-file-system "$copy"
		(umask 0022; mkdir -p "$chroot")
		if ! create_root; then
			say "==> creating the chroot failed; trying once more"
			create_root || return 1
		fi
		touch "$chroot/root.updated"
	elif [[ -z $(find "$chroot/root.updated" -mmin -"$ARCHCI_CHROOT_UPDATE_MINUTES" 2>/dev/null) ]]; then
		say "==> Updating chroot $chroot/root"
		arch-nspawn -C "$pacconf" -M "$mkconf" -c "$cachedir" "$chroot/root" pacman -Syu --noconfirm 2>&1 | tee -a "$log" || true
		touch "$chroot/root.updated"
	fi
}

# a fresh copy of the root (archci_chroot_copy), with the build user (the
# archci user's ids, so what it writes to the bound SRCDEST and keyring is
# the host user's), the directories makepkg is told to use
# (archci_chroot_prepare), and the fetch script it runs
prepare_copy() {
	archci_chroot_copy "$chroot/root" "$copy" || return 1
	archci_chroot_prepare "$copy" "$uid" "$gid" "$ARCHCI_PACKAGER"
	# the fetch, as the build user. "sources": the keys the PKGBUILD names
	# (keys/pgp/, then the keyservers), .SRCINFO for the host, then every
	# source. "vendor VAR=VALUE...": the dependencies makepkg -o's prepare()
	# fetches, with the ecosystems' caches directed by the environment given
	# (archci_vendor_env capture), the makedepends installed first.
	cat >"$copy/chrootfetch" <<-SCRIPT
		#!/bin/bash
		. /etc/profile
		mode=\$1; shift
		if [[ \$mode == vendor ]]; then pacman -Sy --noconfirm >/dev/null 2>&1 || true; fi
		exec runuser -u builduser -- bash -c '
			set -e
			mode=\$1; shift
			export HOME=/build GNUPGHOME=/build/.gnupg
			cd /startdir
			if [[ \$mode == vendor ]]; then
				export "\$@"
				exec makepkg -o -s --noconfirm --ignorearch
			fi
			if compgen -G "keys/pgp/*.asc" >/dev/null; then gpg --batch --quiet --import keys/pgp/*.asc 2>/dev/null || true; fi
			makepkg --printsrcinfo >.SRCINFO 2>/dev/null || true
			mapfile -t fp < <(sed -n "s/^\\\\tvalidpgpkeys = //p" .SRCINFO)
			if (( \${#fp[@]} )); then
				for ks in $ARCHCI_KEYSERVERS; do timeout 120 gpg --batch --quiet --keyserver "\$ks" --recv-keys "\${fp[@]}" 2>/dev/null || true; done
			fi
			exec makepkg --allsource --ignorearch' _ "\$mode" "\$@"
	SCRIPT
	chmod 755 "$copy/chrootfetch"
}

# --- the PKGBUILD repository: one bare mirror, the directory exported at the commit
export_pkgbuild() {   # export_pkgbuild PKGBASE COMMIT DIR
	local subdir=$ARCHCI_PKGBUILDS_DIR/$1 commit=$2 dir=$3 depth
	[[ -d $mirror ]] || git clone -q --bare "$ARCHCI_PKGBUILDS_URL" "$mirror"
	git -C "$mirror" remote set-url origin "$ARCHCI_PKGBUILDS_URL"
	if ! git -C "$mirror" cat-file -e "$commit^{commit}" 2>/dev/null; then
		git -C "$mirror" fetch -q origin "$commit" 2>/dev/null ||
			git -C "$mirror" fetch -q origin "+refs/heads/$ARCHCI_PKGBUILDS_BRANCH:refs/heads/$ARCHCI_PKGBUILDS_BRANCH"
	fi
	git -C "$mirror" cat-file -e "$commit^{commit}" 2>/dev/null || return 1
	depth=$(( $(printf '%s' "$subdir" | tr -cd / | wc -c) + 1 ))
	git -C "$mirror" archive --format=tar "$commit" "$subdir" 2>/dev/null | tar -x --strip-components="$depth" -C "$dir" || return 1
	[[ -f $dir/PKGBUILD ]]
}

# --- the file names a PKGBUILD downloads (every arch; VCS sources are clones, not files)
source_files() {   # source_files DIR
	sed -n 's/^\tsource\(_[a-z0-9_]*\)\? = //p' "$1/.SRCINFO" 2>/dev/null | while read -r src; do
		case $src in
			git+*|git://*|hg+*|svn+*|bzr+*|fossil+*) continue ;;
			*::*) printf '%s\n' "${src%%::*}" ;;
			*://*) printf '%s\n' "${src##*/}" ;;
			*) continue ;;   # a file in the package directory itself
		esac
	done | sort -u
}

# --- one job: fetch_one JOBDIR (the job's fields are read); its results in
# JOBDIR/out: the source package, its .buildsig and build.log. The
# container runs under MACHINE (a scope of its own, for the heartbeat's
# stats and for a stop).
fetch_one() {
	local jobdir=$1 w=$1/work out=$1/out rc f names name
	log=$out/build.log
	rm -rf "$w"
	mkdir -p "$w"/{pkg,out} "$out"
	: >"$log"
	# SRCDEST is kept between jobs (a pkgrel bump downloads nothing); files
	# not used for ARCHCI_SRCDEST_KEEP_DAYS go
	find "$srcdest" -mindepth 1 -atime +"$ARCHCI_SRCDEST_KEEP_DAYS" -delete 2>/dev/null || true
	if ! export_pkgbuild "$job_pkgbase" "$job_commit" "$w/pkg"; then
		say "==> no $ARCHCI_PKGBUILDS_DIR/$job_pkgbase at $job_commit in $ARCHCI_PKGBUILDS_URL"
		return 1
	fi
	chown -R "$uid:$gid" "$w"
	lock 9 "$chroot/root.lock" "Waiting for the clean chroot"
	if ! prepare_root; then
		lock_close 9
		say "==> no clean chroot to fetch in"
		return 1
	fi
	lock_close 9
	prepare_copy || { say "==> could not make the chroot copy $copy"; return 1; }
	# (no -C/-M here: arch-nspawn would copy them over the copy's own
	# pacman.conf and makepkg.conf, which prepare_copy just wrote to)
	in_copy() {   # in_copy MODE ARGS... -- /chrootfetch in the copy, within the fetch's time
		timeout "$(( ARCHCI_SOURCER_TIMEOUT_MINUTES * 60 ))" \
			arch-nspawn -c "$cachedir" "$copy" --slice=archci-online --machine="$machine" --hostname="${HOSTNAME%%.*}" \
				--bind="$w/pkg:/startdir" --bind="$srcdest:/srcdest" --bind="$w/out:/srcpkgdest" --bind="$gnupghome:/build/.gnupg" --bind="$w/vendor:/vendor" \
				"$ARCHCI_CONTAINER_TMP" /chrootfetch "$@" 2>&1 | tee -a "$log"
	}
	run_fetch() { in_copy sources; }
	install -d -o "$uid" -g "$gid" "$w/vendor"
	say "==> Fetching the sources of $job_pkgbase $job_version in $copy"
	if run_fetch; then rc=0
	else
		rc=$?
		# a file of the same name in SRCDEST from another package or version:
		# drop this package's names from it and let makepkg fetch them upstream
		mapfile -t names < <(source_files "$w/pkg")
		if (( rc != 124 && ${#names[@]} )) && grep -q "did not pass the validity check" "$log"; then
			for name in "${names[@]}"; do rm -f "$srcdest/$name"; done
			say "==> a cached file failed its checksum; fetching upstream"
			if run_fetch; then rc=0; else rc=$?; fi
		fi
	fi
	(( rc == 124 )) && say "==> timed out after $ARCHCI_SOURCER_TIMEOUT_MINUTES min"
	f=$(find "$w/out" -maxdepth 1 -name '*.src.tar.gz' -print -quit)
	# what makepkg's "-> Adding <name>..." packed, with each source's size and
	# kind (a git checkout, or a plain file), read back from the source package
	if (( rc == 0 )) && [[ -n $f ]]; then
		say "==> packaged sources:"
		tar -tzvf "$f" 2>/dev/null | awk -v pb="$job_pkgbase" '
			{ n=$NF; sub("^"pb"/","",n); top0=n; sub("/.*","",top0); if (n=="" || n=="PKGBUILD" || n==".SRCINFO" || top0=="keys") next
			  i=index(n,"/"); top=(i? substr(n,1,i-1):n); sz[top]+=$3; if(i) dir[top]=1 }
			END { for (t in sz) printf "      %8.1f MiB  %s%s\n", sz[t]/1048576, t, (dir[t]?" (git checkout)":"") }' \
			| sort -k1 -rn | while IFS= read -r line; do say "$line"; done
	fi
	# the dependencies prepare() fetches (archci_vendor_kinds): captured
	# into vendor/ by a makepkg -o in the same copy, the makedepends
	# installed, and put into the source package as <pkgbase>/vendor/<kind>;
	# a kind not captured yet is fetched at build time
	if (( rc == 0 )) && [[ -n $f ]]; then
		local kinds=() capture=() env=() k
		mapfile -t kinds < <(archci_vendor_kinds "$w/pkg/PKGBUILD")
		for k in "${kinds[@]}"; do
			if archci_vendor_supported "$k"; then capture+=("$k"); mapfile -t -O "${#env[@]}" env < <(archci_vendor_env "$k" capture /vendor)
			else say "==> $k dependencies are fetched at build time (their capture is not written yet)"
			fi
		done
		if (( ${#capture[@]} )); then
			say "==> Capturing the ${capture[*]} dependencies prepare() fetches (makepkg -o, ${env[*]})"
			# once more on failure: a cached package that fails its signature
			# is dropped by pacman on the first try (as for the chroot itself)
			if in_copy vendor "${env[@]}" || { say "==> the capture failed; trying once more"; in_copy vendor "${env[@]}"; }; then
				# what a cache keeps that a replay does not need: cargo's lock, and crates it extracted
				rm -rf "$w/vendor/rust/.package-cache" "$w/vendor/rust/registry/src"
				if archci_srcpkg_add_vendor "$f" "$job_pkgbase" "$w/vendor"; then
					say "==> vendored: $(du -sh "$w/vendor" | cut -f1) of ${capture[*]} dependencies in the source package"
					# a CycloneDX SBOM of the vendored Rust crates, into the source package
					if [[ " ${capture[*]} " == *" rust "* ]]; then
						archci_sbom_rust "$w/vendor" "$job_pkgbase" "$job_version" >"$w/sbom.cdx.json"
						if archci_srcpkg_add_file "$f" "$job_pkgbase" "$w/sbom.cdx.json" "sbom.cdx.json"; then
							say "==> SBOM: $(grep -c '"purl": "pkg:cargo' "$w/sbom.cdx.json") crates in sbom.cdx.json"
						else say "==> could not add the SBOM to ${f##*/}"; fi
					fi
				else
					say "==> could not add vendor/ to ${f##*/}"; rc=1
				fi
			else
				rc=$?; (( rc == 124 )) && say "==> the capture timed out after $ARCHCI_SOURCER_TIMEOUT_MINUTES min"
				say "==> capturing the ${capture[*]} dependencies failed"
			fi
		fi
	fi
	if (( rc == 0 )) && [[ -n $f ]]; then
		mv "$f" "$out/${f##*/}"
		if gpg --homedir "$ARCHCI_BUILDER_GNUPGHOME" --batch --yes --detach-sign -u "$ARCHCI_BUILDER_KEY" -o "$out/${f##*/}.buildsig" "$out/${f##*/}"; then
			say "==> made and builder-signed ${f##*/} ($(du -h "$out/${f##*/}" | cut -f1))"
		else
			say "==> could not sign ${f##*/} with the builder key"; rc=1
		fi
	elif (( rc == 0 )); then
		say "==> makepkg made no source package"; rc=1
	fi
	rm -rf "$w"
	(( rc == 0 ))
}

# the container's scope, for the heartbeat's stats and for a stop (archci_container_cgroup)
fetch_cgroup() { archci_container_cgroup "$machine"; }

# --- the loop, as archci-worker's
claim=$jobsdir/claim.tmp
machine=''
log=/dev/null
job_id=
reported=1
on_term() {
	trap - TERM INT
	local cg
	[[ -n $machine ]] && archci_container_stop "$machine"
	if [[ -n $job_id && $reported == 0 ]]; then
		archci_log "shutting down, handing $job_id back to the master"
		archci_master report "$job_id" abandoned "$me" || true
	fi
	exit 0
}
trap on_term TERM INT

archci_log "sourcer $me started, master $ARCHCI_MASTER, chroot $chroot"
while true; do
	if [[ $(stat -c '%i %Y %s' "${code_files[@]}" 2>/dev/null | tr '\n' ' ') != "$code_sig" ]]; then
		archci_log "archci-sourcer or its library changed on disk; restarting on the new code"
		exec "$self"
	fi
	# shellcheck disable=SC2046  # the stats are separate key=value words on purpose
	archci_claim "$me" src "$claim" $(archci_worker_stats "$home") || { sleep "$ARCHCI_IDLE_SLEEP"; continue; }
	reported=0
	# no ':' in the allowed set: an epoch version (1:1.3.2-3) would leave a
	# colon in the path, and systemd-nspawn --bind reads ':' as its
	# source:dest separator (a src job for such a package failed to bind)
	jobdir=$jobsdir/$(printf '%s' "$job_id" | tr -c 'A-Za-z0-9_.,-' '_')
	rm -rf "$jobdir"
	mkdir -p "$jobdir"
	mv "$claim" "$jobdir/job"
	archci_log "fetching $job_pkgbase $job_version ($job_id)"
	machine=$(archci_machine_name archci-fetch "$job_pkgbase")
	date +%s%6N >"$jobdir/started"   # the job's start, for the first CPU sample (archci_cgroup_stats)
	# each beat carries this machine's stats and the fetch's own: CPU, memory
	# and the size of what it has fetched so far, from the container's scope
	(
		trap - TERM INT
		set +e   # a beat that cannot be measured is still sent
		while sleep "$ARCHCI_HEARTBEAT_SECONDS"; do
			jobstats=phase=fetch
			cg=$(fetch_cgroup)
			if [[ -n $cg ]]; then
				s=$(archci_cgroup_stats "$cg" "$jobdir" "$jobdir/work" 'phase=fetch ')
				[[ -n $s ]] && jobstats=$s
			fi
			# shellcheck disable=SC2046,SC2086  # the stats are separate key=value words on purpose
			archci_master heartbeat "$job_id" "worker=$me" $(archci_worker_stats "$home") $jobstats >/dev/null 2>&1 || true
		done
	) &
	heartbeat=$!
	start=$(date +%s)
	status=failure
	fetch_one "$jobdir" && status=success
	machine=''
	kill "$heartbeat" 2>/dev/null || true
	wait "$heartbeat" 2>/dev/null || true
	archci_log "$job_id: $status after $(( ($(date +%s) - start) / 60 )) min: $(tail -n 1 "$jobdir/out/build.log" 2>/dev/null | cut -c1-160)"

	# the results to the master (kept and retried while it is away)
	archci_deliver "$job_id" "$jobdir/out" "$status" "$me" && reported=1
	rm -rf "$jobdir"
	job_id=
done
