#!/bin/bash
# archci-sourcer -- claim src jobs from the master and fetch each one's
# sources into a source package. Runs on the sourcer host as root, as a
# service (archci-sourcer.service; the worker key is root's; makepkg and gpg
# run as the archci user); the one host of the farm that talks to upstream.
# It is a worker for the arch "src": it claims with the worker key (`claim
# <host> src`, once a minute while idle), and for each job exports the
# PKGBUILD directory at the job's commit from a bare mirror of the PKGBUILD
# repository, imports the keys it names and refreshes them from the
# keyservers, runs `makepkg --allsource` (every source of every arch
# downloaded, checksummed, signature-checked, packed as
# <pkgbase>-<version>.src.tar.gz; SRCDEST is kept between jobs, pruned like
# a worker's), signs the source package with this host's builder key
# (archci-worker-setup's; made here if missing, to authorize on the signer
# with archci authorize-builder) and hands it in like a build's packages
# (rsync into incoming/, then `report`). The master pools it under
# <repo>/os/src, the signer releases it beside the arches, and a build claim
# then names it to the worker (sources=). A fetch that fails is a failed
# job: its makepkg log is the attempt's log, and housekeeping retries it
# like a build.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

# A package upgrade replaces this script and the library under a running
# sourcer; the loop notices and re-executes itself between jobs.
self=$(readlink -f "${BASH_SOURCE[0]}")
code_files=("$self" "$ARCHCI_ROOT/lib/archci-common.sh")
code_sig=$(stat -c '%i %Y %s' "${code_files[@]}" | tr '\n' ' ')

for tool in makepkg git gpg bsdtar debugedit rsync; do   # (makepkg insists on debugedit whatever it is asked)
	command -v "$tool" >/dev/null || archci_die "$tool is not installed"
done
[[ -n $ARCHCI_MASTER ]] || archci_die "ARCHCI_MASTER is not set in $ARCHCI_CONF"
[[ -r $ARCHCI_WORKER_KEY ]] || archci_die "no ssh key at $ARCHCI_WORKER_KEY"
(( EUID == 0 )) || archci_die "must run as root (the worker key is root's)"
export GIT_TERMINAL_PROMPT=0
me=${HOSTNAME%%.*}
archci_valid_worker "$me" || archci_die "hostname makes an invalid worker id: $me"
# the builder key signs every source package, as a worker's signs its
# packages; the signer takes only keys it was given (archci authorize-builder)
install -d -m 700 "$ARCHCI_BUILDER_GNUPGHOME"
if ! gpg --homedir "$ARCHCI_BUILDER_GNUPGHOME" --batch --list-secret-keys "archci-builder@$me" >/dev/null 2>&1; then
	gpg --homedir "$ARCHCI_BUILDER_GNUPGHOME" --batch --pinentry-mode loopback --passphrase "" \
		--quick-generate-key "archci builder $me <archci-builder@$me>" ed25519 sign never
	gpg --homedir "$ARCHCI_BUILDER_GNUPGHOME" --batch --yes --armor --export "archci-builder@$me" >/etc/archci/builder_key.pub
	archci_log "generated the builder key in $ARCHCI_BUILDER_GNUPGHOME; on the signer: archci authorize-builder builder_key.pub (this host's /etc/archci/builder_key.pub)"
fi

user=archci
home=$ARCHCI_SOURCER_HOME
mirror=$home/pkgbuilds.git
srcdest=$home/srcdest
jobsdir=$home/jobs
gnupghome=$home/gnupg
mkdir -p "$srcdest" "$jobsdir"
install -d -m 700 -o "$user" -g "$(id -gn "$user")" "$gnupghome"
chown "$user" "$srcdest"
# makepkg and gpg, as the archci user (makepkg refuses root)
as_user() { runuser -u "$user" -- env HOME="$home" GNUPGHOME="$gnupghome" "$@"; }

# --- the PKGBUILD repository: one bare mirror, the directory exported at the commit
export_pkgbuild() {   # export_pkgbuild PKGBASE COMMIT DIR
	local subdir=$ARCHCI_PKGBUILDS_DIR/$1 commit=$2 dir=$3 depth
	[[ -d $mirror ]] || git clone -q --bare "$ARCHCI_PKGBUILDS_URL" "$mirror"
	git -C "$mirror" remote set-url origin "$ARCHCI_PKGBUILDS_URL"
	if ! git -C "$mirror" cat-file -e "$commit^{commit}" 2>/dev/null; then
		git -C "$mirror" fetch -q origin "$commit" 2>/dev/null ||
			git -C "$mirror" fetch -q origin "+refs/heads/$ARCHCI_PKGBUILDS_BRANCH:refs/heads/$ARCHCI_PKGBUILDS_BRANCH"
	fi
	git -C "$mirror" cat-file -e "$commit^{commit}" 2>/dev/null || return 1
	depth=$(( $(printf '%s' "$subdir" | tr -cd / | wc -c) + 1 ))
	git -C "$mirror" archive --format=tar "$commit" "$subdir" 2>/dev/null | tar -x --strip-components="$depth" -C "$dir" || return 1
	[[ -f $dir/PKGBUILD ]]
}

# --- the file names a PKGBUILD downloads (every arch; VCS sources are clones, not files)
source_files() {   # source_files DIR
	sed -n 's/^\tsource\(_[a-z0-9_]*\)\? = //p' "$1/.SRCINFO" 2>/dev/null | while read -r src; do
		case $src in
			git+*|git://*|hg+*|svn+*|bzr+*|fossil+*) continue ;;
			*::*) printf '%s\n' "${src%%::*}" ;;
			*://*) printf '%s\n' "${src##*/}" ;;
			*) continue ;;   # a file in the package directory itself
		esac
	done | sort -u
}

# --- one job: fetch_one JOBDIR (the job's fields are read); its results in
# JOBDIR/out: the source package, its .buildsig and build.log
fetch_one() {
	local jobdir=$1 w=$1/work out=$1/out log=$1/out/build.log rc f names name
	rm -rf "$w"
	mkdir -p "$w"/{pkg,out,build} "$out"
	# SRCDEST is kept between jobs (a pkgrel bump downloads nothing); files
	# not used for ARCHCI_SRCDEST_KEEP_DAYS go
	find "$srcdest" -mindepth 1 -atime +"$ARCHCI_SRCDEST_KEEP_DAYS" -delete 2>/dev/null || true
	if ! export_pkgbuild "$job_pkgbase" "$job_commit" "$w/pkg"; then
		echo "==> no $ARCHCI_PKGBUILDS_DIR/$job_pkgbase at $job_commit in $ARCHCI_PKGBUILDS_URL" >"$log"
		return 1
	fi
	chown -R "$user" "$w"
	[[ -f $w/pkg/.SRCINFO ]] || (cd "$w/pkg" && as_user env BUILDDIR="$w/build" makepkg --printsrcinfo >.SRCINFO 2>/dev/null) || true
	# the keys validpgpkeys names: keys/pgp/ from the repository, then the keyservers
	if compgen -G "$w/pkg/keys/pgp/*.asc" >/dev/null; then
		as_user gpg --batch --quiet --import "$w"/pkg/keys/pgp/*.asc 2>/dev/null || true
	fi
	if [[ -n $ARCHCI_KEYSERVERS ]]; then
		local fingerprints keyserver
		mapfile -t fingerprints < <(sed -n 's/^\tvalidpgpkeys = //p' "$w/pkg/.SRCINFO" 2>/dev/null)
		if (( ${#fingerprints[@]} )); then
			for keyserver in $ARCHCI_KEYSERVERS; do
				as_user timeout 120 gpg --batch --quiet --keyserver "$keyserver" --recv-keys "${fingerprints[@]}" 2>/dev/null || true
			done
		fi
	fi
	mapfile -t names < <(source_files "$w/pkg")
	# makepkg's output: the log that goes to the master with the results, and
	# the journal (streamed to the master too), where archci top reads the
	# last line from
	say() { printf '%s\n' "$*" | tee -a "$log"; }
	run_makepkg() {
		(cd "$w/pkg" && as_user env SRCDEST="$srcdest" SRCPKGDEST="$w/out" BUILDDIR="$w/build" timeout "$(( ARCHCI_SOURCER_TIMEOUT_MINUTES * 60 ))" \
			makepkg --allsource --ignorearch) 2>&1 | tee -a "$log"
	}
	: >"$log"
	say "==> Fetching the sources of $job_pkgbase $job_version (${#names[@]} file(s) named)"
	if run_makepkg; then rc=0
	else
		rc=$?
		# a file of the same name in SRCDEST from another package or version:
		# drop this package's names from it and let makepkg fetch them upstream
		if (( rc != 124 )) && grep -q "did not pass the validity check" "$log"; then
			for name in "${names[@]}"; do rm -f "$srcdest/$name"; done
			say "==> a cached file failed its checksum; fetching upstream"
			if run_makepkg; then rc=0; else rc=$?; fi
		fi
	fi
	(( rc == 124 )) && say "==> timed out after $ARCHCI_SOURCER_TIMEOUT_MINUTES min"
	f=$(find "$w/out" -maxdepth 1 -name '*.src.tar.gz' -print -quit)
	if (( rc == 0 )) && [[ -n $f ]]; then
		mv "$f" "$out/${f##*/}"
		if gpg --homedir "$ARCHCI_BUILDER_GNUPGHOME" --batch --yes --detach-sign -u "$ARCHCI_BUILDER_KEY" -o "$out/${f##*/}.buildsig" "$out/${f##*/}"; then
			say "==> made and builder-signed ${f##*/} ($(du -h "$out/${f##*/}" | cut -f1))"
		else
			say "==> could not sign ${f##*/} with the builder key"; rc=1
		fi
	elif (( rc == 0 )); then
		say "==> makepkg made no source package"; rc=1
	fi
	rm -rf "$w"
	(( rc == 0 ))
}

# --- the loop, as archci-worker's
claim=$jobsdir/claim.tmp
job_id=
reported=1
on_term() {
	trap - TERM INT
	if [[ -n $job_id && $reported == 0 ]]; then
		archci_log "shutting down, handing $job_id back to the master"
		archci_master report "$job_id" abandoned || true
	fi
	exit 0
}
trap on_term TERM INT

archci_log "sourcer $me started, master $ARCHCI_MASTER"
while true; do
	if [[ $(stat -c '%i %Y %s' "${code_files[@]}" 2>/dev/null | tr '\n' ' ') != "$code_sig" ]]; then
		archci_log "archci-sourcer or its library changed on disk; restarting on the new code"
		exec "$self"
	fi
	# shellcheck disable=SC2046  # the stats are separate key=value words on purpose
	archci_claim "$me" src "$claim" $(archci_worker_stats "$home") || { sleep "$ARCHCI_IDLE_SLEEP"; continue; }
	reported=0
	jobdir=$jobsdir/$(printf '%s' "$job_id" | tr -c 'A-Za-z0-9:_.,-' '_')
	rm -rf "$jobdir"
	mkdir -p "$jobdir"
	mv "$claim" "$jobdir/job"
	archci_log "fetching $job_pkgbase $job_version ($job_id)"
	(
		trap - TERM INT
		while sleep "$ARCHCI_HEARTBEAT_SECONDS"; do
			# shellcheck disable=SC2046  # the stats are separate key=value words on purpose
			archci_master heartbeat "$job_id" $(archci_worker_stats "$home") phase=fetch >/dev/null 2>&1 || true
		done
	) &
	heartbeat=$!
	start=$(date +%s)
	status=failure
	fetch_one "$jobdir" && status=success
	kill "$heartbeat" 2>/dev/null || true
	wait "$heartbeat" 2>/dev/null || true
	archci_log "$job_id: $status after $(( ($(date +%s) - start) / 60 )) min: $(tail -n 1 "$jobdir/out/build.log" 2>/dev/null | cut -c1-160)"

	# the results to the master (kept and retried while it is away)
	archci_deliver "$job_id" "$jobdir/out" "$status" && reported=1
	rm -rf "$jobdir"
	job_id=
done
