[Unit]
Description=archci build worker %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/archci-worker %i
Restart=always
RestartSec=30
# makechrootpkg runs systemd-nspawn --keep-unit inside this unit.
Delegate=yes
# On stop, SIGTERM reaches the build and the worker loop together; the loop
# then reports the job as abandoned so the master requeues it at once.
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
