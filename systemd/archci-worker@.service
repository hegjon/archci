[Unit]
Description=archci build worker %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/archci-worker %i
Restart=always
RestartSec=30
# Builds run as archci-build@<name>.service. On stop the loop stops the running
# build unit and reports the job as abandoned, so the master requeues it at once.
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
