# One build per instance, started synchronously by archci-worker:
#   systemctl start archci-build@core-linux-7.2.3.arch1-2-a1
# %i names the job directory ${ARCHCI_WORKER_HOME}/jobs/%i/ holding "job" and "out/".
[Unit]
Description=archci build %i

[Service]
Type=oneshot
Environment=ARCHCI_WORKER_HOME=/var/lib/archci-worker
EnvironmentFile=-/etc/archci/archci.conf
ExecStart=/usr/bin/archci-build ${ARCHCI_WORKER_HOME}/jobs/%i/job ${ARCHCI_WORKER_HOME}/jobs/%i/out
# makechrootpkg's systemd-nspawn (--register=no, no --keep-unit) puts the
# container in a scope of its own under devtools-root.slice; delegation keeps
# that cgroup tree ours. Without --keep-unit nspawn's pipe console mode drops
# the container's stdout when it is this unit's journal socket, which is why
# archci-build runs makechrootpkg through a pipe.
Delegate=yes
# Log to the archci journal namespace (journalctl --namespace=archci), which
# is what systemd-journal-upload streams to the master.
LogNamespace=archci
# Compiler output must not be dropped by journald's rate limit.
LogRateLimitIntervalSec=0
# Build timeout (a oneshot is "starting" until it exits; RuntimeMaxSec= would be ignored).
# Change with: systemctl edit archci-build@.service
TimeoutStartSec=12h
