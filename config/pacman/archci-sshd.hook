# Reload sshd when the master package installs or updates its drop-in
# (worker keys in /etc/archci/authorized_keys for the archci user).
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = etc/ssh/sshd_config.d/*archci.conf

[Action]
Description = Reloading sshd for the archci worker-key drop-in...
When = PostTransaction
Exec = /usr/bin/systemctl try-reload-or-restart sshd.service
