# config/archci.conf.example -- every setting, annotated, with its default. Plain KEY=value,
# read by bash (sourced) and by the ruby scripts. Keep comments on their own line.

## Common ---------------------------------------------------------------------
# Master state: queue, built records, repo, logs (should be a btrfs subvolume).
ARCHCI_HOME=/var/lib/archci
# The machine's own architecture (default: uname -m). Worker: what
# archci-worker@N builds (archci-worker-<arch>@N instances build another arch,
# see docs/ports.md). Master: the default arch for "archci-job enqueue".
#ARCHCI_ARCH=x86_64
# The PKGBUILD repository: one git repository with a directory per package,
# <ARCHCI_PKGBUILDS_DIR>/<name>/PKGBUILD plus .omarchy/package.json (the
# omarchy-pkgs layout). The branch is the release list: a package is built
# when the version its PKGBUILD declares is not the one last built. To move to
# another fork (e.g. https://github.com/omacom/omarchy-pkgs.git) change the
# URL on master and workers; the next scan and build follow it.
ARCHCI_PKGBUILDS_URL=https://github.com/hegjon/omarchy-pkgs.git
ARCHCI_PKGBUILDS_BRANCH=core+extra
ARCHCI_PKGBUILDS_DIR=pkgbuilds
# Name of the pacman repository produced: $repo in the client's Server line,
# the database name, and the repo/<repo>/os/<arch> pool.
ARCHCI_REPO=omarchy
# Only build packages whose package.json "source" is listed, e.g. "arch" for
# the ones carried from Arch Linux. Empty: every package in the repository.
ARCHCI_PKG_SOURCES=""
# Packages built whatever their source, e.g. archci itself on a farm that
# otherwise builds only the Arch-origin packages.
ARCHCI_PKG_ALSO=""

## Master ---------------------------------------------------------------------
# Architectures workers may claim jobs for; a worker sends its ARCHCI_ARCH with
# each claim. Upstream releases only x86_64, so a port arch (e.g. aarch64)
# builds the same released commits with --ignorearch, needs its own native
# workers, and takes its chroot configs from arch/<arch>/ (see README "arm64").
ARCHCI_ARCHES="x86_64"
# Whose workers build the arch-independent ("any") packages; they are pooled
# for every arch in ARCHCI_ARCHES. Default: the first arch above.
#ARCHCI_ANY_ARCH=x86_64
# How many times a job may be built before it is parked in queue/failed for good.
ARCHCI_MAX_ATTEMPTS=3
# A running job without a worker heartbeat for this long goes back to pending.
ARCHCI_STALE_MINUTES=30
# A failed job with attempts left is retried after this long; one waiting for
# a dependency this repository has yet to build is held until it is, at most
# this much longer.
ARCHCI_RETRY_MINUTES=180
ARCHCI_RETRY_HOLD_MINUTES=720
# A dependency built this recently is taken as not yet released (the signer's
# lag) and waited for, so its dependents are not claimed before the chroot
# can install it.
ARCHCI_RELEASE_LAG_MINUTES=20
# Where the master keeps what it can rebuild: the package index cache.
ARCHCI_CACHE_DIR=/var/cache/archci
# Where the index reads a package's cached line from: "file" (pkgbuilds.cache
# there) or "xattr" (the PKGBUILD's user.archci.* extended attributes). Both
# are written; the scan's journal says what each rebuild cost.
ARCHCI_INDEX_CACHE=file
# The sourcer host fetches the outstanding packages' sources and keeps the
# upstream tarballs and the source packages (<pkgbase>-<version>.src.tar.gz)
# on this rclone path (a public R2 bucket): files/ and pkg/ under it. It
# needs ARCHCI_MASTER and a worker key like a worker, and ARCHCI_RCLONE_CONFIG.
ARCHCI_R2_SOURCES=""
# The store's public URL: a worker whose claim names a source package takes
# it from <URL>/pkg/ and fetches nothing upstream. Empty: workers fetch
# upstream themselves.
ARCHCI_SOURCES_URL=""
# The sourcer's state (mirror of the PKGBUILD repository, scratch), how many
# packages a pass fetches, the time one may take, and how long a failed
# fetch waits before the master offers it again.
ARCHCI_SOURCER_HOME=/var/lib/archci-sourcer
ARCHCI_SOURCER_BATCH=5
ARCHCI_SOURCER_TIMEOUT_MINUTES=30
ARCHCI_SOURCER_RETRY_HOURS=6
# Where systemd-journal-remote keeps the workers' journals (archci-top reads them).
ARCHCI_REMOTE_JOURNAL=/var/log/journal/remote
# Finished job records are pruned from queue/done after this many days.
ARCHCI_DONE_KEEP_DAYS=30
# R2 hand-off (see README "Signing"). Master moves built packages to STAGING;
# the signer reads STAGING and publishes the signed repo to RELEASE, which is
# what clients use. rclone remotes, e.g. "r2:archci/staging" and "r2:archci".
ARCHCI_R2_STAGING=""
ARCHCI_R2_RELEASE=""
ARCHCI_RCLONE_CONFIG=/etc/archci/rclone.conf
# The released repo's public URL, as clients use it, e.g.
# "https://pub-xxxx.r2.dev". On the master, archci-signer-status shows the
# released databases' age and size from it in archci top. On a worker, the
# chroots get [ARCHCI_REPO] at this URL above the mirrors, so builds use the
# packages the farm has built; the host's pacman keyring must trust the
# release key (it does when the worker installs archci from that repo).
# Empty: the chroots use the mirrors only.
ARCHCI_RELEASE_URL=""

## Signing (see README "Signing") --------------------------------------------
# Worker: gpg home with the builder secret key, and the key uid. The worker
# signs each package (<pkg>.buildsig) as internal provenance.
ARCHCI_BUILDER_GNUPGHOME=/etc/archci/builder-gnupg
ARCHCI_BUILDER_KEY=archci-builder
# Signer: the release secret key's gpg home and uid (passphrase-protected), the
# keyring of trusted builder pubkeys, and the signer's working directory.
ARCHCI_RELEASE_GNUPGHOME=/etc/archci/release-gnupg
ARCHCI_RELEASE_KEY=archci-release
ARCHCI_BUILDER_KEYRING=/etc/archci/builder-keyring
ARCHCI_SIGNER_HOME=/var/lib/archci-signer
# archci-sign-health warns when at least this many packages sit unsigned in staging.
ARCHCI_STAGING_WARN=20
# Packages archci-sign signs per pass; passes run a minute apart. Small keeps
# a freshly staged archci release from waiting behind a long pass.
ARCHCI_SIGN_BATCH=20
# How often archci-sign lists a release directory to prune files its database
# no longer names. A superseded version is deleted the pass that replaces it;
# the listing only catches leftovers of an interrupted pass.
ARCHCI_SIGN_PRUNE_MINUTES=60

## Worker ---------------------------------------------------------------------
# ssh destination of the master. The master droplet is named "master"; workers resolve
# it via /etc/hosts (cloud-init writes it) or DO private DNS.
ARCHCI_MASTER="archci@master"
# Where systemd-journal-upload streams this host's archci journal (a worker,
# the sourcer: archci-remote-logging). The default is the master's
# journal-remote port reached through an ssh tunnel over the worker key
# (archci-logging-tunnel.service); the master listens for journals on
# loopback only, so this works from anywhere the host can ssh to the master.
# "" keeps the journal local.
ARCHCI_JOURNAL_URL=http://127.0.0.1:19533
ARCHCI_WORKER_KEY=/etc/archci/worker_key
ARCHCI_WORKER_HOME=/var/lib/archci-worker
# Unprivileged local user makepkg runs as inside the chroot.
ARCHCI_BUILD_USER=archci
# Build timeout is TimeoutStartSec in archci-build@.service (systemctl edit archci-build@.service).
# A build that prints nothing for this long (a hung test suite) is killed earlier;
# 0 disables. A fat-LTO link of a big Rust program (mise, fish) is silent for
# well over half an hour on a busy machine, so keep it generous.
ARCHCI_BUILD_MAX_IDLE_MINUTES=90
# devtools chroot location; put it on btrfs to get snapshot-based clean chroots.
ARCHCI_CHROOTS=/var/lib/archbuild
# Extra args passed to makepkg (after --). Upstream source signatures are
# verified with the keys each PKGBUILD ships in keys/pgp/ (archci-build
# imports them); --skippgpcheck here turns that off.
ARCHCI_MAKEPKG_ARGS=""
# Before the sources are verified, the fingerprints the PKGBUILD names in
# validpgpkeys are refreshed from these keyservers, in order, so a new signing
# subkey or an extended expiry that keys/pgp/ does not have yet is known.
# Empty for no network lookup.
ARCHCI_KEYSERVERS="hkps://keys.openpgp.org hkps://keyserver.ubuntu.com"
# Skip check() when a worker builds another arch than the machine's, i.e.
# under qemu user-mode emulation, where test suites trip over the emulation
# (timing, signals, missing syscalls) more than over the package. 0 runs them.
ARCHCI_EMULATED_NOCHECK=1
# Environment every build runs with: VAR=value pairs separated by spaces (no
# spaces inside a value), exported from a makepkg.conf drop-in archci-build
# keeps in the clean chroot. The default lets CMake 4 configure the many
# projects whose cmake_minimum_required is older than 3.5.
ARCHCI_BUILD_ENV="CMAKE_POLICY_VERSION_MINIMUM=3.5"
# How many versions of each package the package caches the builds use keep;
# the rest is deleted at the hourly chroot update. A worker's caches grow by
# a version of everything it builds against and nothing else empties them.
# 0 keeps everything.
ARCHCI_CACHE_KEEP=1
# A worker's own source cache (what builds without a source package fetched):
# files not used for this many days are deleted before a build.
ARCHCI_SRCDEST_KEEP_DAYS=7
# On a port arch (anything but x86_64) also pass --ignorearch, since PKGBUILDs
# carried from Arch declare arch=(x86_64) only. 0 to build just packages that
# list the arch (read on the master too: such packages are then not offered).
# AUR and local packages list the arches they support and are built only
# there, whatever this says.
ARCHCI_IGNOREARCH=1
# Stamped into every package (shown as Packager in pacman -Si). Use your identity.
ARCHCI_PACKAGER="archci build farm <archci@localhost>"
ARCHCI_CHROOT_UPDATE_MINUTES=10
ARCHCI_IDLE_SLEEP=60
# Between tries at delivering a finished build while the master is unreachable.
ARCHCI_DELIVERY_RETRY_SECONDS=30
ARCHCI_HEARTBEAT_SECONDS=60
