# master state (ARCHCI_HOME): queue, built records, logs, pool
d /var/lib/archci 0755 archci archci -
d /var/lib/archci/queue 0755 archci archci -
d /var/lib/archci/queue/pending 0755 archci archci -
d /var/lib/archci/queue/running 0755 archci archci -
d /var/lib/archci/queue/done 0755 archci archci -
d /var/lib/archci/queue/failed 0755 archci archci -
d /var/lib/archci/built 0755 archci archci -
d /var/lib/archci/logs 0755 archci archci -
d /var/lib/archci/lock 0755 archci archci -
d /var/lib/archci/incoming 0755 archci archci -
d /var/lib/archci/repo 0755 archci archci -
# worker keys sshd reads for the archci user (archci-authorize appends to it)
f /etc/archci/authorized_keys 0644 root root -
