[Unit]
Description=archci: fetch the outstanding packages' sources to the store for the workers
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/archci-sourcer

[Service]
Type=oneshot
ExecStart=/usr/lib/archci/sourcer/archci-sourcer
# a pass fetches ARCHCI_SOURCER_BATCH packages, each within ARCHCI_SOURCER_TIMEOUT_MINUTES
TimeoutStartSec=4h
