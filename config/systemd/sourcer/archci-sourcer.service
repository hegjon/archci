[Unit]
Description=archci sourcer: fetch the sources of the master's src jobs
After=network-online.target
Wants=network-online.target
# Journal streaming to the master, when configured (archci-remote-logging).
Wants=archci-logging-tunnel.service systemd-journal-upload.service
RequiresMountsFor=/var/lib/archci-sourcer /var/lib/archbuild
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/lib/archci/sourcer/archci-sourcer
# to the archci journal namespace, which is what streams to the master
LogNamespace=archci
# makepkg's output must not be dropped by journald's rate limit.
LogRateLimitIntervalSec=0
Restart=always
RestartSec=30
# On stop the loop reports the job as abandoned, so the master requeues it at once.
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
