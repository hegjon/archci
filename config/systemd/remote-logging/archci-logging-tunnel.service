# Remote logging for a host outside the master's private network (a worker,
# the sourcer): hold an ssh tunnel to the master's journal-remote port so
# systemd-journal-upload can stream this host's archci journal to
# http://127.0.0.1:19533 (ARCHCI_JOURNAL_URL).
# Uses the worker key; the master allows that key to forward to this one port
# and nothing else (archci-authorize, sshd_config.d/60-archci.conf). With -N no
# session is opened, so the key's forced command never runs.
[Unit]
Description=archci remote logging: ssh tunnel to the master's journal-remote port
After=network-online.target archci-logging-setup.service
Wants=network-online.target archci-logging-setup.service
Before=systemd-journal-upload.service
# archci-logging-setup creates this when ARCHCI_JOURNAL_URL is the tunnel's loopback URL.
ConditionPathExists=/run/archci/logging-tunnel
StartLimitIntervalSec=0

[Service]
Environment=ARCHCI_MASTER=archci@master ARCHCI_WORKER_KEY=/etc/archci/worker_key
EnvironmentFile=-/etc/archci/archci.conf
ExecStart=/usr/bin/ssh -N -i ${ARCHCI_WORKER_KEY} \
    -o BatchMode=yes -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 -o ServerAliveCountMax=4 \
    -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/etc/archci/known_hosts \
    -L 127.0.0.1:19533:127.0.0.1:19533 ${ARCHCI_MASTER}
# The unit counts as started once the forward listens, so units ordered
# After= it (systemd-journal-upload) find the port open.
ExecStartPost=/bin/sh -c 'for i in $(seq 100); do ss -ltn | grep -q "127.0.0.1:19533 " && exit 0; sleep 0.2; done; exit 1'
Restart=always
RestartSec=15
LogNamespace=archci

[Install]
WantedBy=multi-user.target
