# First-start preparation of a worker (keys, chroot directory, journal
# streaming configuration); pulled in by every archci-worker@ instance.
[Unit]
Description=archci worker setup: keys and the chroot directory
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/archci/worker/archci-worker-setup
