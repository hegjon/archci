[Unit]
Description=archci: export the finished jobs' logs from the journal as SSE files
RequiresMountsFor=/var/lib/archci
# not while a publish pass moves logs/ to the release: an export is a
# .sse.gz.tmp until it is renamed whole, and the move takes only *.sse.gz,
# so the two could overlap; this keeps them apart anyway
After=archci-publish.service

[Service]
Type=oneshot
User=archci
ExecStart=/usr/lib/archci/master/archci-web export /var/lib/archci/logs
# one journalctl per finished job over the workers' remote journal, ruby
# in between: the pass the master feels most, so it yields to the rest
Nice=10
IOSchedulingClass=idle
# ruby streaming a log (it holds the last quarter of ARCHCI_LOG_MAX_LINES
# entries, ~3.5 KB each: about 45 MB at 50000) and journalctl mapping the
# journal: under this on a 1 GB master; over it, this pass dies alone (the
# timer runs the next) instead of the box swapping
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=64M
