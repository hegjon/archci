#!/bin/bash
# archci SUBCOMMAND [ARGS...] -- the sourcer's command line: `archci <name>` runs
# archci-<name> under /usr/lib/archci/sourcer/ (`archci sourcer`: the claim
# loop, what archci-sourcer.service runs). `archci` alone, or `archci help`,
# lists them. Installed as /usr/bin/archci by the archci-sourcer package
# (bin/archci-sourcer in the tree). A package's sources are fetched on
# demand with `archci job enqueue PKGBASE 0 src` on the master.
set -euo pipefail
root=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..
source "$root/lib/archci-common.sh"

# the commands: "name what it does"
commands=(
	"sourcer claim src jobs from the master and fetch their sources (what the service runs)"
)

sub=${1:-help}
shift || true
case $sub in
	help|-h|--help)
		echo "usage: archci SUBCOMMAND [ARGS...]   (archci version: the installed version)"
		echo
		echo "sourcer:"
		for c in "${commands[@]}"; do printf '  %-18s %s\n' "${c%% *}" "${c#* }"; done
		exit 0 ;;
	version|-V|--version) echo "archci $(archci_version)"; exit 0 ;;
esac
for c in "${commands[@]}"; do
	[[ ${c%% *} == "$sub" ]] && exec "$root/sourcer/archci-$sub" "$@"
done
echo "archci: unknown subcommand '$sub' ('archci help' lists the sourcer's)" >&2
exit 2
