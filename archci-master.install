# shellcheck shell=bash
# archci-master: the queue's 5-minute timer was archci-reaper.timer before
# 0.3.3; a master that had it enabled gets archci-housekeeping.timer enabled
# in its place (the old unit is gone with this upgrade).
post_upgrade() {
  if [[ -L /etc/systemd/system/timers.target.wants/archci-reaper.timer ]]; then
    rm -f /etc/systemd/system/timers.target.wants/archci-reaper.timer
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable --now archci-housekeeping.timer 2>/dev/null || true
    echo "==> archci-reaper.timer is now archci-housekeeping.timer (enabled)"
  fi
}
