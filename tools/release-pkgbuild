#!/bin/bash
# release-pkgbuild VERSION OUTDIR [--pkgrel N] -- write the PKGBUILD for tag
# vVERSION into OUTDIR (the fork's pkgbuilds/archci/): this tree's PKGBUILD
# with pkgver set from the tag and the tarball's sha256, plus the .install
# files. The tarball's checksum is taken from GitHub, so push the tag first.
# The result is parsed with makepkg --printsrcinfo before it is written.
set -euo pipefail
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..
version=${1:-}
out=${2:-}
pkgrel=1
[[ ${3:-} == --pkgrel && -n ${4:-} ]] && pkgrel=$4
[[ -n $version && -n $out ]] || { echo "usage: release-pkgbuild VERSION OUTDIR [--pkgrel N]" >&2; exit 2; }
[[ $version =~ ^[0-9]+(\.[0-9]+)*$ ]] || { echo "not a release version: $version" >&2; exit 2; }
[[ -d $out ]] || { echo "not a directory: $out" >&2; exit 2; }
src=$here/PKGBUILD
die() { echo "release-pkgbuild: $*" >&2; exit 1; }

url="https://github.com/hegjon/archci/archive/refs/tags/v${version}.tar.gz"
tarball=$(mktemp)
trap 'rm -f "$tarball" "$tarball.list"' EXIT
curl -fsSL -o "$tarball" "$url" || die "cannot fetch $url (is tag v$version pushed?)"
sha=$(sha256sum "$tarball" | cut -d' ' -f1)
# (no grep -q on a pipe: the writer dies of SIGPIPE and pipefail calls that a failure)
tar tzf "$tarball" >"$tarball.list"
grep -qx "archci-$version/PKGBUILD" "$tarball.list" || die "tarball does not look like archci v$version"

# expect N PATTERN: the tree's PKGBUILD must hold exactly N lines matching,
# or the rewrite below no longer fits it
expect() {
	local n=$1 re=$2 got
	got=$(grep -cE -- "$re" "$src" || true)
	(( got == n )) || die "expected $n line(s) matching '$re' in PKGBUILD, found $got: update the rules"
}
expect 1 '^pkgver=0\.0\.0 '
expect 1 '^pkgrel=1$'
expect 1 '^sha256sums=\(SKIP\) '
sed -E \
	-e "s/^pkgver=0\.0\.0 .*/pkgver=$version/" \
	-e "s/^pkgrel=1$/pkgrel=$pkgrel/" \
	-e "s/^sha256sums=\(SKIP\) .*/sha256sums=('$sha')/" \
	-e '/^# Maintainer:/a #\
# GENERATED by tools/release-pkgbuild in the archci tree from its PKGBUILD:\
# change that one, then regenerate this with the next tag.' \
	"$src" >"$out/PKGBUILD.new"
mv "$out/PKGBUILD.new" "$out/PKGBUILD"
# the .install files: the tree's, and none the tree no longer has
for f in "$out"/*.install; do [[ -e $f && ! -e $here/${f##*/} ]] && rm -f "$f"; done
for f in "$here"/*.install; do install -m644 "$f" "$out/${f##*/}"; done
# it must parse with the tag's version and checksum
srcinfo=$(cd "$out" && makepkg --printsrcinfo 2>&1) || die "makepkg --printsrcinfo failed: $srcinfo"
grep -q '^pkgbase = archci$' <<<"$srcinfo" || die "pkgbase is not archci"
grep -q "^	pkgver = $version$" <<<"$srcinfo" || die "pkgver is not $version"
grep -q "^	sha256sums = $sha$" <<<"$srcinfo" || die "sha256sum missing"
grep -q "^	source = $url$" <<<"$srcinfo" || die "source is not the tag's tarball"
echo "wrote $out/PKGBUILD: archci $version-$pkgrel, $(grep -c '^pkgname = ' <<<"$srcinfo") packages, $(printf '%s\n' "$here"/*.install | wc -l) install file(s)"
