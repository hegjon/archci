#!/bin/bash
# shellcheck disable=SC2016  # the rules quote PKGBUILD text with $ in it on purpose
# release-pkgbuild VERSION OUTDIR [--pkgrel N] -- write the release PKGBUILD
# for tag vVERSION into OUTDIR (the fork's pkgbuilds/archci/), derived from
# the split PKGBUILD in this tree, plus the .install files it names.
#
# The archci tree carries archci-git, built from a checkout; the release
# packages (archci, archci-master, ...) come from the tagged tarball and
# replace the -git ones. Everything else is the same, so the release file is
# generated, never edited: a unit or file added to the split PKGBUILD lands
# in the release with the next tag. The tarball's sha256 is taken from
# GitHub, so push the tag first. Every rewrite checks that it matched, and
# the result is parsed with makepkg --printsrcinfo; a change to the split
# PKGBUILD that the rules do not cover fails here, not on the farm.
set -euo pipefail
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..
version=${1:-}
out=${2:-}
pkgrel=1
[[ ${3:-} == --pkgrel && -n ${4:-} ]] && pkgrel=$4
[[ -n $version && -n $out ]] || { echo "usage: release-pkgbuild VERSION OUTDIR [--pkgrel N]" >&2; exit 2; }
[[ $version =~ ^[0-9]+(\.[0-9]+)*$ ]] || { echo "not a release version: $version" >&2; exit 2; }
src=$here/PKGBUILD
die() { echo "release-pkgbuild: $*" >&2; exit 1; }

url="https://github.com/hegjon/archci/archive/refs/tags/v${version}.tar.gz"
tarball=$(mktemp)
trap 'rm -f "$tarball" "$tarball.list" "$tarball.src"' EXIT
curl -fsSL -o "$tarball" "$url" || die "cannot fetch $url (is tag v$version pushed?)"
sha=$(sha256sum "$tarball" | cut -d' ' -f1)
# (no grep -q on a pipe: the writer dies of SIGPIPE and pipefail calls that a failure)
tar tzf "$tarball" >"$tarball.list"
grep -qx "archci-$version/PKGBUILD" "$tarball.list" || die "tarball does not look like archci v$version"

# expect N PATTERN: the split PKGBUILD must hold exactly N lines matching, or
# the rules below no longer fit it
expect() {
	local n=$1 re=$2 got
	got=$(grep -cE -- "$re" "$src" || true)
	(( got == n )) || die "expected $n line(s) matching '$re' in PKGBUILD, found $got: update the rules"
}
expect 1 '^pkgbase=archci-git$'
expect 1 '^pkgname=\(archci-git '
expect 1 '^pkgver=r0\.g0000000$'
expect 1 '^pkgrel=1$'
expect 1 '^makedepends=\(git '
expect 1 '^source=\("\$pkgbase::git\+'
expect 1 '^sha256sums=\(SKIP\)$'
expect 1 '^pkgver\(\) \{$'
expect 6 '^package_archci(-[a-z0-9-]+)?-git\(\) \{$'
expect 6 '^  provides=\('
expect 6 '^  conflicts=\('
expect 2 '^  cd "\$pkgbase"$'   # in pkgver(), dropped, and in package_archci-git

# comments name the packages as the release calls them (done before the awk
# pass, whose own header wording stays as written)
sed -E '/^#/ { s/archci-(master|worker|signer|worker-qemu-[a-z0-9]+)-git/archci-\1/g; s/archci-git/archci/g }' "$src" >"$tarball.src"
awk -v version="$version" -v pkgrel="$pkgrel" -v url="$url" -v sha="$sha" '
BEGIN { skip = 0 }
# the pkgver() function: a tag has its version
/^pkgver\(\) \{$/ { skip = 1; next }
skip && /^\}$/ { skip = 0; getline; if ($0 != "") print; next }
skip { next }
/^# Maintainer:/ {
	print
	print "#"
	print "# The release packages of archci (https://github.com/hegjon/archci), from its"
	print "# tagged tarball; they replace the archci-git ones built from a checkout."
	print "# GENERATED by tools/release-pkgbuild in the archci tree from its split PKGBUILD:"
	print "# change that one, then regenerate this with the next tag."
	next
}
/^pkgbase=archci-git$/ { print "pkgbase=archci"; next }
/^pkgname=\(/ || (inpkgname && /^ +archci/) {
	inpkgname = ($0 !~ /\)$/)
	gsub(/-git/, "")
	print; next
}
/^pkgver=r0\.g0000000$/ { print "pkgver=" version; next }
/^pkgrel=1$/ { print "pkgrel=" pkgrel; next }
/^makedepends=\(git / { sub(/\(git /, "("); print; next }
/^source=\("\$pkgbase::git\+/ { print "source=(\"https://github.com/hegjon/archci/archive/refs/tags/v${pkgver}.tar.gz\")"; next }
/^sha256sums=\(SKIP\)$/ { print "sha256sums=('\''" sha "'\'')"; print "_src=\"archci-$pkgver\""; next }
/^package_archci(-[a-z0-9-]+)?-git\(\) \{$/ { sub(/-git\(\)/, "()"); print; next }
/^  depends=\(archci(-[a-z0-9-]+)?-git / { sub(/-git /, " "); print; next }
/^  provides=\(/ { next }
/^  replaces=\(/ { next }   # rewritten from conflicts below
/^  conflicts=\(/ {
	names = $0; sub(/^  conflicts=\(/, "", names); sub(/\)$/, "", names)
	n = split(names, a, " "); s = ""
	for (i = 1; i <= n; i++) s = s (i > 1 ? " " : "") a[i] "-git"
	print "  conflicts=(" s ")"; print "  replaces=(" s ")"; next
}
/^  cd "\$pkgbase"$/ { print "  cd \"$srcdir/$_src\""; next }
{ gsub(/\$srcdir\/\$pkgbase/, "$srcdir/$_src") }
/^#/ { gsub(/archci(-[a-z0-9-]+)?-git/, "&"); }   # comments keep their wording
{ print }
' "$tarball.src" >"$out/PKGBUILD.new"
# nothing -git may remain outside conflicts/replaces (and the comment about them)
if grep -nE -- '-git' "$out/PKGBUILD.new" | grep -vE '^[0-9]+:  (conflicts|replaces)=|^[0-9]+:#'; then
	die "a -git name survived outside conflicts/replaces: add a rule"
fi
grep -q '\$pkgbase' "$out/PKGBUILD.new" && ! grep -q 'cd "\$srcdir/\$_src"' "$out/PKGBUILD.new" && die "a \$pkgbase path survived"

mv "$out/PKGBUILD.new" "$out/PKGBUILD"
# the .install files: the tree's, and none the tree no longer has
for f in "$out"/*.install; do [[ -e $f && ! -e $here/${f##*/} ]] && rm -f "$f"; done
for f in "$here"/*.install; do install -m644 "$f" "$out/${f##*/}"; done
# it must parse, name the release packages and no -git one
srcinfo=$(cd "$out" && makepkg --printsrcinfo 2>&1) || die "makepkg --printsrcinfo failed: $srcinfo"
grep -q '^pkgbase = archci$' <<<"$srcinfo" || die "pkgbase is not archci"
grep -qE '^pkgname = archci-git$' <<<"$srcinfo" && die "archci-git in the release pkgnames"
grep -q "^	pkgver = $version$" <<<"$srcinfo" || die "pkgver is not $version"
grep -q "^	sha256sums = $sha$" <<<"$srcinfo" || die "sha256sum missing"
echo "wrote $out/PKGBUILD: archci $version-$pkgrel, $(grep -c '^pkgname = ' <<<"$srcinfo") packages, $(printf '%s\n' "$here"/*.install | wc -l) install file(s)"
