#!/bin/bash
# archci-sign [--unlock] -- release-sign packages the master staged to R2.
#
# Runs on the signer droplet (root) on a timer. It talks only to R2, never to
# the master. For every package in the STAGING area it: pulls the package and
# its builder signature, verifies the builder signature against the authorized
# builder keyring, makes the client-facing release signature with the release
# key, adds the package to the release database (repo-add), publishes package +
# .sig + database to the RELEASE area, and deletes the package from STAGING.
# The release private key (passphrase-protected) never leaves this host.
#
#   --unlock   prime gpg-agent with the release passphrase (once per session)
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

release_sign() { gpg --homedir "$ARCHCI_RELEASE_GNUPGHOME" --batch --yes --pinentry-mode loopback \
	--detach-sign -u "$ARCHCI_RELEASE_KEY" -o "$1.sig" "$1" 2>/dev/null; }

if [[ ${1:-} == --unlock ]]; then
	tmp=$(mktemp); : >"$tmp"
	unlock=(gpg --homedir "$ARCHCI_RELEASE_GNUPGHOME" --detach-sign -u "$ARCHCI_RELEASE_KEY" -o /dev/null)
	[[ -n ${ARCHCI_RELEASE_PASSPHRASE:-} ]] && unlock=("${unlock[@]}" --pinentry-mode loopback --passphrase "$ARCHCI_RELEASE_PASSPHRASE")
	if "${unlock[@]}" "$tmp"; then archci_log "release key unlocked; gpg-agent will cache it"
	else rm -f "$tmp"; archci_die "could not unlock the release key"; fi
	rm -f "$tmp"; exit 0
fi

[[ -n $ARCHCI_R2_STAGING && -n $ARCHCI_R2_RELEASE ]] || archci_die "set ARCHCI_R2_STAGING and ARCHCI_R2_RELEASE"
command -v rclone >/dev/null || archci_die "rclone is not installed"
[[ -d $ARCHCI_RELEASE_GNUPGHOME ]] || archci_die "no release keyring at $ARCHCI_RELEASE_GNUPGHOME"
[[ -d $ARCHCI_BUILDER_KEYRING ]] || archci_die "no builder keyring at $ARCHCI_BUILDER_KEYRING (archci-authorize-builder)"

exec 9>"$ARCHCI_SIGNER_HOME/sign.lock"
flock -n 9 || { archci_log "another archci-sign is running"; exit 0; }

export RCLONE_CONFIG=$ARCHCI_RCLONE_CONFIG
work=$ARCHCI_SIGNER_HOME/work
localrepo=$ARCHCI_SIGNER_HOME/repo         # persistent home of the release databases
rm -rf "$work"; mkdir -p "$work" "$localrepo"

mapfile -t rels < <(rclone lsf -R --files-only "$ARCHCI_R2_STAGING" 2>/dev/null | grep '\.pkg\.tar\.zst$' || true)
(( ${#rels[@]} )) || exit 0
archci_log "staging holds ${#rels[@]} package(s) to sign"

declare -A touched=()
declare -A dbready=()   # per-repo: is the local db authoritative for release (safe to prune)?
signed=0 rejected=0
for rel in "${rels[@]}"; do
	[[ $rel == *..* || $rel == /* ]] && { archci_log "skip suspicious path: $rel"; continue; }
	reldir=${rel%/*}; db=${rel%%/*}
	mkdir -p "$work/$reldir" "$localrepo/$reldir"
	if ! rclone copyto "$ARCHCI_R2_STAGING/$rel" "$work/$rel" 2>/dev/null \
	   || ! rclone copyto "$ARCHCI_R2_STAGING/$rel.buildsig" "$work/$rel.buildsig" 2>/dev/null; then
		archci_log "REJECT $rel: could not fetch package or builder signature"
		rclone deletefile "$ARCHCI_R2_STAGING/$rel" 2>/dev/null || true
		rclone deletefile "$ARCHCI_R2_STAGING/$rel.buildsig" 2>/dev/null || true
		(( ++rejected )); continue
	fi
	if ! gpg --homedir "$ARCHCI_BUILDER_KEYRING" --batch --verify "$work/$rel.buildsig" "$work/$rel" 2>/dev/null; then
		archci_log "REJECT $rel: builder signature invalid or from an unknown key"
		rclone deletefile "$ARCHCI_R2_STAGING/$rel" 2>/dev/null || true
		rclone deletefile "$ARCHCI_R2_STAGING/$rel.buildsig" 2>/dev/null || true
		rm -f "$work/$rel" "$work/$rel.buildsig"; (( ++rejected )); continue
	fi
	if ! release_sign "$work/$rel"; then
		archci_log "release key is locked; run 'archci-sign --unlock' on the signer"
		break
	fi
	# publish package + signature to the release area
	rclone copyto "$work/$rel" "$ARCHCI_R2_RELEASE/$rel"
	rclone copyto "$work/$rel.sig" "$ARCHCI_R2_RELEASE/$rel.sig"
	# Add to the release database. The first time this run touches a repo,
	# establish whether the local db is authoritative for the release area:
	# it is if it already existed locally, or if it seeds cleanly from release.
	# If neither (a fresh signer whose seed failed), mark it not-ready so the
	# prune below is skipped and cannot delete live release packages.
	if [[ -z ${dbready[$reldir]+set} ]]; then
		if [[ -f $localrepo/$reldir/$db.db.tar.gz ]]; then
			dbready[$reldir]=1
		elif rclone copyto "$ARCHCI_R2_RELEASE/$reldir/$db.db.tar.gz" "$localrepo/$reldir/$db.db.tar.gz" 2>/dev/null; then
			rclone copyto "$ARCHCI_R2_RELEASE/$reldir/$db.files.tar.gz" "$localrepo/$reldir/$db.files.tar.gz" 2>/dev/null || true
			dbready[$reldir]=1
		else
			dbready[$reldir]=0
		fi
	fi
	cp "$work/$rel" "$localrepo/$rel"
	repo-add -R -q "$localrepo/$reldir/$db.db.tar.gz" "$localrepo/$rel" >/dev/null
	rm -f "$localrepo/$rel"                       # keep only the database locally
	touched[$reldir]=$db
	rclone deletefile "$ARCHCI_R2_STAGING/$rel" 2>/dev/null || true
	rclone deletefile "$ARCHCI_R2_STAGING/$rel.buildsig" 2>/dev/null || true
	rm -f "$work/$rel" "$work/$rel.buildsig" "$work/$rel.sig"
	(( ++signed ))
done

# publish the updated databases (as <db>.db.tar.gz and the <db>.db clients fetch)
for reldir in "${!touched[@]}"; do
	db=${touched[$reldir]}
	for pair in "db.tar.gz:db" "files.tar.gz:files"; do
		src=$localrepo/$reldir/$db.${pair%%:*}
		[[ -f $src ]] || continue
		rclone copyto "$src" "$ARCHCI_R2_RELEASE/$reldir/$db.${pair%%:*}"
		rclone copyto "$src" "$ARCHCI_R2_RELEASE/$reldir/$db.${pair##*:}"
	done
	# Prune release packages no longer in the database (superseded versions),
	# but only when the local db is authoritative for release (see above): a
	# transient db-loss must never delete live release packages.
	if [[ ${dbready[$reldir]} != 1 ]]; then
		archci_log "skipping prune of [$db]: local database was not seeded from release this run"
		continue
	fi
	mapfile -t indb < <(bsdtar -xOf "$localrepo/$reldir/$db.db.tar.gz" '*/desc' 2>/dev/null | grep '\.pkg\.tar\.zst$' || true)
	if (( ${#indb[@]} == 0 )); then
		archci_log "skipping prune of [$db]: local database is empty or unreadable"
		continue
	fi
	# Membership through an associative array, not a pipeline into grep -q:
	# grep quits at the first match, and with a database of a few hundred
	# entries the printf feeding it then dies of SIGPIPE, which pipefail
	# turned into "not in the database" -- and pruned live packages.
	declare -A inset=()
	for f in "${indb[@]}"; do inset[$f]=1; done
	while IFS= read -r f; do
		[[ $f == *.pkg.tar.zst ]] || continue
		[[ -n ${inset[$f]:-} ]] && continue
		archci_log "pruning superseded $reldir/$f from release"
		rclone deletefile "$ARCHCI_R2_RELEASE/$reldir/$f" 2>/dev/null || true
		rclone deletefile "$ARCHCI_R2_RELEASE/$reldir/$f.sig" 2>/dev/null || true
	done < <(rclone lsf --files-only "$ARCHCI_R2_RELEASE/$reldir" 2>/dev/null | grep '\.pkg\.tar\.zst$' || true)
done

archci_log "signed $signed, rejected $rejected"
exit 0
