#!/bin/bash
# archci-sign [--unlock] -- release-sign what the master pooled.
#
# Runs on the signer host (root) on a timer, a minute apart. It reaches the
# master over ssh with its own key (ARCHCI_SIGNER_KEY, authorized there with
# `archci authorize --signer`; the forced command is archci-shell signer) and
# nothing else: no R2 credentials, no key on the master. A pass:
#   1. `unsigned N`: the master names up to ARCHCI_SIGN_BATCH pooled files
#      without a release signature, the farm's own first, then the oldest;
#   2. rsync (read-only, the master's repo/) fetches them with their builder
#      signatures in one transfer;
#   3. each builder signature is verified against the authorized builder
#      keyring; one that is missing, invalid or from an unknown key is
#      reported (`rejected FILE REASON`) and the file never signed: the
#      master parks it and does not offer it again;
#   4. the release key makes the detached <file>.sig; the signatures go back
#      by rsync (write-only, the master's sigs/) in one transfer, and
#      `signed` tells the master to publish.
# The release private key (passphrase-protected) never leaves this host; it
# is unlocked into gpg-agent once per session:
#   --unlock   prime gpg-agent with the release passphrase (ARCHCI_RELEASE_PASSPHRASE
#              for a non-interactive unlock)
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

release_sign() { gpg --homedir "$ARCHCI_RELEASE_GNUPGHOME" --batch --yes --pinentry-mode loopback \
	--detach-sign -u "$ARCHCI_RELEASE_KEY" -o "$1.sig" "$1" 2>/dev/null; }

if [[ ${1:-} == --unlock ]]; then
	tmp=$(mktemp); : >"$tmp"
	unlock=(gpg --homedir "$ARCHCI_RELEASE_GNUPGHOME" --detach-sign -u "$ARCHCI_RELEASE_KEY" -o /dev/null)
	[[ -n ${ARCHCI_RELEASE_PASSPHRASE:-} ]] && unlock=("${unlock[@]}" --pinentry-mode loopback --passphrase "$ARCHCI_RELEASE_PASSPHRASE")
	if "${unlock[@]}" "$tmp"; then archci_log "release key unlocked; gpg-agent will cache it"
	else rm -f "$tmp"; archci_die "could not unlock the release key"; fi
	rm -f "$tmp"; exit 0
fi

[[ -d $ARCHCI_RELEASE_GNUPGHOME ]] || archci_die "no release keyring at $ARCHCI_RELEASE_GNUPGHOME"
[[ -d $ARCHCI_BUILDER_KEYRING ]] || archci_die "no builder keyring at $ARCHCI_BUILDER_KEYRING (archci authorize-builder)"
# the signer's ssh key: made here on first run, authorized on the master by hand
if [[ ! -f $ARCHCI_SIGNER_KEY ]]; then
	install -d -m 700 "${ARCHCI_SIGNER_KEY%/*}"
	ssh-keygen -q -t ed25519 -N '' -C "archci-signer@${HOSTNAME%%.*}" -f "$ARCHCI_SIGNER_KEY"
	archci_die "made $ARCHCI_SIGNER_KEY; authorize it on the master:  archci authorize --signer '$(<"$ARCHCI_SIGNER_KEY.pub")'"
fi
ssh_opts=(-i "$ARCHCI_SIGNER_KEY" -o BatchMode=yes -o ConnectTimeout=30 -o ServerAliveInterval=30 -o ServerAliveCountMax=4
	-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/etc/archci/known_hosts)
master() { ssh -n "${ssh_opts[@]}" "$ARCHCI_MASTER" "$@"; }

mkdir -p "$ARCHCI_SIGNER_HOME"
exec 9>"$ARCHCI_SIGNER_HOME/sign.lock"
flock -n 9 || { archci_log "another archci-sign is running"; exit 0; }
work=$ARCHCI_SIGNER_HOME/work
rm -rf "$work"; mkdir -p "$work/in" "$work/sigs"

# (a failure of the process substitution would not reach mapfile: ask first)
listing=$(master unsigned "$ARCHCI_SIGN_BATCH") || archci_die "cannot reach the master ($ARCHCI_MASTER)"
[[ -n $listing ]] || exit 0
mapfile -t rels <<<"$listing"
archci_log "the master has ${#rels[@]} file(s) to sign"

fetch=$work/fetch.list; : >"$fetch"
for rel in "${rels[@]}"; do
	[[ $rel == *..* || $rel == /* || $rel != */os/* ]] && continue
	printf '%s\n%s.buildsig\n' "$rel" "$rel" >>"$fetch"
done
rsync -a --timeout=600 --files-from="$fetch" -e "ssh ${ssh_opts[*]}" "$ARCHCI_MASTER:." "$work/in/" 2>/dev/null || true

signed=0 rejected=0 locked=0
for rel in "${rels[@]}"; do
	[[ $rel == *..* || $rel == /* || $rel != */os/* ]] && { archci_log "skip suspicious path: $rel"; continue; }
	f=$work/in/$rel
	if [[ ! -f $f || ! -f $f.buildsig ]]; then
		archci_log "REJECT $rel: could not fetch the file or its builder signature"
		master rejected "$rel" "could not fetch the file or its builder signature" || true
		(( ++rejected )); continue
	fi
	if ! gpg --homedir "$ARCHCI_BUILDER_KEYRING" --batch --verify "$f.buildsig" "$f" 2>/dev/null; then
		archci_log "REJECT $rel: builder signature invalid or from an unknown key"
		master rejected "$rel" "builder signature invalid or from an unknown key" || true
		(( ++rejected )); continue
	fi
	if ! release_sign "$f"; then
		archci_log "release key is locked; run 'archci sign --unlock' on the signer"
		locked=1; break
	fi
	mkdir -p "$work/sigs/${rel%/*}"
	mv "$f.sig" "$work/sigs/$rel.sig"
	(( ++signed ))
done
if (( signed )); then
	rsync -a --timeout=600 -e "ssh ${ssh_opts[*]}" "$work/sigs/" "$ARCHCI_MASTER:." || archci_die "could not return the signatures to the master"
	master signed || true
fi
rm -rf "$work"
archci_log "signed $signed, rejected $rejected$( (( locked )) && echo ', stopped: the release key is locked')"
exit 0
