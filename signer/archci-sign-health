#!/bin/bash
# archci-sign-health -- warn, loudly into the journal, when release signing is
# stalled. Runs on the signer on a timer; the journal streams to the master, so
# a warning shows up in `journalctl -D /var/log/journal/remote -t archci-sign-health`.
#
# Two failure modes it catches, both otherwise silent (no unit goes red):
#   * the release key's gpg-agent cache expired -> archci-sign can't sign
#   * packages piling up in staging (signer down, rclone failing, key locked)
# It tests the key with `--pinentry-mode error`, which fails immediately if the
# passphrase is not cached instead of prompting, so the check never blocks.
set -uo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

[[ -n $ARCHCI_R2_STAGING ]] || exit 0
command -v rclone >/dev/null || exit 0
export RCLONE_CONFIG=$ARCHCI_RCLONE_CONFIG

locked=0
if [[ -d $ARCHCI_RELEASE_GNUPGHOME ]]; then
	tmp=$(mktemp); : >"$tmp"
	gpg --homedir "$ARCHCI_RELEASE_GNUPGHOME" --batch --pinentry-mode error \
		--detach-sign -u "$ARCHCI_RELEASE_KEY" -o /dev/null "$tmp" 2>/dev/null || locked=1
	rm -f "$tmp"
fi

waiting=$(rclone lsf -R --files-only "$ARCHCI_R2_STAGING" 2>/dev/null | grep -c '\.pkg\.tar\.zst$' || true)

if (( locked )) && (( waiting > 0 )); then
	archci_log "ALERT: release key is LOCKED and $waiting package(s) wait in staging; run 'archci sign --unlock' on the signer"
elif (( locked )); then
	archci_log "WARNING: release key is locked; run 'archci sign --unlock' before packages arrive (staging empty for now)"
elif (( waiting >= ARCHCI_STAGING_WARN )); then
	archci_log "WARNING: $waiting package(s) in staging are not draining; check 'systemctl status archci-sign.timer' and 'journalctl -u archci-sign'"
fi
exit 0
