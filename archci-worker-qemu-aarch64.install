# shellcheck shell=bash
# archci-worker-qemu-aarch64: build aarch64 on an x86_64 worker under qemu
# user-mode emulation. The package ships the pieces devtools lacks for that
# (README "Building for arm64"); this script activates the two that need it.

post_install() {
  # The chroot inherits the host's pacman trust (mkarchroot and arch-nspawn
  # copy it in), so the Arch Linux Ports aarch64 repo key must be trusted here.
  if [[ -x /usr/bin/pacman-key && -f /etc/pacman.d/gnupg/pubring.gpg ]]; then
    pacman-key --populate archci-ports-aarch64
  else
    echo "==> run: pacman-key --init && pacman-key --populate archci-ports-aarch64"
  fi
  # Re-register qemu-aarch64 with the C flag from /etc/binfmt.d.
  systemctl restart systemd-binfmt.service 2>/dev/null || true
  if [[ $(uname -m) == aarch64 ]]; then
    echo "==> WARNING: this is an aarch64 machine; it builds aarch64 natively with archci-worker@N," >&2
    echo "    and this package's qemu-aarch64 binfmt registration is not wanted here. Remove it." >&2
  fi
  cat <<'MSG'
==> Start an aarch64 worker instance (the master must list aarch64 in ARCHCI_ARCHES):
      systemctl enable --now archci-worker-aarch64@1
MSG
}

post_upgrade() {
  post_install "$1"
}

post_remove() {
  systemctl restart systemd-binfmt.service 2>/dev/null || true
  cat <<'MSG'
==> The Arch Linux Ports aarch64 key stays in the pacman keyring; to drop it:
      pacman-key --delete 9B2C213B21883BB65CE2FB900CF25682E6BA0751
MSG
}
