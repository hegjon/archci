#!/usr/bin/env ruby
# frozen_string_literal: true

# archci-jobs [WORD...] -- every job the master holds, pending, running,
# done and failed, as a tree: one line per package, newest activity first,
# its jobs beneath it (src, any, x86_64, aarch64, ...), filtered as you type,
# and each job inspected. On a terminal the window is split: the tree
# above, the job picked below with its story (state, worker, attempt, the
# source package and the network it had, its last heartbeat's stats) and
# its log, opened at the first error; a running job's log is what its
# journal has streamed so far, a pending one has none yet. Into a pipe: one
# line per job matching WORD..., with the first error line of its log.
#   /              edit the filter: words, each of which must appear in the
#                  job's state, package, version, arch, worker or origin
#                  ("failed aarch64 python"); Enter keeps it, Esc clears it
#   up/down, j/k   pick a job              PgUp/PgDn, K/J   scroll the log
#   e/E            next/previous error     g/G              top/bottom of the log
#   i              the job file instead of the log (and back)
#   l              the log in $PAGER       r                retry a failed job (a fresh first attempt)
#   q, Esc         quit
require_relative '../lib/archci'
require 'io/console'
require 'open3'

# a line that names the failure; the second set names one without being it
ERROR_RE = /error:|ERROR|FAILED|Unmet dependencies|target not found|Failure while downloading|did not pass the validity|returned error: 4\d\d/
NOT_ERROR_RE = /gpg:|Verifying|Build failed, check|makechrootpkg exited|the build exited|archci-build finished|-Werror|ERRORFUNC|_error|error_/
def error_line?(line) = line.match?(ERROR_RE) && !line.match?(NOT_ERROR_RE)

MAX_ATTEMPTS = Archci.config['ARCHCI_MAX_ATTEMPTS'].to_i
JOURNAL = Archci.config['ARCHCI_REMOTE_JOURNAL']
FIELDS = %w[state pkgbase version arch worker origin].freeze
ARCH_ORDER = %w[src any x86_64 aarch64 riscv64].freeze

# every job with its state, origin and log path
def all_jobs
  repo = Archci.config['ARCHCI_REPO']
  by_name = Archci.packages.to_h { |p| [p['pkgbase'], p] }
  Archci::QUEUES.flat_map do |q|
    Archci.jobs(q).map do |j|
      j.merge('state' => q, 'origin' => Archci.origin(by_name[j['pkgbase']]) || '-',
              'log' => File.join(Archci.home, 'logs', j['repo'] || repo, j['pkgbase'], j['version'], j['arch'], "attempt-#{j['attempt']}.log"))
    end
  end
end

# the jobs whose fields hold every word of the filter
def filtered(jobs, words)
  return jobs if words.empty?

  jobs.select { |j| words.all? { |w| FIELDS.any? { |f| j[f].to_s.downcase.include?(w.downcase) } } }
end

# the tree: packages by their newest job, each with its jobs in arch order;
# rows are [:pkg, name, jobs] and [:job, job, last?, versions] (a job's
# version shows beside its arch when the package's jobs span several)
def tree(jobs)
  rows = []
  jobs.group_by { |j| j['pkgbase'] }.sort_by { |_, js| -js.map { |j| j['mtime'].to_f }.max }.each do |name, js|
    js = js.sort_by { |j| [ARCH_ORDER.index(j['arch']) || 99, j['arch'], -j['mtime'].to_f] }
    versions = js.map { |j| j['version'] }.uniq.size
    rows << [:pkg, name, js]
    js.each_with_index { |j, i| rows << [:job, j, i == js.size - 1, versions] }
  end
  rows
end

# the journal's matches for a running job: a build's unit, or the sourcer's
# service on its host for a src job (what archci-top keys on)
def journal_matches(j)
  if j['arch'] == 'src'
    ['_SYSTEMD_UNIT=archci-sourcer.service', "_HOSTNAME=#{j['worker']}", 'SYSLOG_IDENTIFIER=archci-sourcer']
  else
    name = "#{j['repo']}-#{j['pkgbase']}-#{j['version']}-#{j['arch']}-a#{j['attempt']}".gsub(/[^A-Za-z0-9:_.-]/, '_')
    ["_SYSTEMD_UNIT=archci-build@#{name}.service"]
  end
end

# the job's log lines and the index of its first error: the archived log for
# a finished job, the journal's last lines for a running one
def read_log(j)
  lines = if j['state'] == 'running' && JOURNAL && File.directory?(JOURNAL)
            out, = Open3.capture2('journalctl', '-D', JOURNAL, '--no-pager', '-a', '-o', 'cat', '-n', '400', *journal_matches(j), err: File::NULL)
            out.scrub.lines(chomp: true)
          else
            File.exist?(j['log']) ? File.read(j['log']).scrub.lines(chomp: true) : []
          end
  [lines, j['state'] == 'done' ? nil : lines.index { |l| error_line?(l) }]   # a done job's line of interest is its last
end

# the job's story in one line: state, where, when, what it had
def story(j)
  s = case j['state']
      when 'pending' then "pending since #{j['created']}, attempt #{j['attempt'] + 1} of #{MAX_ATTEMPTS} next"
      when 'running' then "running on #{j['worker']} since #{j['claimed']}, attempt #{j['attempt']} of #{MAX_ATTEMPTS}#{j['phase'] ? ", in #{j['phase']}" : ''}"
      when 'done' then "done #{j['finished']} on #{j['worker']}, attempt #{j['attempt']}"
      when 'failed' then "failed #{j['finished']} on #{j['worker']}, attempt #{j['attempt']} of #{MAX_ATTEMPTS}#{j['final'] ? ': gave up' : ''}"
      end
  had = []
  had << "sources #{j['sources']}" if j['sources']
  had << 'network' if j['network'] == '1'
  had << "#{j['rss']}M rss, #{j['peak']}M peak" if j['rss']
  had.empty? ? s : "#{s}; #{had.join(', ')}"
end

# a job's row in the tree: its arch (and version, when the package has several
# among the jobs shown), state, worker, tries, when
def job_row(j, versions, last)
  branch = last ? '  \\_ ' : '  |_ '
  what = versions > 1 ? "#{j['arch']} #{j['version']}" : j['arch']
  format('%-34s %-8s %-17s %5s %s', (branch + what)[0, 34], j['state'], j['worker'].to_s[0, 17], "#{j['attempt']}/#{MAX_ATTEMPTS}",
         j['finished'] || j['claimed'] || j['created'])
end

def pkg_row(name, js)
  format('%-34s %s', "#{name} #{js.map { |j| j['version'] }.uniq.join(', ')}"[0, 34], js.first['origin'])
end

words = ARGV.dup

# ---- into a pipe: the list, with the first error line ----
unless $stdout.tty? && $stdin.tty?
  tree(filtered(all_jobs, words)).each do |kind, a, b, versions|
    if kind == :pkg
      puts pkg_row(a, b)
    else
      lines, err = read_log(a)
      puts "#{job_row(a, versions, b)}: #{err ? lines[err].strip[0, 160] : (lines.empty? ? '-' : lines.last.strip[0, 160])}"
    end
  end
  exit
end

# ---- the two-pane view ----
def reverse(s) = "\e[7m#{s}\e[0m"
def bold(s) = "\e[1m#{s}\e[0m"
def dim(s) = "\e[2m#{s}\e[0m"

every = all_jobs
rows = tree(filtered(every, words))
job_rows = rows.each_index.select { |i| rows[i][0] == :job }   # the rows a selection can rest on
selected = 0       # index into job_rows
list_top = 0       # the first tree row shown
log_lines = []
log_at = nil
log_of = nil
log_mtime = nil
show_job = false   # the job file instead of the log
editing = nil      # the filter being typed, nil otherwise
message = nil

current = -> { job_rows.empty? ? nil : rows[job_rows[selected]][1] }

load_log = lambda do
  j = current.call or return
  mtime = File.exist?(j['log']) ? File.mtime(j['log']) : j['mtime']
  return if log_of == j['id'] && log_mtime == mtime

  log_lines, err = read_log(j)
  log_at = err ? [err - 3, 0].max : [log_lines.size - 1, 0].max
  log_of = j['id']
  log_mtime = mtime
end

frame = lambda do
  height, cols = $stdout.winsize
  cols = 120 if cols.to_i <= 0
  height = 40 if height.to_i <= 0
  out = []
  list_rows = [[rows.size, (height * 0.45).to_i - 2].min, 3].max
  filter = editing ? "/#{editing}_" : (words.empty? ? '' : "/#{words.join(' ')}")
  out << "#{bold('archci jobs')}  #{job_rows.size} of #{every.size}  #{bold(filter)}#{dim('   (/ filter, j/k pick, J/K scroll, e/E errors, i job, l log, r retry, q quits)')}"
  out << bold(format('%-34s %-8s %-17s %5s %s', 'PACKAGE / JOB', 'STATE', 'WORKER', 'TRIES', 'WHEN'))
  cursor = job_rows[selected] || 0
  list_top = cursor if cursor < list_top
  list_top = cursor - list_rows + 1 if cursor >= list_top + list_rows
  list_top = [list_top, cursor - 1].min if cursor.positive? && rows[cursor - 1][0] == :pkg   # its package line too
  rows[list_top, list_rows].to_a.each_with_index do |(kind, a, b, versions), i|
    line = kind == :pkg ? bold(pkg_row(a, b)[0, cols]) : job_row(a, versions, b)[0, cols]
    out << (list_top + i == cursor && kind == :job ? reverse(line.ljust(cols)) : line)
  end
  out << '(no job matches)' if job_rows.empty?
  out << ''
  if (j = current.call)
    load_log.call
    out << "#{bold("#{j['pkgbase']} #{j['version']}")}  #{j['arch']}, from #{j['origin']}   job #{j['id']}"
    out << story(j)[0, cols]
    body = height - out.size - 2
    if show_job
      out << dim("job file #{j['path']}")
      File.readlines(j['path'], chomp: true).first(body).each { |l| out << l[0, cols] }
    else
      what = j['state'] == 'running' ? 'journal so far' : "log #{j['log']}"
      out << (message ? bold(message) : dim("#{what}#{log_lines.empty? ? ' (none)' : " (#{log_lines.size} lines)"}"))
      log_lines[log_at.to_i, body].to_a.each do |l|
        l = l[0, cols]
        out << (error_line?(l) ? bold(l) : l)
      end
    end
  end
  print "\e[H", out.first(height - 1).map { |l| "#{l}\e[K\r\n" }.join, "\e[J"
end

next_error = lambda do |from|
  i = log_lines.each_index.find { |k| k > from && error_line?(log_lines[k]) }
  i ? [i - 3, 0].max : log_at
end
prev_error = lambda do |from|
  i = log_lines.each_index.reverse_each.find { |k| k < from && error_line?(log_lines[k]) }
  i ? [i - 3, 0].max : log_at
end
rebuild = lambda do
  keep = current.call&.dig('id')
  rows = tree(filtered(every, words))
  job_rows = rows.each_index.select { |i| rows[i][0] == :job }
  selected = [job_rows.index { |i| rows[i][1]['id'] == keep } || 0, [job_rows.size - 1, 0].max].min
end

restore = -> { $stdin.cooked!; print "\e[?25h\e[H\e[J" }
trap('INT') { restore.call; exit }
trap('TERM') { restore.call; exit }
$stdin.raw!
print "\e[?25l"
loop do
  frame.call
  key = IO.select([$stdin], nil, nil, 5) ? $stdin.read_nonblock(16, exception: false) : nil
  if key.nil?   # the interval passed: the queue may have changed
    every = all_jobs
    rebuild.call
    next
  end
  next unless key.is_a?(String)

  if editing   # typing the filter
    case key
    when "\r", "\n" then words = editing.split; editing = nil; rebuild.call
    when "\e" then words = []; editing = nil; rebuild.call
    when "", "\b" then editing = editing[0...-1]
    else editing += key if key.match?(/\A[[:print:]]+\z/)
    end
    next
  end
  message = nil
  page = ($stdout.winsize[0] * 0.5).to_i
  last = [log_lines.size - 1, 0].max
  case key
  when 'q', "\e", "" then break
  when '/' then editing = words.join(' ')
  when 'j', "\e[B" then selected = [selected + 1, [job_rows.size - 1, 0].max].min
  when 'k', "\e[A" then selected = [selected - 1, 0].max
  when 'J', "\e[6~" then log_at = [log_at.to_i + page, last].min
  when 'K', "\e[5~" then log_at = [log_at.to_i - page, 0].max
  when 'g' then log_at = 0
  when 'G' then log_at = [log_lines.size - page, 0].max
  when 'e' then log_at = next_error[log_at.to_i + 3]
  when 'E' then log_at = prev_error[log_at.to_i + 3]
  when 'i' then show_job = !show_job
  when 'l'
    if (j = current.call)
      $stdin.cooked!
      print "\e[?25h"
      if j['state'] == 'running'
        IO.popen([ENV.fetch('PAGER', 'less'), '+G'], 'w') { |p| p.puts log_lines }
      elsif File.exist?(j['log'])
        system(ENV.fetch('PAGER', 'less'), "+#{log_at.to_i + 1}", j['log'])
      end
      $stdin.raw!
      print "\e[?25l"
    end
  when 'r'
    if (j = current.call) && j['state'] == 'failed'
      out, st = Open3.capture2e(File.join(Archci::ROOT, 'master', 'archci-job'), 'retry', j['id'])
      message = st.success? ? "retrying #{j['pkgbase']} #{j['version']} #{j['arch']}: queued as a fresh first attempt" : "retry failed: #{out.strip}"
      every = all_jobs
      rebuild.call
    end
  end
end
restore.call
