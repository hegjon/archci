#!/usr/bin/env ruby
# frozen_string_literal: true

# archci-top [-n SECONDS] [--once] -- top-like view of the farm, redrawn from the
# master's queue, the workers' heartbeats and their streamed journals.
#
#   header   queue depth, outstanding work, built per arch, done in the last hour
#   hosts    one row per host seen recently, its workers grouped: native arch,
#            load, memory, chroot disk and threads from the newest heartbeat
#            any of them sent, how many workers it runs and how many are busy
#   jobs     one row per running job: elapsed, worker, attempt, heartbeat age,
#            the job's CPU (cores), memory (current and peak) and build-tree
#            size from its cgroup, the makepkg phase and the last output line
#            (from the worker's journal streamed to ARCHCI_REMOTE_JOURNAL)
#   failed   the newest failures
# q, Escape or Ctrl-C quits.
require_relative '../lib/archci'
require 'io/console'
require 'open3'

interval = 5
once = false
ARGV.each_with_index do |a, i|
  case a
  when '-n' then interval = ARGV[i + 1].to_f
  when '--once' then once = true
  when '-h', '--help'
    puts 'usage: archci-top [-n SECONDS] [--once]'
    exit
  end
end

journal = Archci.config['ARCHCI_REMOTE_JOURNAL']

def elapsed(seconds)
  s = seconds.to_i
  return format('%dd%02dh', s / 86_400, s % 86_400 / 3600) if s >= 86_400
  return format('%dh%02dm', s / 3600, s % 3600 / 60) if s >= 3600

  format('%dm%02ds', s / 60, s % 60)
end

# The build unit's name on the worker (archci-worker's rule) and, from its
# journal streamed to the master, the makepkg phase and last output line.
def unit_name(j)
  "archci-build@#{"#{j['repo']}-#{j['pkgbase']}-#{j['version']}-#{j['arch']}-a#{j['attempt']}".gsub(/[^A-Za-z0-9:_.-]/, '_')}"
end

def journal_tail(dir, unit)
  return ['', ''] unless File.directory?(dir)

  base = ['journalctl', '-D', dir, '-u', unit, '-o', 'cat', '--no-pager', '-n', '1']
  last, = Open3.capture2(*base, err: File::NULL)
  # the newest makepkg marker ("==> Starting build()...", "==> Making package: ...")
  marker, = Open3.capture2(*base, '-g', '^==> (Starting|Making package|Retrieving|Validating|Verifying|Extracting|Creating|Updating|Synchronizing)', err: File::NULL)
  phase = marker.strip.sub(/^==> Starting (\w+)\(\).*/, '\1').sub(/^==> /, '').split(/[ :(]/).first.to_s.downcase
  [phase, last.strip]
rescue StandardError
  ['', '']
end

def frame(journal)
  now = Time.now
  width = (ENV['COLUMNS'] || `tput cols 2>/dev/null`.to_i.nonzero? || 120).to_i
  snap = Archci.snapshot(now)
  repo = snap['repo']
  counts = snap['queue']
  running = snap['running']
  failed = snap['failed'].first(5)

  out = []
  out << format('archci-top  %s   pkgbuilds -> [%s]   arches: %s   (q or Esc quits)', now.strftime('%H:%M:%S'), repo, snap['arches'].join(' '))
  out << format('queue: pending %d  running %d  failed %d  done %d (%d in the last hour)    outstanding: %d update(s), %d unbuilt',
                counts['pending'], counts['running'], counts['failed'], counts['done'], snap['done_last_hour'],
                snap['outstanding']['updates'], snap['outstanding']['backlog'])
  out << format('built: %s', snap['built'].map { |k, n| "#{k.delete_prefix("#{repo}-")} #{n}/#{snap['tracked'][k]}" }.join('  '))
  out << ''

  # hosts: one row each, its workers grouped, from the newest heartbeat any
  # of them sent (an idle host shows the last beat its finished jobs kept)
  out << format('%-22s %-8s %6s %5s %5s %7s %7s %6s', 'HOST', 'ARCH', 'LOAD', 'MEM%', 'DISK%', 'THREADS', 'WORKERS', 'ACTIVE')
  snap['hosts'].each do |h|
    out << format('%-22s %-8s %6s %5s %5s %7s %7d %6d', h['host'], h['arch'] || '-', h['load'] || '-', h['mem'] || '-',
                  h['disk'] || '-', h['cpus'] || '-', h['workers'].size, h['building'])
  end
  out << ''

  out << format('%-8s %-22s %-8s %-3s %4s %5s %6s %6s %6s  %-9s %s', 'ELAPSED', 'WORKER', 'ARCH', 'ATT', 'HB', 'CPU', 'RSS', 'PEAK', 'DISK', 'PHASE', 'PACKAGE  | last output')
  mib = ->(v) { v ? "#{v}M" : '-' }
  running.each do |j|
    since = j['claimed'] ? now - Time.iso8601(j['claimed']) : j['heartbeat_age_s']
    hb_s = j['heartbeat_age_s']
    hb = hb_s <= 99 ? "#{hb_s}s" : "#{(hb_s / 60.0).round}m"   # seconds while they fit in two digits, then minutes
    phase, last = journal_tail(journal, unit_name(j))
    line = format('%-8s %-22s %-8s %-3d %4s %5s %6s %6s %6s  %-9s %s %s', elapsed(since), j['worker'], j['arch'], j['attempt'], hb,
                  j['cpu'] || '-', mib[j['rss_mib']], mib[j['peak_mib']], j['build'] || '-',
                  phase[0, 9], "#{j['pkgbase']} #{j['version']}", last.empty? ? '' : "| #{last}")
    out << line[0, width]
  end
  out << '(nothing running)' if running.empty?
  out << ''
  unless failed.empty?
    out << 'FAILED (newest first)'
    failed.each do |j|
      out << format('  %-40s %-20s attempt %d%s  %s', "#{j['pkgbase']} #{j['version']} #{j['arch']}", j['worker'],
                    j['attempt'], j['final'] ? ' GAVE UP' : '', j['finished'])[0, width]
    end
  end
  out
end

if once
  puts frame(journal)
  exit
end

# Redraw every interval; between frames wait for a key. The terminal is put in
# raw mode so a single q ends the program, which also turns Ctrl-C into a
# plain character we treat the same way.
tty = $stdin.tty?
restore = lambda do
  $stdin.cooked! if tty
  print "\e[?25h\n"
end
trap('INT') { restore.call; exit }
trap('TERM') { restore.call; exit }
$stdin.raw! if tty
print "\e[?25l"
loop do
  lines = frame(journal)
  print "\e[H\e[2J"
  puts lines.map { |l| "#{l}\r" }   # raw mode: \n alone does not return the cursor
  if tty && IO.select([$stdin], nil, nil, interval)
    key = $stdin.read_nonblock(1, exception: false)
    break if key.is_a?(String) && (key.downcase == 'q' || key == "\e" || key == "\u0003")
  elsif !tty
    sleep interval
  end
end
restore.call
