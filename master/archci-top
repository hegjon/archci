#!/usr/bin/env ruby
# frozen_string_literal: true

# archci-top [-n SECONDS] [--once] [--no-journal] [--json] -- top-like view of
# the farm, redrawn from the master's queue, the workers' heartbeats and their
# streamed journals (--no-journal leaves those out: PHASE and the last output
# line). --once prints one frame; --json prints the snapshot it is drawn from.
#
#   header   queue depth, outstanding work, built per arch, done in the last hour
#   hosts    the master itself first, then one row per host seen recently, its
#            workers grouped: native arch,
#            load, memory, chroot disk and threads from the newest heartbeat
#            any of them sent, how many workers it runs and how many are busy,
#            and the archci version the workers run
#   jobs     one row per running job: elapsed, worker, attempt, heartbeat age,
#            the job's %CPU (100 = one core), memory (current and peak) and build-tree
#            size from its cgroup, the makepkg phase and the last output line
#            (from the worker's journal streamed to ARCHCI_REMOTE_JOURNAL)
#   failed   the newest failures
# q, Escape or Ctrl-C quits.
require_relative '../lib/archci-frame'
require 'io/console'

interval = 5
once = false
json = false
with_journal = true
ARGV.each_with_index do |a, i|
  case a
  when '-n' then interval = ARGV[i + 1].to_f
  when '--once' then once = true
  when '--json' then json = true
  when '--no-journal' then with_journal = false
  when '-h', '--help'
    puts 'usage: archci top [-n SECONDS] [--once] [--no-journal] [--json]'
    puts '  --once        print one frame and exit'
    puts '  --no-journal  skip the workers\' streamed journals (no PHASE and last output): instant'
    puts '  --json        print the snapshot the frame is drawn from as JSON and exit'
    exit
  end
end

journal = with_journal ? Archci.config['ARCHCI_REMOTE_JOURNAL'] : nil

if json
  puts JSON.pretty_generate(Archci.snapshot)
  exit
end

if once
  puts frame(journal, hint: false)
  exit
end

# Redraw every interval; between frames wait for a key. The terminal is put in
# raw mode so a single q ends the program, which also turns Ctrl-C into a
# plain character we treat the same way.
tty = $stdin.tty?
restore = lambda do
  $stdin.cooked! if tty
  print "\e[?25h\n"
end
trap('INT') { restore.call; exit }
trap('TERM') { restore.call; exit }
$stdin.raw! if tty
print "\e[?25l"
# The first frame skips the journal so the screen comes up at once; the
# journal columns fill in from the next cycle on.
first = true
loop do
  lines = frame(first ? nil : journal)
  # the second frame, with the journal columns, comes early
  wait = first ? [2, interval].min : interval
  first = false
  print "\e[H\e[2J"
  puts lines.map { |l| "#{l}\r" }   # raw mode: \n alone does not return the cursor
  if tty && IO.select([$stdin], nil, nil, wait)
    key = $stdin.read_nonblock(1, exception: false)
    break if key.is_a?(String) && (key.downcase == 'q' || key == "\e" || key == "\u0003")
  elsif !tty
    sleep wait
  end
end
restore.call
