#!/usr/bin/env ruby
# frozen_string_literal: true

# archci-top [-n SECONDS] -- top-like view of the farm, redrawn from the
# master's queue, the workers' heartbeats and their streamed journals,
# followed live (one journalctl -f for the session). Into a pipe or a file
# (stdout not a terminal) it prints one frame, without the last-output
# column, and exits.
#
#   header   queue depth, outstanding work, built per arch, done in the last hour
#   hosts    the master itself first, then one row per host seen recently, its
#            workers grouped: native arch,
#            load, memory, chroot disk and threads from the newest heartbeat
#            any of them sent, how many workers it runs and how many are busy,
#            and the archci version the workers run
#   jobs     one row per running job: elapsed, worker, attempt, heartbeat age,
#            the job's load (cores in use, like a load average), memory (current and peak) and build-tree
#            size from its cgroup and the makepkg phase, all from the worker's
#            heartbeats, and the last output line from the worker's journal
#            streamed to ARCHCI_REMOTE_JOURNAL
#   failed   the newest failures
# q, Escape or Ctrl-C quits.
require_relative '../lib/archci-frame'
require 'io/console'

interval = 5
ARGV.each_with_index do |a, i|
  case a
  when '-n' then interval = ARGV[i + 1].to_f
  when '-h', '--help'
    puts 'usage: archci top [-n SECONDS]'
    puts '  -n SECONDS    redraw interval (5); into a pipe or a file, one frame is printed'
    exit
  end
end

# not a terminal (a pipe, a file, the tests): one frame
unless $stdout.tty? && $stdin.tty?
  puts frame(nil, hint: false)
  exit
end

dir = Archci.config['ARCHCI_REMOTE_JOURNAL']
journal = dir && File.directory?(dir) ? JournalFollow.new(dir) : nil

# Redraw every interval; between frames wait for a key. The terminal is put in
# raw mode so a single q ends the program, which also turns Ctrl-C into a
# plain character we treat the same way.
restore = lambda do
  journal&.stop
  $stdin.cooked!
  print "\e[?25h\n"
end
trap('INT') { restore.call; exit }
trap('TERM') { restore.call; exit }
$stdin.raw!
print "\e[?25l"
# The first frame skips the journal so the screen comes up at once (a job's
# first look costs a moment each); the journal columns fill in from the
# next cycle on, then keep up with the stream.
first = true
loop do
  lines = frame(first ? nil : journal)
  # the second frame, with the journal columns, comes early
  wait = first ? [2, interval].min : interval
  first = false
  print "\e[H\e[2J"
  puts lines.map { |l| "#{l}\r" }   # raw mode: \n alone does not return the cursor
  next unless IO.select([$stdin], nil, nil, wait)

  key = $stdin.read_nonblock(1, exception: false)
  break if key.is_a?(String) && (key.downcase == 'q' || key == "\e" || key == "\u0003")
end
restore.call
