#!/usr/bin/env ruby
# frozen_string_literal: true

# archci-top [-n SECONDS] -- top-like view of the farm, redrawn from the
# master's queue, the workers' heartbeats and their streamed journals,
# followed live (one journalctl -f for the session). Into a pipe or a file
# (stdout not a terminal) it prints one frame, without the last-output
# column, and exits.
#
#   header   queue depth, outstanding work, built per arch, done in the last hour
#   hosts    the master itself first, then one row per host seen recently, its
#            workers grouped: native arch,
#            load, memory, chroot disk and threads from the newest heartbeat
#            any of them sent, how many workers it runs and how many are busy,
#            and the archci version the workers run
#   jobs     one row per running job: elapsed, worker, attempt, heartbeat age,
#            the job's load (cores in use, like a load average), memory (current and peak) and build-tree
#            size from its cgroup and the makepkg phase, all from the worker's
#            heartbeats, and the last output line from the worker's journal
#            streamed to ARCHCI_REMOTE_JOURNAL
#   failed   the newest failures
# q, Escape or Ctrl-C quits.
require_relative '../lib/archci'
require 'open3'
require 'io/console'

# ---- the frame: the farm as one screen, from Archci.snapshot; styled only on a terminal ----

def elapsed(seconds)
  s = seconds.to_i
  return format('%dd%02dh', s / 86_400, s % 86_400 / 3600) if s >= 86_400
  return format('%dh%02dm', s / 3600, s % 3600 / 60) if s >= 3600

  format('%dm%02ds', s / 60, s % 60)
end

# the ELAPSED column: hh:mm:ss (hours keep counting past a day: 26:03:04)
def hms(seconds)
  s = seconds.to_i
  format('%02d:%02d:%02d', s / 3600, s % 3600 / 60, s % 60)
end

# A worker id with an emulated arch in it, host-aarch64-2, shown as host-a2:
# the ARCH column says which arch; the letter keeps it apart from host-2.
def short_worker(worker)
  host, port = Archci.worker_host(worker.to_s)
  port ? "#{host}-#{port[0]}#{worker[/(\d+)\z/, 1]}" : worker
end

# The build unit's name on the worker (archci-worker's rule): the key of its
# lines in the journal streamed to the master.
def unit_name(j)
  "archci-build@#{"#{j['repo']}-#{j['pkgbase']}-#{j['version']}-#{j['arch']}-a#{j['attempt']}".gsub(/[^A-Za-z0-9:_.-]/, '_')}"
end

# The remote journal holds every worker's every build (a gigabyte or more,
# and the master has one CPU). It is read for one thing, each running job's
# last output line: JournalFollow keeps one "journalctl -f" for the session,
# read by a thread that remembers the newest line per build unit as it
# arrives; a frame only renders. A job that was already running when the
# session began shows no line until it prints its next one. The phase comes
# with the worker's heartbeat (archci_phase_filter), not from here.
#
# One journalctl -f for the session; last(units) answers from what it has
# streamed.
class JournalFollow
  def initialize(dir)
    @dir = dir
    @lock = Mutex.new
    @last = {}
    @pid = nil
    @reader = Thread.new { follow }
  end

  # journalctl -f, starting with the last 100 entries; started again should
  # it end (it survives the journal's own file rotation, but not much else)
  def follow
    loop do
      begin
        stdin, out, waiter = Open3.popen2('journalctl', '-D', @dir, '--no-pager', '-o', 'json',
                                          '--output-fields=MESSAGE,_SYSTEMD_UNIT', '-f', '-n', '100', err: File::NULL)
        @pid = waiter.pid
        stdin.close
        out.each_line do |line|
          # journalctl writes UTF-8 whatever the locale (a unit's may be none: US-ASCII)
          e = begin
            JSON.parse(line.force_encoding(Encoding::UTF_8).scrub)
          rescue JSON::ParserError, EncodingError
            next
          end
          # the unit as unit_name spells it (the journal appends .service); a
          # message that was not valid UTF-8 comes as an array of bytes
          u = e['_SYSTEMD_UNIT'].to_s.delete_suffix('.service')
          next unless u.start_with?('archci-build@')

          m = e['MESSAGE']
          msg = (m.is_a?(Array) ? m.pack('C*').force_encoding('UTF-8') : m.to_s).strip
          @lock.synchronize { @last[u] = msg }
        end
      rescue StandardError
        nil
      ensure
        # however the read ended (EOF, an error, this thread killed): no
        # journalctl of ours outlives it
        kill_child
        out&.close
      end
      sleep 2
    end
  end

  def kill_child
    pid = @pid
    @pid = nil
    return unless pid

    Process.kill('TERM', pid)
    Process.wait(pid)
  rescue Errno::ESRCH, Errno::ECHILD, Errno::EPERM
    nil
  end

  def stop
    @reader.kill
    kill_child
  end

  # units -> { unit => last line streamed, '' for none yet }
  def last(units)
    @lock.synchronize { units.to_h { |u| [u, @last[u].to_s] } }
  end
end

# top's looks on a terminal: bold headers and figures. Plain when the output
# is not a terminal (a pipe, the tests).
STYLE = $stdout.tty?
def bold(s) = STYLE ? "\e[1m#{s}\e[0m" : s
# a colour (an SGR code) around a cell already padded to its width, so the
# escape bytes cost no columns; nil for none
def paint(s, code) = STYLE && code ? "\e[#{code}m#{s}\e[0m" : s
DIM = '2'
RED = '31'
GREEN = '32'
YELLOW = '33'
BLUE = '34'
MAGENTA = '35'
CYAN = '36'
BOLD_RED = '1;31'
BOLD_YELLOW = '1;33'
# a share of something (disk, memory, a host's threads): green to 60%,
# yellow to 85%, red above
def heat(pct) = pct < 60 ? GREEN : (pct < 85 ? YELLOW : RED)
# a five-cell gauge of a percentage, ▇▇▇▁▁ (on a terminal only: the piped
# frame keeps the bare figures)
def gauge(pct) = ('▇' * (pct / 20.0).round.clamp(0, 5)).ljust(5, '▁')
# the makepkg phases the worker reports, coloured by kind: getting the
# sources, preparing the chroot, building, packaging, delivering
PHASE_COLOUR = { 'download' => CYAN, 'verify' => CYAN, 'sums' => CYAN, 'extract' => CYAN,
                 'sync' => BLUE, 'update' => BLUE, 'deps' => BLUE, 'start' => BLUE,
                 'build' => BOLD_YELLOW, 'check' => MAGENTA,
                 'package' => GREEN, 'compress' => GREEN, 'upload' => GREEN }.freeze

# cells [[text, colour], ...] as one row: joined by a space, cut to width
# when one is given, each cell coloured after the cut (its text is already
# padded to its column)
def row(cells, width = nil)
  out = +''
  used = 0
  cells.each_with_index do |(text, colour), i|
    sep = i.zero? ? '' : ' '
    room = width ? width - used - sep.length : text.to_s.length
    break if room <= 0

    t = text.to_s[0, room]
    out << sep << paint(t, colour)
    used += sep.length + t.length
  end
  out
end

# journal: a JournalFollow for the last output line, nil for none (stdout not
# a terminal, which also leaves the quit hint out of the title)
def frame(journal)
  now = Time.now
  width = (ENV['COLUMNS'] || `tput cols 2>/dev/null`.to_i.nonzero? || 120).to_i
  snap = Archci.snapshot(now)
  repo = snap['repo']
  counts = snap['queue']
  running = snap['running']
  failed = snap['failed'].first(5)

  out = []
  out << format('%s  %s   pkgbuilds -> [%s]   arches: %s%s', bold('archci-top'), now.strftime('%H:%M:%S'), repo,
                snap['arches'].join(' '), STYLE ? paint('   (q or Esc quits)', DIM) : '')
  out << format('queue: pending %s  running %s  failed %s  done %s (%s in the last hour)    outstanding: %s update(s), %s unbuilt',
                bold(counts['pending']), bold(counts['running']), paint(bold(counts['failed']), counts['failed'].positive? ? RED : nil),
                bold(counts['done']), bold(snap['done_last_hour']), bold(snap['outstanding']['updates']), bold(snap['outstanding']['backlog']))
  out << format('built: %s', snap['built'].map { |k, n| "#{k.delete_prefix("#{repo}-")} #{bold(n)}/#{snap['tracked'][k]}" }.join('  '))
  # the signer, as seen through R2 by archci-signer-status: what is signed
  # and released per arch on one line, what waits unsigned in staging on
  # the next
  if (s = snap['signer'])
    rel = (s['release'] || {}).map { |a, r| r['updated'] ? "#{a} #{bold(r['packages'])} pkg" : "#{a} #{paint('unreachable', BOLD_RED)}" }
    out << "released: #{rel.join('  ')}" unless rel.empty?
    st = s['staging'] || {}
    waiting = st['waiting'].to_i
    line = format('unsigned: %s pkg in staging%s', paint(bold(waiting), waiting.positive? ? YELLOW : nil), st['oldest_s'] ? " (oldest #{elapsed(st['oldest_s'])})" : '')
    line += paint("   [status #{elapsed(s['age_s'])} old]", BOLD_YELLOW) if s['age_s'] > 600
    out << line
  end
  out << ''

  # hosts: one row each, its workers grouped, from the newest heartbeat any
  # of them sent (an idle host shows the last beat its finished jobs kept)
  # on a terminal the load, disk and memory columns carry a gauge before the
  # figure (the load's against the host's threads) and its colour; the
  # piped frame the figures alone
  gw = STYLE ? 11 : 5   # gauge, a space, the figure
  out << bold(format("%-22s %-13s %-7s %#{gw}s %#{gw}s %#{gw}s %7s %7s %6s  %s", 'HOST', 'VENDOR', 'ARCH', 'LOAD', '%DISK', '%MEM', 'THREADS', 'WORKERS', 'ACTIVE', 'ARCHCI'))
  # the load in five characters: as sent (two decimals) below 100, whole from 100
  load = ->(l) { l.nil? ? '-' : (l.to_f < 100 ? l : format('%.0f', l.to_f)) }
  # a percentage as a cell: the gauge and the figure on a terminal, coloured by heat
  share = lambda do |v|
    return [format("%#{gw}s", '-'), nil] if v.nil?

    pct = v.to_f
    [STYLE ? format('%s %4d%%', gauge(pct), pct.round) : format('%5s', v), heat(pct)]
  end
  master_version = snap['hosts'].first&.dig('archci')
  snap['hosts'].each do |h|
    if h['load'].nil? then load_cell = [format("%#{gw}s", '-'), nil]
    else
      pct = h['cpus'].to_i.positive? ? h['load'].to_f / h['cpus'].to_i * 100 : 0
      load_cell = [STYLE ? format('%s %5s', gauge(pct), load[h['load']]) : format('%5s', load[h['load']]), heat(pct)]
    end
    version = h['archci'] || '-'
    out << row([[format('%-22s', h['host']), nil], [format('%-13s', (h['vendor'] || '-')[0, 13]), nil], [format('%-7s', h['arch'] || '-'), nil],
                load_cell, share[h['disk']], share[h['mem']], [format('%7s', h['cpus'] || '-'), nil],
                [format('%7d', h['workers'].size), h['workers'].empty? ? DIM : nil], [format('%6d ', h['building']), h['building'].zero? ? DIM : nil],
                [version, version == master_version ? nil : BOLD_RED]])
  end
  out << ''

  out << bold(format('%-8s %-19s %-7s %3s %4s %5s %5s %5s %5s  %-8s %-8s %s', 'ELAPSED', 'WORKER', 'ARCH', 'ATT', 'HB', 'LOAD', 'DISK', 'MEM', 'PEAK', 'PHASE', 'SOURCE', 'PACKAGE  | last output')[0, width])
  # a MiB count in five characters: 458M up to 999M, then 1.2G, then 100G
  mem = lambda do |v|
    return '-' if v.nil?

    g = v.to_i / 1024.0
    if v.to_i <= 999 then "#{v}M"
    elsif g < 99.95 then format('%.1fG', g)
    else format('%.0fG', g)
    end
  end
  # the build tree: KiB from the worker (raw du -sk)
  tree = ->(v) { v.nil? ? '-' : mem[(v.to_i / 1024.0).round] }
  # cores in use: the CPU time used over the wall time it took, both raw
  # from the worker, shown like a load
  cores = ->(j) { j['cpu_dt'].to_i.positive? ? load[format('%.2f', j['cpu_us'].to_f / j['cpu_dt'].to_f)] : '-' }
  # the last output line from the journal follower, '-' without one
  lasts = journal ? journal.last(running.map { |j| unit_name(j) }) : {}
  # by host, its native workers first, then per emulated arch, instance
  # numbers as numbers: host-1, host-3, host-aarch64-1, host-riscv64-2
  running.sort_by do |j|
    host, port = Archci.worker_host(j['worker'].to_s)
    [host, port ? 1 : 0, port.to_s, j['worker'].to_s[/(\d+)\z/, 1].to_i]
  end.each do |j|
    since = j['claimed'] ? now - Time.iso8601(j['claimed']) : j['heartbeat_age_s']
    hb_s = j['heartbeat_age_s']
    hb = hb_s <= 99 ? "#{hb_s}s" : "#{(hb_s / 60.0).round}m"   # seconds while they fit in two digits, then minutes
    last = lasts[unit_name(j)].to_s
    phase = j['phase'].to_s   # from the worker's heartbeat
    out << row([[format('%-8s', hms(since)), nil], [format('%-19s', short_worker(j['worker'])[0, 19]), nil], [format('%-7s', j['arch']), nil],
                [format('%3d', j['attempt']), j['attempt'] > 1 ? YELLOW : nil],
                [format('%4s', hb), hb_s > 120 ? BOLD_RED : (hb_s > 60 ? YELLOW : nil)],   # a beat comes every 30 s
                [format('%5s', cores[j]), nil], [format('%5s', tree[j['build']]), nil], [format('%5s', mem[j['rss']]), nil], [format('%5s ', mem[j['peak']]), nil],
                [format('%-8s', phase.empty? ? '-' : phase[0, 8]), phase.empty? ? DIM : PHASE_COLOUR[phase]],
                [format('%-8s', (j['origin'] || '-')[0, 8]), DIM], ["#{j['pkgbase']} #{j['version']}", nil],
                ["| #{last.empty? ? '-' : last}", DIM]], width)
  end
  out << '(nothing running)' if running.empty?
  out << ''
  unless failed.empty?
    out << bold(format('%-34s %-7s  %-17s %8s  %7s  %s', 'FAILED (newest first)', 'ARCH', 'WORKER', 'FAILURES', 'GAVE UP', 'LAST FAILURE'))
    failed.each do |j|   # given up in red, still to be retried in yellow
      out << paint(format('%-34s %-7s  %-17s %8d  %7s  %s', "#{j['pkgbase']} #{j['version']}"[0, 34], j['arch'], short_worker(j['worker']),
                          j['attempt'], j['final'] ? 'yes' : '-', j['finished'])[0, width], j['final'] ? RED : YELLOW)
    end
  end
  out
end

# ---- the program ----

interval = 5
ARGV.each_with_index do |a, i|
  case a
  when '-n' then interval = ARGV[i + 1].to_f
  when '-h', '--help'
    puts 'usage: archci top [-n SECONDS]'
    puts '  -n SECONDS    redraw interval (5); into a pipe or a file, one frame is printed'
    exit
  end
end

# not a terminal (a pipe, a file, the tests): one frame
unless $stdout.tty? && $stdin.tty?
  puts frame(nil)
  exit
end

dir = Archci.config['ARCHCI_REMOTE_JOURNAL']
journal = dir && File.directory?(dir) ? JournalFollow.new(dir) : nil

# Redraw every interval; between frames wait for a key. The terminal is put in
# raw mode so a single q ends the program, which also turns Ctrl-C into a
# plain character we treat the same way.
restore = lambda do
  journal&.stop
  $stdin.cooked!
  print "\e[?25h\n"
end
trap('INT') { restore.call; exit }
trap('TERM') { restore.call; exit }
$stdin.raw!
print "\e[?25l"
loop do
  lines = frame(journal)   # taken before drawing: the screen keeps the last frame meanwhile
  # home, each line cleared to its end, the rest of the screen cleared after the
  # last: redrawn in place, no blank between frames (raw mode: \r\n, not \n)
  print "\e[H", lines.map { |l| "#{l}\e[K\r\n" }.join, "\e[J"
  next unless IO.select([$stdin], nil, nil, interval)

  key = $stdin.read_nonblock(1, exception: false)
  break if key.is_a?(String) && (key.downcase == 'q' || key == "\e" || key == "\u0003")
end
restore.call
