#!/usr/bin/env ruby
# frozen_string_literal: true

# archci-next -- print the next package to build, or nothing if all is built.
# Output: "<prio> <repo> <pkgbase> <version> <tag> <commit>". Used by
# archci-job claim when queue/pending is empty; safe to run by hand.
require_relative '../lib/archci'

entry = Archci.outstanding(limit: 1).first
exit 0 unless entry

puts entry.values_at('prio', 'repo', 'pkgbase', 'version', 'tag', 'commit').join(' ')
