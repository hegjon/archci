#!/usr/bin/env ruby
# frozen_string_literal: true

# archci-next [ARCH] -- print the next package to build for a worker of ARCH
# (default: every enabled arch), or nothing if all is built.
# Output: "<prio> <repo> <arch> <pkgbase> <version> <commit> <profile> <flags>",
# where <arch> is the job's arch: the worker's, or "any", and <flags> is
# "network" for a package that builds with the network, "loopback" for one
# that may talk to itself (package.json "network": "full" | "loopback"),
# else "-". Used by archci-job claim
# when queue/pending holds nothing for the worker; safe to run by hand.
# archci-next src -- the next package without a source package for its
# commit, the same line, for the sourcer's claim.
# archci-next --graph [ARCH] -- the outstanding packages in claim order with
# what the dependency graph says of each: "<pkgbase> <arch> <dependents>
# <waiting for, or -><!: a waited-for build is running or queued>", where
# dependents is how many packages need it directly.
# archci-next --waiting PKGBASE ARCH -- the dependencies from this repository
# a job for PKGBASE on ARCH ("any" for an any package) still waits for, one
# line, empty for none. Used by archci-housekeeping to hold a failed job's
# retry until they are built.
require_relative '../lib/archci'

if ARGV[0] == '--graph'
  list = ARGV[1] == 'src' ? Archci.outstanding_sources : Archci.outstanding(arch: ARGV[1])
  list.each do |e|
    puts [e['pkgbase'], e['arch'], e['dependents'], e['waiting'].empty? ? '-' : e['waiting'].join(',') + (e['expected'] ? '!' : '')].join(' ')
  end
  exit
end
if ARGV[0] == '--waiting'
  puts Archci.waiting_for(ARGV[1], ARGV[2]).join(' ')
  exit
end
# not a package whose dependency is being built or retried: that build would only fail first
entry = if ARGV[0] == 'src'
          Archci.outstanding_sources.first
        else
          Archci.outstanding(arch: ARGV[0]).find { |e| !e['expected'] }
        end
exit 0 unless entry

puts [*entry.values_at('prio', 'repo', 'arch', 'pkgbase', 'version', 'commit', 'profile'), entry['network'] || '-'].join(' ')
