#!/bin/bash
# archci-pkgs [NAME...] -- list the packages in the PKGBUILD repository clone.
#
# One line per directory under <clone>/$ARCHCI_PKGBUILDS_DIR holding a PKGBUILD
# and .omarchy/package.json (the omarchy-pkgs layout):
#
#   <name> <version> <commit> <arch> <profile> <source> <build|skip> <arch_repo> <pkgnames> <deps>
#
#   name     the directory name; it is the job's pkgbase (the PKGBUILD's own
#            pkgbase may differ for a split package)
#   version  epoch:pkgver-pkgrel as the PKGBUILD declares it
#   commit   the last commit that touched the directory; a job pins it
#   arch     "any", or the PKGBUILD's arch array joined with commas
#   profile  devtools build profile: multilib for multilib packages, else extra
#   source   .omarchy/package.json "source" (aur, arch, local)
#   build    "skip" when package.json sets skip_build, else "build"
#   arch_repo .omarchy/package.json "arch_repo" (core, extra, multilib) for a
#            package carried from Arch Linux, else "-"; archci-next orders by it
#   pkgnames the PKGBUILD's pkgname array, comma-separated (a split package
#            has several); what other packages' deps name
#   deps     depends, makedepends and checkdepends at file scope, names only
#            (no version constraints, no .so names), comma-separated, "-" for
#            none; archci-next builds a package after the ones it depends on
#
# The list is cached in $ARCHCI_HOME/pkgbuilds.index keyed by the clone's HEAD,
# so archci-next (once per claim) just reads a file; archci-scan refreshes it
# after every pull. Versions come from sourcing each PKGBUILD at file scope
# with CARCH set, the way makepkg reads them; the repository is trusted input.
# Each directory's line is cached too, in $ARCHCI_CACHE_DIR/pkgbuilds.cache keyed
# by the directory's git tree hash (git ls-tree), which changes exactly when
# its content does: a new commit re-reads only the PKGBUILDs it touched,
# and a directory at a content seen before is never sourced again. The same
# data is written onto the PKGBUILD file itself as extended attributes
# (user.archci.tree, .version, .commit, .arch, .profile, .source, .build,
# .arch_repo, .pkgnames, .deps; getfattr -d PKGBUILD shows them): a checkout
# that changes the file drops them with the old inode. Nothing reads them
# yet. The clone is on btrfs (a requirement), which takes them.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

clone=$ARCHCI_PKGBUILDS_CLONE
index=$ARCHCI_PKGBUILDS_INDEX
# The clone, the index and its lock belong to the archci user. Run as that
# user when invoked by root (archci-top, archci-job enqueue), so git does
# not refuse the clone as "dubiously owned" and no root-owned file is left
# behind for the scan timer to trip over.
owner=$(stat -c %U "$ARCHCI_HOME" 2>/dev/null || echo root)
if (( EUID == 0 )) && [[ $owner != root ]]; then
	exec runuser -u "$owner" -- "$0" "$@"
fi
[[ -d $clone/.git ]] || archci_die "no PKGBUILD repository at $clone (run archci-scan first)"
command -v jq >/dev/null || archci_die "jq is not installed"
head=$(git -C "$clone" rev-parse HEAD)

index_current() { [[ -f $index && $(head -1 "$index") == "# $head v3" ]]; }

# annotate PKGBUILD HASH LINE -- the line's fields as user.archci.* attributes
# on the file, when it does not carry them for this hash yet
annotate() {
	local file=$1 hash=$2 f i
	[[ $(getfattr --only-values -n user.archci.tree "$file" 2>/dev/null) == "$hash" ]] && return 0
	read -ra f <<<"$3"
	setfattr -n user.archci.tree -v "$hash" "$file" || archci_die "cannot set extended attributes on $file (is the clone on btrfs?)"
	i=0
	for name in version commit arch profile source build arch_repo pkgnames deps; do
		setfattr -n "user.archci.$name" -v "${f[i]:--}" "$file"
		(( ++i ))
	done
}

generate() {
	local dir name version arches pkgnames deps commit source build profile mode type hash line newcache
	local cache=$ARCHCI_CACHE_DIR/pkgbuilds.cache
	local -A cached=()
	mkdir -p "$ARCHCI_CACHE_DIR"
	if [[ -f $cache ]]; then
		while read -r hash line; do cached[$hash]=$line; done <"$cache"
	fi
	newcache=$(mktemp "$cache.XXXXXX")
	printf '# %s v3\n' "$head"
	while read -r mode type hash name; do
		[[ $type == tree ]] || continue
		dir=$clone/$ARCHCI_PKGBUILDS_DIR/$name
		if [[ -n ${cached[$hash]:-} ]]; then   # this content was read before
			printf '%s %s\n' "$name" "${cached[$hash]}"
			printf '%s %s\n' "$hash" "${cached[$hash]}" >>"$newcache"
			annotate "$dir/PKGBUILD" "$hash" "${cached[$hash]}"
			continue
		fi
		[[ -f $dir/PKGBUILD && -f $dir/.omarchy/package.json ]] || continue
		version='' arches='' pkgnames='' deps=''
		# shellcheck disable=SC2016  # the single-quoted script runs in the child bash
		read -r version arches pkgnames deps < <(env -i PATH="$PATH" CARCH="$ARCHCI_ANY_ARCH" bash -c '
			cd "$1" && source ./PKGBUILD >/dev/null 2>&1
			ds=(); for d in "${depends[@]}" "${makedepends[@]}" "${checkdepends[@]}"; do
				d=${d%%[<>=]*}; [[ -z $d || $d == *.so* ]] && continue; ds+=("$d")
			done
			printf "%s %s %s %s\n" "${epoch:+$epoch:}${pkgver:-}-${pkgrel:-}" "$(IFS=,; printf "%s" "${arch[*]:-}")" \
				"$(IFS=,; printf "%s" "${pkgname[*]:-}")" "$(IFS=,; printf "%s" "${ds[*]:--}")"' _ "$dir") || true
		if [[ ! $name =~ ^[a-zA-Z0-9@._+-]+$ || ! $version =~ ^[a-zA-Z0-9@._+:~-]+-[a-zA-Z0-9.]+$ ]]; then
			archci_log "skipping $name: cannot read pkgver/pkgrel from its PKGBUILD"
			continue
		fi
		commit=$(git -C "$clone" log -1 --format=%H -- "$ARCHCI_PKGBUILDS_DIR/$name")
		read -r source build repo < <(jq -r '
			[(.source // "local"), (if .skip_build == true then "skip" else "build" end), (.arch_repo // "-")]
			| join(" ")' "$dir/.omarchy/package.json") || { archci_log "skipping $name: unreadable package.json"; continue; }
		if [[ $repo == multilib || $name == lib32-* ]]; then profile=multilib; else profile=extra; fi
		line="$version $commit ${arches:-x86_64} $profile $source $build $repo ${pkgnames:-$name} ${deps:--}"
		printf '%s %s\n' "$name" "$line"
		printf '%s %s\n' "$hash" "$line" >>"$newcache"
		annotate "$dir/PKGBUILD" "$hash" "$line"
	done < <(git -C "$clone" ls-tree "HEAD:$ARCHCI_PKGBUILDS_DIR")
	mv "$newcache" "$cache"   # entries for content no longer in the tree are gone with the old file
}

if ! index_current; then
	exec 8>"$ARCHCI_HOME/lock/index.lock"
	flock 8
	if ! index_current; then
		tmp=$(mktemp "$index.XXXXXX")
		generate >"$tmp"
		mv "$tmp" "$index"
	fi
	flock -u 8
fi

if (( $# )); then
	awk -v names=" $* " 'NR > 1 && index(names, " " $1 " ")' "$index"
else
	tail -n +2 "$index"
fi
