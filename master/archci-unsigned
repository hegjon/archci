#!/bin/bash
# archci-unsigned [N] -- what waits for the signer: the pooled packages and
# source packages that have no release signature, as <repo>/os/<arch>/<file>
# relative to the pool, the farm's own (archci*) first, then the oldest first,
# an arch-independent package once (its one signature is copied beside every
# arch's copy by archci-publish), those the signer rejected (<file>.rejected)
# left out. N: the first N only (default ARCHCI_SIGN_BATCH; 0 for all). The
# signer's key runs this over ssh (archci-shell signer: unsigned).
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

n=${1:-$ARCHCI_SIGN_BATCH}
[[ $n =~ ^[0-9]+$ ]] || archci_die "usage: archci unsigned [N]"
pool=$ARCHCI_HOME/repo
[[ -d $pool ]] || exit 0
declare -A seen=()
# "<own>|<mtime>|<path>", sorted, then the paths
find "$pool" -type f \( -name '*.pkg.tar.zst' -o -name '*.src.tar.zst' -o -name '*.src.tar.gz' \) -printf '%T@|%P\n' 2>/dev/null |
	while IFS='|' read -r mtime p; do
		# signed, parked, or signed and not yet accepted by archci-publish
		# (the signature waits in sigs/): not offered
		[[ -f $pool/$p.sig || -f $pool/$p.rejected || -f $ARCHCI_HOME/sigs/$p.sig ]] && continue
		name=${p##*/}
		if [[ $(archci_unhashed_stem "$name") == *-any ]]; then
			[[ -n ${seen[$name]:-} ]] && continue
			seen[$name]=1
			compgen -G "$ARCHCI_HOME/sigs/${p%%/*}/os/*/$name.sig" >/dev/null && continue
		fi
		own=1; [[ $name =~ ^archci(-[a-z0-9-]+)?-[0-9] ]] && own=0
		printf '%d|%s|%s\n' "$own" "$mtime" "$p"
	done | sort -t'|' -k1,1n -k2,2n | cut -d'|' -f3- | { if (( n )); then head -n "$n"; else cat; fi; }
