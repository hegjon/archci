#!/bin/bash
# archci-authorize PUBKEY -- let a worker key talk to this master.
#
# Appends the key, restricted to the job protocol by a forced command, to
# /etc/archci/authorized_keys (root-owned; sshd reads it for the archci user
# through /etc/ssh/sshd_config.d/archci.conf, which the master package
# installs). The key may also forward to the journal-remote
# port, for archci-logging-remote.service on a worker outside the private
# network. A key already present gets its line rewritten, so re-running this
# after an upgrade refreshes the options. Run as root. ARCHCI_AUTHORIZED_KEYS
# overrides the file, for the tests.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

key=${1:-}
[[ -n $key ]] || archci_die "usage: archci-authorize PUBKEY-FILE | 'ssh-ed25519 AAAA... comment'"
[[ -f $key ]] && key=$(<"$key")
[[ $key =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp[0-9]+|sk-[a-z0-9-]+@openssh.com)\ [A-Za-z0-9+/=]+ ]] || archci_die "that does not look like a public key"

akf=${ARCHCI_AUTHORIZED_KEYS:-/etc/archci/authorized_keys}
install -d -m 755 "${akf%/*}"
# Keys authorized before this file existed live in the archci user's own
# ~/.ssh/authorized_keys (not root's to guard); carry them over once.
old=$ARCHCI_HOME/.ssh/authorized_keys
if [[ ! -e $akf && -f $old ]]; then
	install -m 644 "$old" "$akf"
	mv "$old" "$old.migrated"
	archci_log "moved the keys from $old to $akf"
fi
[[ -e $akf ]] || : >"$akf"
line=$(printf 'command="%s",restrict,port-forwarding,permitopen="127.0.0.1:19532" %s' "$ARCHCI_MASTER_DIR/archci-shell" "$key")
if grep -qxF "$line" "$akf"; then
	archci_log "key already authorized"
elif grep -qF "${BASH_REMATCH[0]}" "$akf"; then
	grep -vF "${BASH_REMATCH[0]}" "$akf" >"$akf.tmp" || true
	printf '%s\n' "$line" >>"$akf.tmp"
	mv "$akf.tmp" "$akf"
	archci_log "updated: ${key##* }"
else
	printf '%s\n' "$line" >>"$akf"
	archci_log "authorized: ${key##* }"
fi
chmod 644 "$akf"
if [[ -z ${ARCHCI_AUTHORIZED_KEYS:-} && ! -f /etc/ssh/sshd_config.d/archci.conf ]]; then
	archci_log "WARNING: sshd does not read $akf yet: install ssh/sshd_config.d/archci.conf to /etc/ssh/sshd_config.d/ and reload sshd"
fi
