#!/bin/bash
# archci-authorize PUBKEY | --revoke PUBKEY|COMMENT -- let a worker key talk
# to this master, or stop it.
#
# Appends the key, restricted to the job protocol by a forced command, to
# /etc/archci/authorized_keys (root-owned; sshd reads it for the archci user
# through /etc/ssh/sshd_config.d/60-archci.conf, which the master package
# installs). The key may also forward to the journal-remote
# port, for archci-logging-tunnel.service on a worker outside the private
# network. A key already present gets its line rewritten, so re-running this
# after an upgrade refreshes the options. --revoke drops the line(s) holding
# that key, or whose comment (the key's last word: archci-worker@<host> for
# the keys archci-worker-setup makes) is COMMENT; sshd sees it at the next
# connection. Run as root. ARCHCI_AUTHORIZED_KEYS overrides the file, for
# the tests.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

usage="usage: archci authorize PUBKEY-FILE | 'ssh-ed25519 AAAA... comment' | --revoke PUBKEY-FILE|KEY|COMMENT"
akf=${ARCHCI_AUTHORIZED_KEYS:-/etc/archci/authorized_keys}
keyre='^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp[0-9]+|sk-[a-z0-9-]+@openssh.com) [A-Za-z0-9+/=]+'

# revoke WHAT: drop the lines holding that key, or whose comment is WHAT
revoke() {
	local what=$1 blob='' kept=() n=0 l
	[[ -f $what ]] && what=$(<"$what")
	[[ -f $akf ]] || archci_die "nothing is authorized yet ($akf)"
	[[ $what =~ $keyre ]] && blob=${BASH_REMATCH[0]}
	while IFS= read -r l; do
		if [[ -n $blob && $l == *" $blob"* ]] || [[ -z $blob && $l == *" $what" ]]; then
			(( ++n ))
		else
			kept+=("$l")
		fi
	done <"$akf"
	(( n > 0 )) || archci_die "no authorized key matches: $what"
	: >"$akf.tmp"
	(( ${#kept[@]} )) && printf '%s\n' "${kept[@]}" >"$akf.tmp"
	mv "$akf.tmp" "$akf"
	chmod 644 "$akf"
	archci_log "revoked $n key(s): ${what##* }"
}

if [[ ${1:-} == --revoke ]]; then
	[[ -n ${2:-} ]] || archci_die "$usage"
	revoke "$2"
	exit 0
fi

key=${1:-}
[[ -n $key ]] || archci_die "$usage"
[[ -f $key ]] && key=$(<"$key")
[[ $key =~ $keyre ]] || archci_die "that does not look like a public key"

install -d -m 755 "${akf%/*}"
# Keys authorized before this file existed live in the archci user's own
# ~/.ssh/authorized_keys (not root's to guard); carry them over once.
old=$ARCHCI_HOME/.ssh/authorized_keys
if [[ ! -e $akf && -f $old ]]; then
	install -m 644 "$old" "$akf"
	mv "$old" "$old.migrated"
	archci_log "moved the keys from $old to $akf"
fi
[[ -e $akf ]] || : >"$akf"
line=$(printf 'command="%s",restrict,port-forwarding,permitopen="127.0.0.1:19533" %s' "$ARCHCI_MASTER_DIR/archci-shell" "$key")
if grep -qxF "$line" "$akf"; then
	archci_log "key already authorized"
elif grep -qF "${BASH_REMATCH[0]}" "$akf"; then
	grep -vF "${BASH_REMATCH[0]}" "$akf" >"$akf.tmp" || true
	printf '%s\n' "$line" >>"$akf.tmp"
	mv "$akf.tmp" "$akf"
	archci_log "updated: ${key##* }"
else
	printf '%s\n' "$line" >>"$akf"
	archci_log "authorized: ${key##* }"
fi
chmod 644 "$akf"
if [[ -z ${ARCHCI_AUTHORIZED_KEYS:-} && ! -f /etc/ssh/sshd_config.d/60-archci.conf ]]; then
	archci_log "WARNING: sshd does not read $akf yet: install ssh/sshd_config.d/60-archci.conf to /etc/ssh/sshd_config.d/ and reload sshd"
fi
