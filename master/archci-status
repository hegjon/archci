#!/usr/bin/env ruby
# frozen_string_literal: true

# archci-status [--json] -- what the master is doing right now (Archci.snapshot,
# which archci-top draws from as well).
require_relative '../lib/archci-frame'

report = Archci.snapshot

if ARGV.include?('--json')
  puts JSON.pretty_generate(report)
  exit
end

puts frame(nil, report, live: false)
recent = report['recent'].first(10)
unless recent.empty?
  puts
  puts bold(format('%-34s %-7s  %-17s  %s', 'DONE (newest first)', 'ARCH', 'WORKER', 'FINISHED'))
  recent.each do |j|
    puts format('%-34s %-7s  %-17s  %s', "#{j['pkgbase']} #{j['version']}"[0, 34], j['arch'], short_worker(j['worker']), j['finished'])
  end
end
