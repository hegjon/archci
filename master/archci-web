#!/usr/bin/env ruby
# frozen_string_literal: true

# archci-web snapshot | log ID -- what a web front end reads of the master,
# as JSON on stdout:
#   snapshot   the farm as archci top shows it (Archci.snapshot: queue, hosts,
#              running and failed jobs, the signer) plus "jobs": every job
#              the master holds, pending to failed, with its state, origin,
#              story and log path, and "generated"
#   job ID     one job's fields, story, origin and log path (JSON), with the
#              pacman repo and the time -- what the job page needs, without
#              the whole snapshot. For a build that used a source package,
#              "sources_job" is the id of the src job that produced it.
#   log ID     one job's log: {"id", "state", "lines": [...], "error_at": N}
#              (null without an error), the archived log of a finished job,
#              the last lines of the journal a running one streams
#   follow ID  a running job's journal, live: its last lines and then each
#              new one as it arrives (journalctl -f on the workers' streamed
#              journals), plain text, until the job is no longer running or
#              the reader goes away
# These are the read side of the web key (archci authorize --web): a front end
# on its own host runs them over ssh, where archci-shell web allows them, and
# archci-job's retry, requeue and enqueue. Safe to run by hand.

require_relative '../lib/archci'
require 'json'
require 'time'

def plain(j)
  j.merge('mtime' => j['mtime'].utc.iso8601, 'story' => Archci.story(j))
end

case ARGV
in ['snapshot']
  now = Time.now
  snap = Archci.snapshot(now)
  puts JSON.generate(snap.merge('generated' => now.utc.iso8601, 'jobs' => Archci.all_jobs.map { |j| plain(j) }))
in ['job', id]
  j = Archci.find_job(id) or abort "archci-web: no job #{id}"
  extra = { 'mtime' => j['mtime'].utc.iso8601, 'story' => Archci.story(j), 'repo' => j['repo'], 'generated' => Time.now.utc.iso8601 }
  # the src job that built this build's source package, so the front end can link it
  extra['sources_job'] = Archci.find_src_job(j['repo'], j['pkgbase'], j['version']) if j['sources'] && j['arch'] != 'src'
  puts JSON.generate(j.merge(extra))
in ['log', id]
  j = Archci.find_job(id) or abort "archci-web: no job #{id}"
  lines, err = Archci.read_log(j)
  puts JSON.generate('id' => j['id'], 'state' => j['state'], 'lines' => lines, 'error_at' => err)
in ['follow', id]
  j = Archci.find_job(id) or abort "archci-web: no job #{id}"
  abort "archci-web: #{id} is not running" unless j['state'] == 'running'
  journal = Archci.config['ARCHCI_REMOTE_JOURNAL']
  running = File.join(Archci.queue('running'), "#{id}.job")
  $stdout.sync = true
  # journalctl -f prints the last lines, then each new one; we forward them
  # and stop when the job leaves running/ (reported, requeued), journalctl
  # ends, or the reader goes away -- a write then fails (EPIPE), because the
  # ssh channel to the front end is our stdout. journalctl is killed with us.
  io = IO.popen(['journalctl', '-D', journal, '--no-pager', '-a', '-o', 'cat', '-f', '-n', '400', *Archci.journal_matches(j)], err: File::NULL)
  begin
    loop do
      break unless File.exist?(running)
      ready, = IO.select([io], nil, nil, 2)
      next unless ready

      $stdout.puts(io.readline.chomp)
    end
  rescue EOFError, Errno::EPIPE
    nil
  ensure
    Process.kill('TERM', io.pid) rescue nil # rubocop:disable Style/RescueModifier
    io.close rescue nil # rubocop:disable Style/RescueModifier
  end
else
  abort 'usage: archci-web snapshot | job ID | log ID | follow ID'
end
