#!/usr/bin/env ruby
# frozen_string_literal: true

# archci-web snapshot | log ID -- what a web front end reads of the master,
# as JSON on stdout:
#   snapshot   the farm as archci top shows it (Archci.snapshot: queue, hosts,
#              running and failed jobs, the signer) plus "jobs": every job
#              the master holds, pending to failed, with its state, origin,
#              story and log path, and "generated"
#   job ID     one job's fields, story, origin and log path (JSON), with the
#              pacman repo and the time -- what the job page needs, without
#              the whole snapshot. "started" is a running build's claim time;
#              a finished build's times come from its log, in the browser.
#              For a build that used a source package, "sources_job" is the id
#              of the src job that produced it. "pkgbuilds" and
#              "pkgbuilds_dir" name the PKGBUILD repository and the directory
#              in it (ARCHCI_PKGBUILDS_URL, _DIR), for a link to the commit.
#   log ID [CURSOR]
#              one job's log: {"id", "state", "lines": [...], "error_at": N
#              (null without an error), "cursor"}. The job's entries in the
#              workers' journal on the master (Archci.read_log): the whole
#              log, or, for a running job, only what follows CURSOR (the
#              "cursor" a previous call returned), so a poll fetches just the
#              new lines.
#   entries ID [CURSOR]
#              one job's log as journal entries, for a browser to build the
#              log window from: {"id", "state", "entries": [{"__CURSOR":
#              the entry's own, "__REALTIME_TIMESTAMP": when the line was
#              written (microseconds since the epoch), "__MONOTONIC_TIMESTAMP",
#              "_SOURCE_REALTIME_TIMESTAMP" (when the sender stamped it),
#              "MESSAGE": the line,
#              "PRIORITY": syslog's (stdout 6, stderr 3), "phase": "online" |
#              "offline" | "loopback" on a slice marker
#              line}, ...], "error_at": N (null without an error), "cursor"}
#              (Archci.read_entries). Whole, or after CURSOR for a running
#              job, as `log`; the cursor is the last entry's.
#   sse ID [CURSOR]
#              the same log as a stream of server-sent events (Archci.sse_*):
#              "event: job" with the job's fields and story (only without a
#              CURSOR), one event per entry with its journal cursor as the
#              event id, and "event: end" once the job has finished. What a
#              front end pipes to a browser's EventSource for a running job,
#              and byte for byte what archci-publish exports to R2 for a
#              finished one (a client reads either with one parser).
#   export DIR [SETTLE]
#              the logs of the jobs finished since the last export, as
#              <pkgbase>-<version>-<arch>-<start>-<invocation>.sse.gz under
#              DIR/<repo>/<pkgbase>/<version>/<arch>/ (Archci.export_logs;
#              archci-publish runs it on logs/ and moves that to R2 as
#              <repo>/log/); prints how many. A log the journal has not
#              finished is exported as it stands SETTLE seconds (600) after
#              the report
#   summary ID one job's log in two lines for its job file, "error=<first
#              error line>" and "last=<last line>", each only if there is
#              one (archci-job report keeps them so listings need not read
#              the journal)
# These are the read side of the web key (archci authorize --web): a front end
# on its own host runs them over ssh, where archci-shell web allows them, and
# archci-job's retry, requeue and enqueue. A running job's log is polled with
# `log` (journalctl -f cannot follow a journald-remote journal). Safe to run
# by hand.

require_relative '../lib/archci'
require 'json'
require 'time'

def plain(j)
  j.merge('mtime' => j['mtime'].utc.iso8601, 'story' => Archci.story(j))
end

case ARGV
in ['snapshot']
  now = Time.now
  snap = Archci.snapshot(now)
  puts JSON.generate(snap.merge('generated' => now.utc.iso8601, 'jobs' => Archci.all_jobs.map { |j| plain(j) }))
in ['job', id]
  j = Archci.find_job(id) or abort "archci-web: no job #{id}"
  # no journal read here: a finished build's time and its phases are the
  # browser's to work out from the log stream it shows (each entry's time,
  # the slice markers, the finish record); a running one counts from its claim
  extra = { 'mtime' => j['mtime'].utc.iso8601, 'story' => Archci.story(j), 'repo' => j['repo'], 'generated' => Time.now.utc.iso8601,
            'started' => (j['claimed'] if j['state'] == 'running'),
            'pkgbuilds' => Archci.config['ARCHCI_PKGBUILDS_URL'], 'pkgbuilds_dir' => Archci.config['ARCHCI_PKGBUILDS_DIR'] }
  # the src job that built this build's source package, so the front end can link it
  extra['sources_job'] = Archci.find_src_job(j['repo'], j['pkgbase'], j['version']) if j['sources'] && j['arch'] != 'src'
  puts JSON.generate(j.merge(extra))
in ['log', id, *rest]
  j = Archci.find_job(id) or abort "archci-web: no job #{id}"
  lines, err, cursor = Archci.read_log(j, after: rest.first)
  puts JSON.generate('id' => j['id'], 'state' => j['state'], 'lines' => lines, 'error_at' => err, 'cursor' => cursor)
in ['entries', id, *rest]
  j = Archci.find_job(id) or abort "archci-web: no job #{id}"
  entries, err, cursor = Archci.read_entries(j, after: rest.first)
  puts JSON.generate('id' => j['id'], 'state' => j['state'], 'entries' => entries, 'error_at' => err, 'cursor' => cursor)
in ['sse', id, *rest]
  j = Archci.find_job(id) or abort "archci-web: no job #{id}"
  Archci.write_sse(j, $stdout, after: rest.first)
in ['export', dir, *settle]
  puts Archci.export_logs(dir, settle_after: (settle.first || 600).to_i)
in ['summary', id]
  j = Archci.find_job(id) or abort "archci-web: no job #{id}"
  lines, err, = Archci.read_log(j)
  # one line each, the job file's format (a key=value line): no newlines, cut short
  { 'error' => err && lines[err], 'last' => lines.last }.each { |k, v| puts "#{k}=#{v.strip[0, 200]}" if v && !v.strip.empty? }
else
  abort 'usage: archci-web snapshot | job ID | log ID [CURSOR] | entries ID [CURSOR] | sse ID [CURSOR] | export DIR | summary ID'
end
