#!/usr/bin/env ruby
# frozen_string_literal: true

# archci-web snapshot | log ID -- what a web front end reads of the master,
# as JSON on stdout:
#   snapshot   the farm as archci top shows it (Archci.snapshot: queue, hosts,
#              running and failed jobs, the signer) plus "jobs": every job
#              the master holds, pending to failed, with its state, origin,
#              story and log path, and "generated"
#   job ID     one job's fields, story, origin and log path (JSON), with the
#              pacman repo and the time -- what the job page needs, without
#              the whole snapshot. "started"/"stopped" are the build's stable
#              start and stop (Archci.build_span, from the log), for a query.
#              For a build that used a source package, "sources_job" is the id
#              of the src job that produced it.
#   log ID [CURSOR]
#              one job's log: {"id", "state", "lines": [...], "error_at": N
#              (null without an error), "cursor"}. The archived log of a
#              finished job; the journal a running one streams -- the whole
#              journal so far, or only what follows CURSOR (the "cursor" a
#              previous call returned), so a poll fetches just the new lines.
# These are the read side of the web key (archci authorize --web): a front end
# on its own host runs them over ssh, where archci-shell web allows them, and
# archci-job's retry, requeue and enqueue. A running job's log is polled with
# `log` (journalctl -f cannot follow a journald-remote journal). Safe to run
# by hand.

require_relative '../lib/archci'
require 'json'
require 'time'

def plain(j)
  j.merge('mtime' => j['mtime'].utc.iso8601, 'story' => Archci.story(j))
end

case ARGV
in ['snapshot']
  now = Time.now
  snap = Archci.snapshot(now)
  puts JSON.generate(snap.merge('generated' => now.utc.iso8601, 'jobs' => Archci.all_jobs.map { |j| plain(j) }))
in ['job', id]
  j = Archci.find_job(id) or abort "archci-web: no job #{id}"
  started, stopped = Archci.build_span(j)
  extra = { 'mtime' => j['mtime'].utc.iso8601, 'story' => Archci.story(j), 'repo' => j['repo'], 'generated' => Time.now.utc.iso8601,
            'started' => started, 'stopped' => stopped }
  # the src job that built this build's source package, so the front end can link it
  extra['sources_job'] = Archci.find_src_job(j['repo'], j['pkgbase'], j['version']) if j['sources'] && j['arch'] != 'src'
  puts JSON.generate(j.merge(extra))
in ['log', id, *rest]
  j = Archci.find_job(id) or abort "archci-web: no job #{id}"
  lines, err, cursor = Archci.read_log(j, after: rest.first)
  puts JSON.generate('id' => j['id'], 'state' => j['state'], 'lines' => lines, 'error_at' => err, 'cursor' => cursor)
else
  abort 'usage: archci-web snapshot | job ID | log ID [CURSOR]'
end
