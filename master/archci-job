#!/bin/bash
# archci-job -- master-side queue operations (runs as the archci user).
#
#   claim WORKER              hand the next job to WORKER and print it: the first
#                             pending file, else the next outstanding package
#                             (archci-next), chosen just in time
#   heartbeat ID              mark a running job as still alive
#   report ID STATUS          finish a job: success | failure | abandoned
#                             (results are expected in incoming/ID/)
#   requeue ID                move a running/failed job back to pending
#   retry ID                  reset the attempt counter and requeue
#   enqueue REPO PKGBASE [P]  queue the currently released version, priority P (default 0)
#   reap                      requeue stale running jobs and due retries, prune done/
#
# Jobs are files; moving them between queue/{pending,running,done,failed} is
# the whole state machine. The backlog is never stored: pending/ only holds
# manual enqueues and retries. Everything that touches the queue takes queue.lock.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

lock_queue() {
	exec 9>"$ARCHCI_HOME/lock/queue.lock"
	flock 9
}

# Move FILE to DIR, dropping bookkeeping fields and appending EXTRA lines.
rewrite_job() {
	local file=$1 dest=$2 tmp
	shift 2
	tmp=$dest.tmp
	{
		grep -Ev '^(worker|claimed|status|finished|final)=' "$file"
		printf '%s\n' "$@"
	} >"$tmp"
	mv "$tmp" "$dest"
	[[ $file == "$dest" ]] || rm -f "$file"
}

set_attempt() {  # set_attempt FILE N  (in place)
	local file=$1 n=$2 tmp=$1.tmp
	{ grep -v '^attempt=' "$file"; printf 'attempt=%d\n' "$n"; } >"$tmp"
	mv "$tmp" "$file"
}

requeue_file() {  # requeue_file FILE  (lock held)
	local file=$1 name=${1##*/}
	rewrite_job "$file" "$Q_PENDING/$name"
	rm -rf "${ARCHCI_HOME:?}/incoming/${name%.job}"
}

# write_job DEST PRIO REPO PKGBASE VERSION TAG COMMIT -> prints the file name
write_job() {
	local dest=$1 prio=$2 repo=$3 pkgbase=$4 version=$5 tag=$6 commit=$7 id
	id="$prio-$(date +%s)-$repo,$pkgbase,$version"
	archci_valid_id "$id" || archci_die "cannot form a valid job id for $repo/$pkgbase $version"
	cat >"$dest/$id.job.tmp" <<-JOB
		id=$id
		repo=$repo
		arch=$ARCHCI_ARCH
		pkgbase=$pkgbase
		version=$version
		tag=$tag
		commit=$commit
		attempt=0
		created=$(archci_now)
	JOB
	mv "$dest/$id.job.tmp" "$dest/$id.job"
	printf '%s\n' "$id.job"
}

find_job() {  # find_job ID DIR... -> path
	local id=$1 d
	shift
	for d in "$@"; do
		[[ -f $d/$id.job ]] && { printf '%s\n' "$d/$id.job"; return 0; }
	done
	return 1
}

# ---------------------------------------------------------------------------
cmd_claim() {
	local worker=$1 name
	archci_valid_worker "$worker" || archci_die "invalid worker id: $worker"
	lock_queue
	name=$(cd "$Q_PENDING" && LC_ALL=C ls -1 2>/dev/null | grep '\.job$' | sort | head -n1 || true)
	if [[ -z $name ]]; then
		# Nothing queued by hand or for retry: pick the next outstanding package now.
		local prio repo pkgbase version tag commit
		read -r prio repo pkgbase version tag commit < <("$ARCHCI_MASTER_DIR/archci-next") || true
		[[ -n ${commit:-} ]] || exit 0
		name=$(write_job "$Q_PENDING" "$prio" "$repo" "$pkgbase" "$version" "$tag" "$commit")
	fi
	mv "$Q_PENDING/$name" "$Q_RUNNING/$name"
	archci_read_job "$Q_RUNNING/$name" || archci_die "corrupt job file $name"
	rewrite_job "$Q_RUNNING/$name" "$Q_RUNNING/$name" \
		"worker=$worker" "claimed=$(archci_now)"
	set_attempt "$Q_RUNNING/$name" $((job_attempt + 1))
	mkdir -p "$ARCHCI_HOME/incoming/${name%.job}"
	archci_log "claim ${name%.job} -> $worker (attempt $((job_attempt + 1)))"
	cat "$Q_RUNNING/$name"
}

cmd_heartbeat() {
	local id=$1
	archci_valid_id "$id" || archci_die "invalid job id"
	[[ -f $Q_RUNNING/$id.job ]] || archci_die "job $id is not running"
	touch "$Q_RUNNING/$id.job"
}

# Pool built packages and record what was built. The master holds no key and
# does not build the database; the signer does, from released (signed)
# packages (see README "Signing"). Each package keeps its builder signature
# (.buildsig) alongside for the signer to verify, then archci-stage moves both
# to the R2 staging area.
ingest() {
	local id=$1 inc=$2 p
	shopt -s nullglob
	local pkgs=("$inc"/*.pkg.tar.zst)
	shopt -u nullglob
	if (( ${#pkgs[@]} == 0 )); then
		archci_log "$id: reported success but uploaded no packages"
		return 1
	fi
	(
		exec 8>"$ARCHCI_HOME/lock/repo.lock"
		flock 8
		for p in "${pkgs[@]}"; do
			local base=${p##*/} dir
			if [[ $base == *-debug-"$job_version"-*.pkg.tar.zst ]]; then
				dir=$ARCHCI_HOME/repo/$job_repo-debug/os/$job_arch
			else
				dir=$ARCHCI_HOME/repo/$job_repo/os/$job_arch
			fi
			mkdir -p "$dir"
			mv "$p" "$dir/$base" || exit 1
			# builder signature travels with the package; the signer verifies it
			if [[ -f $p.buildsig ]]; then mv "$p.buildsig" "$dir/$base.buildsig"; fi
		done
	) || return 1
	mkdir -p "$ARCHCI_HOME/built/$job_repo-$job_arch"
	printf '%s %s\n' "$job_version" "$job_commit" >"$ARCHCI_HOME/built/$job_repo-$job_arch/$job_pkgbase"
	touch "$ARCHCI_HOME/stage.needed"
	archci_log "$id: pooled ${#pkgs[@]} package(s) for [$job_repo]"
}

cmd_report() {
	local id=$1 status=$2 file inc logdir
	archci_valid_id "$id" || archci_die "invalid job id"
	[[ $status == success || $status == failure || $status == abandoned ]] || archci_die "bad status: $status"
	lock_queue
	file=$Q_RUNNING/$id.job
	[[ -f $file ]] || archci_die "job $id is not running (reaped or already reported)"
	archci_read_job "$file"
	inc=$ARCHCI_HOME/incoming/$id

	if [[ $status == abandoned ]]; then
		# Worker was shut down mid-build; do not count it as an attempt.
		set_attempt "$file" $((job_attempt - 1))
		requeue_file "$file"
		archci_log "$id abandoned by $job_worker, requeued"
		return 0
	fi

	logdir=$ARCHCI_HOME/logs/$job_repo/$job_pkgbase/$job_version
	mkdir -p "$logdir"
	[[ -f $inc/build.log ]] && mv "$inc/build.log" "$logdir/attempt-$job_attempt.log"

	if [[ $status == success ]] && ! ingest "$id" "$inc"; then
		status=failure
	fi
	if [[ $status == success ]]; then
		rewrite_job "$file" "$Q_DONE/$id.job" "worker=$job_worker" "status=success" "finished=$(archci_now)"
		archci_log "$id succeeded on $job_worker"
	elif (( job_attempt >= ARCHCI_MAX_ATTEMPTS )); then
		rewrite_job "$file" "$Q_FAILED/$id.job" "worker=$job_worker" "status=failure" "finished=$(archci_now)" "final=1"
		archci_log "$id failed on $job_worker, attempt $job_attempt/$ARCHCI_MAX_ATTEMPTS, giving up"
	else
		rewrite_job "$file" "$Q_FAILED/$id.job" "worker=$job_worker" "status=failure" "finished=$(archci_now)"
		archci_log "$id failed on $job_worker, attempt $job_attempt/$ARCHCI_MAX_ATTEMPTS, will retry"
	fi
	rm -rf "$inc"
}

cmd_requeue() {
	local id=$1 file
	archci_valid_id "$id" || archci_die "invalid job id"
	lock_queue
	file=$(find_job "$id" "$Q_RUNNING" "$Q_FAILED") || archci_die "job $id is not running or failed"
	requeue_file "$file"
	archci_log "$id requeued"
}

cmd_retry() {
	local id=$1 file
	archci_valid_id "$id" || archci_die "invalid job id"
	lock_queue
	file=$(find_job "$id" "$Q_RUNNING" "$Q_FAILED") || archci_die "job $id is not running or failed"
	set_attempt "$file" 0
	requeue_file "$file"
	archci_log "$id retried from scratch"
}

cmd_enqueue() {
	local repo=$1 pkgbase=$2 prio=${3:-0} statefile name version tag commit old
	statefile=$ARCHCI_HOME/state/$repo-$ARCHCI_ARCH/$pkgbase
	[[ -f $statefile ]] || archci_die "no state entry $repo-$ARCHCI_ARCH/$pkgbase (run archci-scan first?)"
	read -r name version tag commit <"$statefile"
	[[ $name == "$pkgbase" && -n $commit ]] || archci_die "unexpected state line in $statefile"
	lock_queue
	for old in "$Q_PENDING"/*-"$repo,$pkgbase,"*.job; do
		[[ -e $old ]] && rm -f "$old"
	done
	name=$(write_job "$Q_PENDING" "$prio" "$repo" "$pkgbase" "$version" "$tag" "$commit")
	archci_log "enqueued ${name%.job}"
}

cmd_reap() {
	local now file age commit n=0
	now=$(date +%s)
	lock_queue
	shopt -s nullglob
	for file in "$Q_RUNNING"/*.job; do
		age=$(( now - $(stat -c %Y "$file") ))
		(( age >= ARCHCI_STALE_MINUTES * 60 )) || continue
		archci_read_job "$file" || continue
		archci_log "$job_id: no heartbeat from $job_worker for $((age / 60)) min, requeueing"
		requeue_file "$file"
		(( ++n ))
	done
	# A newer release supersedes queued and failed jobs; claim picks the new commit up.
	for file in "$Q_PENDING"/*.job "$Q_FAILED"/*.job; do
		archci_read_job "$file" || continue
		[[ -f $ARCHCI_HOME/state/$job_repo-$job_arch/$job_pkgbase ]] || continue
		read -r _ _ _ commit <"$ARCHCI_HOME/state/$job_repo-$job_arch/$job_pkgbase"
		if [[ -n $commit && $commit != "$job_commit" ]]; then
			archci_log "$job_id: superseded by commit ${commit:0:12}, dropping"
			rm -f "$file"
		fi
	done
	for file in "$Q_FAILED"/*.job; do
		archci_read_job "$file" || continue
		(( job_attempt < ARCHCI_MAX_ATTEMPTS )) || continue
		age=$(( now - $(stat -c %Y "$file") ))
		(( age >= ARCHCI_RETRY_MINUTES * 60 )) || continue
		archci_log "$job_id: retrying (attempt $job_attempt/$ARCHCI_MAX_ATTEMPTS)"
		requeue_file "$file"
		(( ++n ))
	done
	shopt -u nullglob
	find "$Q_DONE" -name '*.job' -mtime +"$ARCHCI_DONE_KEEP_DAYS" -delete
	(( n == 0 )) || archci_log "requeued $n job(s)"
}

# ---------------------------------------------------------------------------
cmd=${1:-}
shift || true
case $cmd in
	claim)     (( $# == 1 )) || archci_die "usage: archci-job claim WORKER";        cmd_claim "$1" ;;
	heartbeat) (( $# == 1 )) || archci_die "usage: archci-job heartbeat ID";        cmd_heartbeat "$1" ;;
	report)    (( $# == 2 )) || archci_die "usage: archci-job report ID STATUS";    cmd_report "$1" "$2" ;;
	requeue)   (( $# == 1 )) || archci_die "usage: archci-job requeue ID";          cmd_requeue "$1" ;;
	retry)     (( $# == 1 )) || archci_die "usage: archci-job retry ID";            cmd_retry "$1" ;;
	enqueue)   (( $# >= 2 )) || archci_die "usage: archci-job enqueue REPO PKGBASE [PRIO]"; cmd_enqueue "$@" ;;
	reap)      cmd_reap ;;
	*) sed -n '2,13p' "$0" >&2; exit 2 ;;
esac
