#!/bin/bash
# archci-job -- master-side queue operations (runs as the archci user).
#
#   claim WORKER ARCH [K=V...]
#                             hand the next job to WORKER (building ARCH) and
#                             print it: the first pending file
#                             the worker can build, else the next outstanding
#                             package (archci-next ARCH), chosen just in time.
#                             The host stats sent along (ARCHCI_HOST_STATS) are
#                             kept in hosts/WORKER: the host as last polled,
#                             for the UIs while the worker is idle. ARCH src
#                             is the sourcer's: a job to fetch a package's
#                             sources into a source package
#   heartbeat ID worker=ID [K=V...]
#                             mark a running job as still alive, from its
#                             worker (refused from any other: the job was
#                             requeued and claimed elsewhere); the worker's
#                             host stats (ARCHCI_HOST_STATS) and the job's
#                             (ARCHCI_JOB_STATS) are kept with the job
#   report ID STATUS WORKER   finish a job: success | failure | abandoned,
#                             from WORKER (refused when the job is another
#                             worker's now)
#                             (results are expected in incoming/ID/: the
#                             packages and their .buildsig; for a src job the
#                             source package and its .buildsig, pooled under
#                             <repo>/os/src for the signer like a package,
#                             and the built record names it to the package's
#                             build claims. The log is not among them: it is
#                             the job's entries in the workers' journal on
#                             the master; the report keeps its first error
#                             line and its last in the job file)
#   requeue ID                move a running/failed job back to pending
#   reexport ID | --none | --all
#                             drop a finished job's exported= mark (the id's,
#                             every job marked none, or every finished job),
#                             so archci-export exports its log again
#   retry ID | -a|--all       a new job for the failed job's package and arch,
#                             at the package's current version, commit and
#                             network flag, with a fresh id and attempt 0; the
#                             failed job's file goes (its logs stay on the
#                             release under its id). Prints the new id. --all:
#                             every failed job (final ones included)
#   enqueue PKGBASE [P] [ARCH]
#                             queue the package's current version (from the
#                             PKGBUILD repository clone), priority P (default
#                             0), for ARCH (default ARCHCI_ARCH; "any" for an
#                             arch-independent package; "src" for its sources).
#                             A package outside the filter (ARCHCI_PKG_SOURCES,
#                             ARCHCI_PKG_REPOS) is queued but waits: the claim
#                             applies the filter to queued jobs too
#
# The queue itself (files under queue/, moved between pending, running, done
# and failed) is lib/archci-queue.sh; its periodic pass, requeueing stale
# and due jobs, is master/archci-housekeeping (a timer, not a
# command).
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-queue.sh"

# ---------------------------------------------------------------------------
# record_poll WORKER ARCH [K=V...] -- hosts/WORKER: the host as last heard
# from, with the stats it sent (ARCHCI_HOST_STATS), for the UIs
record_poll() {
	local worker=$1 warch=$2 stat hostre
	shift 2
	hostre=${ARCHCI_HOST_STATS// /|}
	for stat in "$@"; do
		[[ $stat =~ ^($hostre)=[A-Za-z0-9./-]{1,32}$ ]] || archci_die "bad host stat: $stat"
	done
	mkdir -p "$ARCHCI_HOME/hosts"
	{ printf 'worker=%s\narch=%s\nseen=%s\n' "$worker" "$warch" "$(archci_now)"; printf '%s\n' "$@"; } >"$ARCHCI_HOME/hosts/$worker.tmp"
	mv "$ARCHCI_HOME/hosts/$worker.tmp" "$ARCHCI_HOME/hosts/$worker"
}

# source_package_for REPO PKGBASE COMMIT -> the source package the sourcer
# made for the package at this commit, once the signer has released it
# (archci-publish's listing; without one, once it has been out
# ARCHCI_RELEASE_LAG_MINUTES); nothing otherwise
source_package_for() {
	local rec=$ARCHCI_HOME/built/$1-src/$2 listing=$ARCHCI_HOME/released/$1-src v c f
	[[ -f $rec ]] || return 0
	read -r v c f <"$rec"
	[[ $c == "$3" && -n $f ]] || return 0
	if [[ -f $listing ]]; then grep -qxF "$f" "$listing" && printf '%s\n' "$f"
	elif (( $(date +%s) - $(stat -c %Y "$rec") >= ARCHCI_RELEASE_LAG_MINUTES * 60 )); then printf '%s\n' "$f"
	fi
	return 0
}

cmd_claim() {
	local worker=$1 warch=$2
	shift 2
	archci_valid_worker "$worker" || archci_die "invalid worker id: $worker"
	archci_valid_arch "$warch" || archci_die "invalid arch: $warch"
	archci_enabled_arch "$warch" || archci_die "arch $warch is not enabled on this master (ARCHCI_ARCHES=\"$ARCHCI_ARCHES\")"
	# the lanes this instance takes (lanes=fast,heavy among the claim's words;
	# every lane for a worker that says nothing, from before lanes existed)
	local lanes="normal fast heavy" stats=() w
	for w in "$@"; do
		if [[ $w == lanes=* ]]; then
			[[ ${w#lanes=} =~ ^[a-z,]{1,40}$ ]] || archci_die "bad lanes: $w"
			lanes=${w#lanes=}; lanes=${lanes//,/ }
		else stats+=("$w"); fi
	done
	(( ${#stats[@]} )) && record_poll "$worker" "$warch" "${stats[@]}"
	lock_queue
	# a host builds at most ARCHCI_HEAVY_PER_HOST heavy packages at a time:
	# with that many running on this worker's host, no heavy job for this claim
	if [[ " $lanes " == *" heavy "* ]]; then
		local host heavy=0 r
		host=$(archci_worker_host "$worker")
		shopt -s nullglob
		for r in "$Q_RUNNING"/*.job; do
			archci_read_job "$r" || continue
			[[ $(archci_worker_host "$job_worker") == "$host" && $(archci_lane "$job_pkgbase") == heavy ]] && heavy=$((heavy + 1))
		done
		shopt -u nullglob
		(( heavy >= ARCHCI_HEAVY_PER_HOST )) && lanes=${lanes// heavy/}
	fi
	lanes=${lanes# }
	# A worker runs one job at a time, so a claim while one of its jobs is
	# still running means that job died with the worker's previous process
	# (a restart between this master's answer and the worker reading it).
	# Hand it back without counting the attempt, as for an abandoned job.
	local orphan
	shopt -s nullglob
	for orphan in "$Q_RUNNING"/*.job; do
		archci_read_job "$orphan" || continue
		[[ $job_worker == "$worker" ]] || continue
		archci_log "$job_id: still running for $worker, which asks for new work; requeued"
		set_attempt "$orphan" $((job_attempt - 1))
		requeue_file "$orphan"
	done
	shopt -u nullglob
	local name='' pend p
	local LC_ALL=C                       # deterministic, ASCII filename order
	shopt -s nullglob; pend=("$Q_PENDING"/*.job); shopt -u nullglob
	# The first pending job this worker's arch can build (its own arch, or "any"
	# if it is the any arch) of a package the farm builds (a retry of one a
	# filter has since excluded waits in pending/ until the filter is lifted),
	# and, with ARCHCI_SOURCES_REQUIRED, whose source package is released
	# (a build waits for it in pending/ as it would among the outstanding).
	for p in "${pend[@]}"; do
		archci_read_job "$p" || continue
		archci_can_build "$warch" "$job_arch" || continue
		archci_pkg_wanted "$job_pkgbase" || continue
		[[ " $lanes " == *" $(archci_lane "$job_pkgbase") "* ]] || continue
		if [[ $ARCHCI_SOURCES_REQUIRED == 1 && $job_arch != src ]]; then
			[[ -n $(source_package_for "$job_repo" "$job_pkgbase" "$job_commit") ]] || continue
		fi
		name=${p##*/}; break
	done
	if [[ -z $name ]]; then
		# Nothing queued by hand or for retry: pick the next outstanding package now.
		local prio repo arch pkgbase version commit profile flags
		read -r prio repo arch pkgbase version commit profile flags < <("$ARCHCI_MASTER_DIR/archci-next" "$warch" "${lanes// /,}") || true
		[[ -n ${commit:-} ]] || exit 0
		name=$(write_job "$Q_PENDING" "$prio" "$repo" "$arch" "$pkgbase" "$version" "$commit" "$profile" "${flags:-}")
	fi
	mv "$Q_PENDING/$name" "$Q_RUNNING/$name"
	archci_read_job "$Q_RUNNING/$name" || archci_die "corrupt job file $name"
	# the source package the sourcer made for this commit, once the signer
	# has released it: the worker builds from it instead of fetching upstream
	local srcpkg=''
	[[ $job_arch == src ]] || srcpkg=$(source_package_for "$job_repo" "$job_pkgbase" "$job_commit")
	# (lane: the worker's build weights, archci-build; a fact of the master's
	# configuration, rewritten at each claim)
	rewrite_job "$Q_RUNNING/$name" "$Q_RUNNING/$name" \
		"worker=$worker" "claimed=$(archci_now)" "lane=$(archci_lane "$job_pkgbase")" ${srcpkg:+"sources=$srcpkg"}
	set_attempt "$Q_RUNNING/$name" $((job_attempt + 1))
	mkdir -p "$ARCHCI_HOME/incoming/${name%.job}"
	archci_log "claim ${name%.job} -> $worker (attempt $((job_attempt + 1)))"
	cat "$Q_RUNNING/$name"
}

cmd_heartbeat() {
	local id=$1 file stat
	shift
	archci_valid_id "$id" || archci_die "invalid job id"
	file=$Q_RUNNING/$id.job
	[[ -f $file ]] || archci_die "job $id is not running"
	local stats=() sender=''
	for stat in "$@"; do
		if [[ $stat == worker=* ]]; then sender=${stat#worker=}; continue; fi
		[[ $stat =~ ^($(archci_stats_re))=[A-Za-z0-9./-]{1,32}$ ]] || archci_die "bad heartbeat stat: $stat"
		stats+=("$stat")
	done
	set -- "${stats[@]}"
	[[ -n $sender ]] || archci_die "a heartbeat names its worker (worker=ID)"
	archci_read_job "$file"
	[[ $sender == "$job_worker" ]] || archci_die "job $id is $job_worker's now, not $sender's"
	# each beat's stats as a stream of its own, apart from the operational log:
	# `journalctl -t archci-heartbeat` (a history the running job file, which
	# keeps only the latest beat, does not retain)
	(( $# )) && command -v logger >/dev/null && logger -t archci-heartbeat -- "$id worker=$sender $*" 2>/dev/null || true
	if (( $# )); then
		# a beat replaces the stats it carries and leaves the rest: the last
		# beats of a build (the upload, the container gone) come without the
		# job's rss/peak/build, and a finished job keeps the last ones seen
		local keys=() key
		for stat in "$@"; do key=${stat%%=*}; keys+=("$key"); done
		{ grep -Ev "^($(IFS='|'; printf '%s' "${keys[*]}"))=" "$file"; printf '%s\n' "$@"; } >"$file.tmp"
		mv "$file.tmp" "$file"   # the new mtime is the heartbeat
	else
		touch "$file"
	fi
}

# Pool the uploaded packages (archci_pool) and record what was built.
ingest() {
	local id=$1 inc=$2 n
	n=$(archci_pool "$inc" "$job_repo" "$job_arch" "$job_version") || { archci_log "$id: upload rejected"; return 1; }
	# The built record: "version commit", plus, for an any package, the arches it
	# was pooled for, so enabling an arch later makes it outstanding again.
	mkdir -p "$ARCHCI_HOME/built/$job_repo-$job_arch"
	local pooled=''
	[[ $job_arch == any ]] && pooled=" ${ARCHCI_ARCHES// /,}"
	printf '%s %s%s\n' "$job_version" "$job_commit" "$pooled" >"$ARCHCI_HOME/built/$job_repo-$job_arch/$job_pkgbase"
	touch "$ARCHCI_HOME/publish.needed"
	archci_log "$id: pooled $n package(s) for [$job_repo]"
}

# A src job's results: the source package (<pkgbase>-<version>-<sha256>
# .src.tar.zst, as the sourcer names it; an older sourcer's
# <pkgbase>-<version>.src.tar.gz gets its hash here) and its builder
# signature, pooled under <repo>/os/src for the signer as a package is;
# the built record names the file, which a build claim hands to the worker
# once it is released.
ingest_src() {
	local id=$1 inc=$2 f dir=$ARCHCI_HOME/repo/$job_repo/os/src
	local -a cands
	shopt -s nullglob; cands=("$inc/$job_pkgbase-$job_version"*.src.tar.zst "$inc/$job_pkgbase-$job_version"*.src.tar.gz); shopt -u nullglob
	(( ${#cands[@]} == 1 )) || { archci_log "$id: expected one $job_pkgbase-$job_version*.src.tar.* in the upload, found ${#cands[@]}"; return 1; }
	[[ -f ${cands[0]}.buildsig ]] || { archci_log "$id: no ${cands[0]##*/}.buildsig in the upload"; return 1; }
	f=$(archci_hash_rename "${cands[0]}") || { archci_log "$id: could not hash ${cands[0]##*/}"; return 1; }
	f=${f##*/}
	(
		exec 8>"$ARCHCI_HOME/lock/repo.lock"
		flock 8
		mkdir -p "$dir"
		mv "$inc/$f" "$dir/$f" && mv "$inc/$f.buildsig" "$dir/$f.buildsig"
	) || return 1
	mkdir -p "$ARCHCI_HOME/built/$job_repo-src"
	printf '%s %s %s\n' "$job_version" "$job_commit" "$f" >"$ARCHCI_HOME/built/$job_repo-src/$job_pkgbase"
	touch "$ARCHCI_HOME/publish.needed"
	archci_log "$id: pooled $f for [$job_repo]"
}

cmd_report() {
	local id=$1 status=$2 sender=$3 file inc logdir
	archci_valid_id "$id" || archci_die "invalid job id"
	[[ $status == success || $status == failure || $status == abandoned ]] || archci_die "bad status: $status"
	lock_queue
	file=$Q_RUNNING/$id.job
	[[ -f $file ]] || archci_die "job $id is not running (housekeeping took it, or already reported)"
	archci_read_job "$file"
	# a late report from a worker the job was taken from (requeued, retried,
	# and claimed elsewhere since) is not this job's
	[[ $sender == "$job_worker" ]] || archci_die "job $id is $job_worker's now, not $sender's; report refused"
	inc=$ARCHCI_HOME/incoming/$id

	if [[ $status == abandoned ]]; then
		# Worker was shut down mid-build; do not count it as an attempt.
		set_attempt "$file" $((job_attempt - 1))
		requeue_file "$file"
		archci_log "$id abandoned by $job_worker, requeued"
		return 0
	fi

	# The build's log is its unit's entries in the workers' journal on the
	# master (Archci.read_log), not a file: nothing of it is archived. What
	# a listing says of the job, its first error line and its last, is read
	# from the journal once, now, into the job file (error=, last=), so
	# archci failed and archci jobs into a pipe need not read it per job.
	# archci-publish exports the whole log to R2 once the journal has it.
	rm -f "$inc/build.log"
	local summary=()
	mapfile -t summary < <("$ARCHCI_MASTER_DIR/archci-web" summary "$id" 2>/dev/null || true)
	# (an older worker's makepkg log files, repeats of the journal: dropped)
	rm -f "$inc"/*.log

	if [[ $status == success ]]; then
		if [[ $job_arch == src ]]; then ingest_src "$id" "$inc" || status=failure
		else ingest "$id" "$inc" || status=failure
		fi
	fi
	if [[ $status == success ]]; then
		rewrite_job "$file" "$Q_DONE/$id.job" "worker=$job_worker" "status=success" "finished=$(archci_now)" "${summary[@]}"
		archci_log "$id succeeded on $job_worker"
	elif (( job_attempt >= ARCHCI_MAX_ATTEMPTS )); then
		rewrite_job "$file" "$Q_FAILED/$id.job" "worker=$job_worker" "status=failure" "finished=$(archci_now)" "final=1" "${summary[@]}"
		archci_log "$id failed on $job_worker, attempt $job_attempt/$ARCHCI_MAX_ATTEMPTS, giving up"
	else
		rewrite_job "$file" "$Q_FAILED/$id.job" "worker=$job_worker" "status=failure" "finished=$(archci_now)" "${summary[@]}"
		archci_log "$id failed on $job_worker, attempt $job_attempt/$ARCHCI_MAX_ATTEMPTS, will retry"
	fi
	rm -rf "$inc"
}

# refresh_flags FILE: the job's network line follows the package's current
# package.json (the index), not the one it was enqueued with: a flag given
# to a package after its build failed (guile's loopback for its test
# suite) reaches the retry, which is otherwise the same job file again
refresh_flags() {
	local file=$1 pkgbase flag tmp=$1.tmp
	pkgbase=$(sed -n 's/^pkgbase=//p' "$file")
	flag=$("$ARCHCI_MASTER_DIR/archci-pkgindex" "$pkgbase" 2>/dev/null | awk -v p="$pkgbase" '$1 == p { print $7; exit }')
	case $flag in
		network)  flag=full ;;
		loopback) ;;
		*)        flag='' ;;
	esac
	[[ $(sed -n 's/^network=//p' "$file") == "$flag" ]] && return 0
	{ grep -v '^network=' "$file"; [[ -n $flag ]] && printf 'network=%s\n' "$flag"; } >"$tmp"
	mv "$tmp" "$file"
	archci_log "${file##*/}: network is now ${flag:-off}, as the package's package.json says"
}

# a finished job's exported= line goes, under the lock: the next export pass
# exports its log afresh (a log the journal lacked at the time, a new layout)
cmd_reexport() {
	local what=$1 file n=0 tmp
	lock_queue
	for file in "$Q_DONE"/*.job "$Q_FAILED"/*.job; do
		[[ -f $file ]] || continue
		case $what in
			--all)  grep -q '^exported=' "$file" || continue ;;
			--none) grep -q '^exported=none$' "$file" || continue ;;
			*)      [[ ${file##*/} == "$what.job" ]] || continue
			        grep -q '^exported=' "$file" || archci_die "job $what carries no export mark" ;;
		esac
		tmp=$file.tmp
		grep -v '^exported=' "$file" >"$tmp" && mv "$tmp" "$file"
		(( ++n ))
	done
	case $what in
		--all|--none) archci_log "$n job(s) to export again" ;;
		*) (( n )) || archci_die "job $what is not done or failed"; archci_log "$what: to export again" ;;
	esac
}

cmd_requeue() {
	local id=$1 file
	archci_valid_id "$id" || archci_die "invalid job id"
	lock_queue
	file=$(find_job "$id" "$Q_RUNNING" "$Q_FAILED") || archci_die "job $id is not running or failed"
	refresh_flags "$file"
	requeue_file "$file"
	archci_log "$id requeued"
}

# retry_file FILE (lock held): a retry is a new job, unrelated to the failed
# one: a fresh id (so every build of an id is one of its own attempts, and
# the id's logs on the release are its own), the package as its PKGBUILD
# repository has it now (version, commit, network flag). The failed job
# stays in failed/ as history (the overview shows it), final and marked
# retried_as=<new id>, so it is neither retried again by housekeeping nor
# by retry --all. Prints the new id; a package the repository no longer
# has gets no job (the failed one stays, unmarked).
retry_file() {
	local file=$1 id pkgbase arch repo prio line name version commit parch profile build old new tmp
	id=$(sed -n 's/^id=//p' "$file"); pkgbase=$(sed -n 's/^pkgbase=//p' "$file")
	arch=$(sed -n 's/^arch=//p' "$file"); repo=$(sed -n 's/^repo=//p' "$file"); prio=${id%%-*}
	if grep -q '^retried_as=' "$file"; then
		archci_log "$id was already retried as $(sed -n 's/^retried_as=//p' "$file")"
		return 1
	fi
	line=$("$ARCHCI_MASTER_DIR/archci-pkgindex" "$pkgbase" 2>/dev/null)
	if [[ -z $line ]]; then
		archci_log "$id: $pkgbase is no longer in the PKGBUILD repository; no new job"
		return 1
	fi
	rm -rf "${ARCHCI_HOME:?}/incoming/$id"
	read -r name version commit parch profile _ build _ <<<"$line"
	[[ $name == "$pkgbase" && -n $commit ]] || archci_die "unexpected index line: $line"
	for old in "$Q_PENDING"/*-"$repo,$pkgbase,"*",$arch.job"; do   # one pending job per package and arch, as enqueue keeps it
		[[ -e $old ]] && rm -f "$old"
	done
	new=$(write_job "$Q_PENDING" "$prio" "$repo" "$arch" "$pkgbase" "$version" "$commit" "$profile" "$build")
	tmp=$file.tmp
	{ grep -v '^final=' "$file"; printf 'final=1\nretried_as=%s\n' "${new%.job}"; } >"$tmp" && mv "$tmp" "$file"
	archci_log "$id retried as ${new%.job}: a new job at the package's current commit; the failed one stays, given up"
	printf '%s\n' "${new%.job}"
}

cmd_retry() {
	local id=$1 file n=0
	if [[ $id == -a || $id == --all ]]; then
		lock_queue
		for file in "$Q_FAILED"/*.job; do
			[[ -f $file ]] || continue
			retry_file "$file" >/dev/null && (( ++n ))
		done
		archci_log "$n failed job(s) retried as new jobs"
		return 0
	fi
	archci_valid_id "$id" || archci_die "invalid job id"
	lock_queue
	file=$(find_job "$id" "$Q_FAILED") || archci_die "job $id is not failed (a running job goes back to pending with: archci-job requeue $id)"
	retry_file "$file" || exit 1
}

cmd_enqueue() {
	local pkgbase=$1 prio=${2:-0} arch=${3:-$ARCHCI_ARCH} repo=$ARCHCI_REPO line name version commit parch profile build old
	archci_valid_arch "$arch" || archci_die "invalid arch: $arch"
	[[ $arch == any ]] || archci_enabled_arch "$arch" || archci_die "arch $arch is not enabled (ARCHCI_ARCHES=\"$ARCHCI_ARCHES\")"
	line=$("$ARCHCI_MASTER_DIR/archci-pkgindex" "$pkgbase")
	[[ -n $line ]] || archci_die "no package $pkgbase in the PKGBUILD repository (run archci-scan first?)"
	read -r name version commit parch profile _ build _ <<<"$line"
	[[ $name == "$pkgbase" && -n $commit ]] || archci_die "unexpected index line: $line"
	if [[ $arch == src ]]; then :   # its sources: any package's
	elif [[ $parch == any ]]; then
		[[ $arch == any ]] || archci_die "$pkgbase is an arch-independent package; enqueue it with ARCH=any"
	else
		[[ $arch != any ]] || archci_die "$pkgbase is not an arch-independent package (arch=$parch)"
	fi
	lock_queue
	for old in "$Q_PENDING"/*-"$repo,$pkgbase,"*",$arch.job"; do
		[[ -e $old ]] && rm -f "$old"
	done
	name=$(write_job "$Q_PENDING" "$prio" "$repo" "$arch" "$pkgbase" "$version" "$commit" "$profile" "$build")
	archci_log "enqueued ${name%.job}"
	# the claim applies the filter to queued jobs too (see cmd_claim): say so
	# now rather than let the job sit unexplained
	if ! archci_pkg_wanted "$pkgbase"; then
		archci_log "note: $pkgbase is outside the farm's filter (ARCHCI_PKG_SOURCES=\"$ARCHCI_PKG_SOURCES\" ARCHCI_PKG_REPOS=\"$ARCHCI_PKG_REPOS\"): the job waits in pending/ until ARCHCI_PKG_ALSO names the package or the filter is lifted"
	elif [[ $ARCHCI_SOURCES_REQUIRED == 1 && $arch != src ]] && [[ -z $(source_package_for "$repo" "$pkgbase" "$commit") ]]; then
		archci_log "note: the job waits in pending/ for the package's source package (ARCHCI_SOURCES_REQUIRED): the sourcer fetches it next"
	fi
}

# ---------------------------------------------------------------------------
cmd=${1:-}
shift || true
case $cmd in
	claim)     (( $# >= 2 )) || archci_die "usage: archci-job claim WORKER ARCH [K=V...]"; cmd_claim "$@" ;;
	heartbeat) (( $# >= 1 )) || archci_die "usage: archci-job heartbeat ID [K=V...]"; ARCHCI_LOG_JOB=$1 cmd_heartbeat "$@" ;;
	report)    (( $# == 3 )) || archci_die "usage: archci-job report ID STATUS WORKER"; ARCHCI_LOG_JOB=$1 cmd_report "$1" "$2" "$3" ;;
	requeue)   (( $# == 1 )) || archci_die "usage: archci-job requeue ID";          ARCHCI_LOG_JOB=$1 cmd_requeue "$1" ;;
	reexport)  (( $# == 1 )) || archci_die "usage: archci-job reexport ID | --none | --all"; cmd_reexport "$1" ;;
	retry)     (( $# == 1 )) || archci_die "usage: archci-job retry ID | -a|--all"; ARCHCI_LOG_JOB=$1 cmd_retry "$1" ;;   # prints the new job's id
	enqueue)   (( $# >= 1 && $# <= 3 )) || archci_die "usage: archci-job enqueue PKGBASE [PRIO] [ARCH]"; cmd_enqueue "$@" ;;
	*) awk 'NR > 1 && !/^#/ { exit } NR > 1' "$0" >&2; exit 2 ;;
esac
