#!/bin/bash
# archci-job -- master-side queue operations (runs as the archci user).
#
#   claim WORKER ARCH [K=V...]
#                             hand the next job to WORKER (building ARCH) and
#                             print it: the first pending file
#                             the worker can build, else the next outstanding
#                             package (archci-next ARCH), chosen just in time.
#                             The host stats sent along (ARCHCI_HOST_STATS) are
#                             kept in hosts/WORKER: the host as last polled,
#                             for the UIs while the worker is idle
#   heartbeat ID [K=V...]     mark a running job as still alive; the worker's
#                             host stats (ARCHCI_HOST_STATS) and the job's
#                             (ARCHCI_JOB_STATS) are kept with the job
#   report ID STATUS          finish a job: success | failure | abandoned
#                             (results are expected in incoming/ID/)
#   requeue ID                move a running/failed job back to pending
#   retry ID | -a|--all       reset the attempt counter and requeue: one job,
#                             or every failed job (final ones included)
#   enqueue PKGBASE [P] [ARCH]
#                             queue the package's current version (from the
#                             PKGBUILD repository clone), priority P (default
#                             0), for ARCH (default ARCHCI_ARCH; "any" for an
#                             arch-independent package)
#   housekeeping              requeue stale running jobs and due retries, prune done/
#
# Jobs are files; moving them between queue/{pending,running,done,failed} is
# the whole state machine. The backlog is never stored: pending/ only holds
# manual enqueues and retries. Everything that touches the queue takes queue.lock.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

lock_queue() {
	exec 9>"$ARCHCI_HOME/lock/queue.lock"
	flock 9
}

# Move FILE to DIR, dropping bookkeeping fields and appending EXTRA lines. A
# job that ends (done/, failed/) keeps its last heartbeat stats and when that
# beat arrived (the file's mtime): the host's last known state for the UIs.
rewrite_job() {
	local file=$1 dest=$2 tmp beat=() drop
	drop="worker|claimed|status|finished|final|heartbeat|$(archci_stats_re)"
	shift 2
	if [[ $dest == "$Q_DONE"/* || $dest == "$Q_FAILED"/* ]]; then
		drop='worker|claimed|status|finished|final|heartbeat'
		grep -q '^load=' "$file" && beat=("heartbeat=$(date -u -r "$file" +%FT%TZ)")
	fi
	tmp=$dest.tmp
	{
		grep -Ev "^($drop)=" "$file"
		printf '%s\n' "$@" "${beat[@]}"
	} >"$tmp"
	mv "$tmp" "$dest"
	[[ $file == "$dest" ]] || rm -f "$file"
}

set_attempt() {  # set_attempt FILE N  (in place)
	local file=$1 n=$2 tmp=$1.tmp
	{ grep -v '^attempt=' "$file"; printf 'attempt=%d\n' "$n"; } >"$tmp"
	mv "$tmp" "$file"
}

requeue_file() {  # requeue_file FILE  (lock held)
	local file=$1 name=${1##*/}
	rewrite_job "$file" "$Q_PENDING/$name"
	rm -rf "${ARCHCI_HOME:?}/incoming/${name%.job}"
}

# write_job DEST PRIO REPO ARCH PKGBASE VERSION COMMIT PROFILE -> prints the file name
write_job() {
	local dest=$1 prio=$2 repo=$3 arch=$4 pkgbase=$5 version=$6 commit=$7 profile=$8 id
	id="$prio-$(date +%s)-$repo,$pkgbase,$version,$arch"
	archci_valid_id "$id" || archci_die "cannot form a valid job id for $repo/$pkgbase $version $arch"
	cat >"$dest/$id.job.tmp" <<-JOB
		id=$id
		repo=$repo
		arch=$arch
		pkgbase=$pkgbase
		version=$version
		commit=$commit
		profile=$profile
		attempt=0
		created=$(archci_now)
	JOB
	mv "$dest/$id.job.tmp" "$dest/$id.job"
	printf '%s\n' "$id.job"
}

find_job() {  # find_job ID DIR... -> path
	local id=$1 d
	shift
	for d in "$@"; do
		[[ -f $d/$id.job ]] && { printf '%s\n' "$d/$id.job"; return 0; }
	done
	return 1
}

# ---------------------------------------------------------------------------
cmd_claim() {
	local worker=$1 warch=$2 stat hostre
	shift 2
	archci_valid_worker "$worker" || archci_die "invalid worker id: $worker"
	archci_valid_arch "$warch" || archci_die "invalid arch: $warch"
	archci_enabled_arch "$warch" || archci_die "arch $warch is not enabled on this master (ARCHCI_ARCHES=\"$ARCHCI_ARCHES\")"
	if (( $# )); then
		hostre=${ARCHCI_HOST_STATS// /|}
		for stat in "$@"; do
			[[ $stat =~ ^($hostre)=[A-Za-z0-9./-]{1,32}$ ]] || archci_die "bad host stat: $stat"
		done
		mkdir -p "$ARCHCI_HOME/hosts"
		{ printf 'worker=%s\narch=%s\nseen=%s\n' "$worker" "$warch" "$(archci_now)"; printf '%s\n' "$@"; } >"$ARCHCI_HOME/hosts/$worker.tmp"
		mv "$ARCHCI_HOME/hosts/$worker.tmp" "$ARCHCI_HOME/hosts/$worker"
	fi
	lock_queue
	local name='' pend p
	local LC_ALL=C                       # deterministic, ASCII filename order
	shopt -s nullglob; pend=("$Q_PENDING"/*.job); shopt -u nullglob
	# The first pending job this worker's arch can build (its own arch, or "any"
	# if it is the any arch).
	for p in "${pend[@]}"; do
		archci_read_job "$p" || continue
		archci_can_build "$warch" "$job_arch" || continue
		name=${p##*/}; break
	done
	if [[ -z $name ]]; then
		# Nothing queued by hand or for retry: pick the next outstanding package now.
		local prio repo arch pkgbase version commit profile
		read -r prio repo arch pkgbase version commit profile < <("$ARCHCI_MASTER_DIR/archci-next" "$warch") || true
		[[ -n ${commit:-} ]] || exit 0
		name=$(write_job "$Q_PENDING" "$prio" "$repo" "$arch" "$pkgbase" "$version" "$commit" "$profile")
	fi
	mv "$Q_PENDING/$name" "$Q_RUNNING/$name"
	archci_read_job "$Q_RUNNING/$name" || archci_die "corrupt job file $name"
	rewrite_job "$Q_RUNNING/$name" "$Q_RUNNING/$name" \
		"worker=$worker" "claimed=$(archci_now)"
	set_attempt "$Q_RUNNING/$name" $((job_attempt + 1))
	mkdir -p "$ARCHCI_HOME/incoming/${name%.job}"
	archci_log "claim ${name%.job} -> $worker (attempt $((job_attempt + 1)))"
	cat "$Q_RUNNING/$name"
}

cmd_heartbeat() {
	local id=$1 file stat
	shift
	archci_valid_id "$id" || archci_die "invalid job id"
	file=$Q_RUNNING/$id.job
	[[ -f $file ]] || archci_die "job $id is not running"
	for stat in "$@"; do
		[[ $stat =~ ^($(archci_stats_re))=[A-Za-z0-9./-]{1,32}$ ]] || archci_die "bad heartbeat stat: $stat"
	done
	if (( $# )); then
		{ grep -Ev "^($(archci_stats_re))=" "$file"; printf '%s\n' "$@"; } >"$file.tmp"
		mv "$file.tmp" "$file"   # the new mtime is the heartbeat
	else
		touch "$file"
	fi
}

# Pool the uploaded packages (archci_pool) and record what was built.
ingest() {
	local id=$1 inc=$2 n
	n=$(archci_pool "$inc" "$job_repo" "$job_arch" "$job_version") || { archci_log "$id: upload rejected"; return 1; }
	# The built record: "version commit", plus, for an any package, the arches it
	# was pooled for, so enabling an arch later makes it outstanding again.
	mkdir -p "$ARCHCI_HOME/built/$job_repo-$job_arch"
	local pooled=''
	[[ $job_arch == any ]] && pooled=" ${ARCHCI_ARCHES// /,}"
	printf '%s %s%s\n' "$job_version" "$job_commit" "$pooled" >"$ARCHCI_HOME/built/$job_repo-$job_arch/$job_pkgbase"
	touch "$ARCHCI_HOME/stage.needed"
	archci_log "$id: pooled $n package(s) for [$job_repo]"
}

cmd_report() {
	local id=$1 status=$2 file inc logdir
	archci_valid_id "$id" || archci_die "invalid job id"
	[[ $status == success || $status == failure || $status == abandoned ]] || archci_die "bad status: $status"
	lock_queue
	file=$Q_RUNNING/$id.job
	[[ -f $file ]] || archci_die "job $id is not running (housekeeping took it, or already reported)"
	archci_read_job "$file"
	inc=$ARCHCI_HOME/incoming/$id

	if [[ $status == abandoned ]]; then
		# Worker was shut down mid-build; do not count it as an attempt.
		set_attempt "$file" $((job_attempt - 1))
		requeue_file "$file"
		archci_log "$id abandoned by $job_worker, requeued"
		return 0
	fi

	logdir=$ARCHCI_HOME/logs/$job_repo/$job_pkgbase/$job_version/$job_arch
	mkdir -p "$logdir"
	[[ -f $inc/build.log ]] && mv "$inc/build.log" "$logdir/attempt-$job_attempt.log"
	# makepkg's own logs (<pkg>-<ver>-<arch>-{prepare,build,check,package}.log)
	# travel with the results; they hold the compiler and test output that the
	# unit journal does not, and they are all a failed build leaves behind.
	local mlog
	for mlog in "$inc"/*.log; do
		[[ -f $mlog ]] && mv "$mlog" "$logdir/attempt-$job_attempt-${mlog##*/}"
	done

	if [[ $status == success ]] && ! ingest "$id" "$inc"; then
		status=failure
	fi
	if [[ $status == success ]]; then
		rewrite_job "$file" "$Q_DONE/$id.job" "worker=$job_worker" "status=success" "finished=$(archci_now)"
		archci_log "$id succeeded on $job_worker"
	elif (( job_attempt >= ARCHCI_MAX_ATTEMPTS )); then
		rewrite_job "$file" "$Q_FAILED/$id.job" "worker=$job_worker" "status=failure" "finished=$(archci_now)" "final=1"
		archci_log "$id failed on $job_worker, attempt $job_attempt/$ARCHCI_MAX_ATTEMPTS, giving up"
	else
		rewrite_job "$file" "$Q_FAILED/$id.job" "worker=$job_worker" "status=failure" "finished=$(archci_now)"
		archci_log "$id failed on $job_worker, attempt $job_attempt/$ARCHCI_MAX_ATTEMPTS, will retry"
	fi
	rm -rf "$inc"
}

cmd_requeue() {
	local id=$1 file
	archci_valid_id "$id" || archci_die "invalid job id"
	lock_queue
	file=$(find_job "$id" "$Q_RUNNING" "$Q_FAILED") || archci_die "job $id is not running or failed"
	requeue_file "$file"
	archci_log "$id requeued"
}

cmd_retry() {
	local id=$1 file n=0
	if [[ $id == -a || $id == --all ]]; then
		# every failed job, final ones included, as a fresh first attempt
		lock_queue
		for file in "$Q_FAILED"/*.job; do
			[[ -f $file ]] || continue
			set_attempt "$file" 0
			requeue_file "$file"
			(( ++n ))
		done
		archci_log "$n failed job(s) retried from scratch"
		return 0
	fi
	archci_valid_id "$id" || archci_die "invalid job id"
	lock_queue
	file=$(find_job "$id" "$Q_RUNNING" "$Q_FAILED") || archci_die "job $id is not running or failed"
	set_attempt "$file" 0
	requeue_file "$file"
	archci_log "$id retried from scratch"
}

cmd_enqueue() {
	local pkgbase=$1 prio=${2:-0} arch=${3:-$ARCHCI_ARCH} repo=$ARCHCI_REPO line name version commit parch profile old
	archci_valid_arch "$arch" || archci_die "invalid arch: $arch"
	[[ $arch == any ]] || archci_enabled_arch "$arch" || archci_die "arch $arch is not enabled (ARCHCI_ARCHES=\"$ARCHCI_ARCHES\")"
	line=$("$ARCHCI_MASTER_DIR/archci-pkgs" "$pkgbase")
	[[ -n $line ]] || archci_die "no package $pkgbase in the PKGBUILD repository (run archci-scan first?)"
	read -r name version commit parch profile _ <<<"$line"
	[[ $name == "$pkgbase" && -n $commit ]] || archci_die "unexpected index line: $line"
	if [[ $parch == any ]]; then
		[[ $arch == any ]] || archci_die "$pkgbase is an arch-independent package; enqueue it with ARCH=any"
	else
		[[ $arch != any ]] || archci_die "$pkgbase is not an arch-independent package (arch=$parch)"
	fi
	lock_queue
	for old in "$Q_PENDING"/*-"$repo,$pkgbase,"*",$arch.job"; do
		[[ -e $old ]] && rm -f "$old"
	done
	name=$(write_job "$Q_PENDING" "$prio" "$repo" "$arch" "$pkgbase" "$version" "$commit" "$profile")
	archci_log "enqueued ${name%.job}"
}

cmd_housekeeping() {
	local now file age commit n=0
	now=$(date +%s)
	# Current commit of every package, to drop jobs a newer commit supersedes.
	local -A current=()
	local name c
	while read -r name _ c _; do
		[[ -n $c ]] && current[$name]=$c
	done < <("$ARCHCI_MASTER_DIR/archci-pkgs" 2>/dev/null || true)
	lock_queue
	shopt -s nullglob
	for file in "$Q_RUNNING"/*.job; do
		age=$(( now - $(stat -c %Y "$file") ))
		(( age >= ARCHCI_STALE_MINUTES * 60 )) || continue
		archci_read_job "$file" || continue
		archci_log "$job_id: no heartbeat from $job_worker for $((age / 60)) min, requeueing"
		requeue_file "$file"
		(( ++n ))
	done
	# A newer commit of the package supersedes queued and failed jobs; claim
	# picks the new one up if its version is still not the built one.
	for file in "$Q_PENDING"/*.job "$Q_FAILED"/*.job; do
		archci_read_job "$file" || continue
		commit=${current[$job_pkgbase]:-}
		if [[ -n $commit && $commit != "$job_commit" ]]; then
			archci_log "$job_id: superseded by commit ${commit:0:12}, dropping"
			rm -f "$file"
		fi
	done
	for file in "$Q_FAILED"/*.job; do
		archci_read_job "$file" || continue
		(( job_attempt < ARCHCI_MAX_ATTEMPTS )) || continue
		age=$(( now - $(stat -c %Y "$file") ))
		(( age >= ARCHCI_RETRY_MINUTES * 60 )) || continue
		archci_log "$job_id: retrying (attempt $job_attempt/$ARCHCI_MAX_ATTEMPTS)"
		requeue_file "$file"
		(( ++n ))
	done
	shopt -u nullglob
	find "$Q_DONE" -name '*.job' -mtime +"$ARCHCI_DONE_KEEP_DAYS" -delete
	(( n == 0 )) || archci_log "requeued $n job(s)"
}

# ---------------------------------------------------------------------------
cmd=${1:-}
shift || true
case $cmd in
	claim)     (( $# >= 2 )) || archci_die "usage: archci-job claim WORKER ARCH [K=V...]"; cmd_claim "$@" ;;
	heartbeat) (( $# >= 1 )) || archci_die "usage: archci-job heartbeat ID [K=V...]"; cmd_heartbeat "$@" ;;
	report)    (( $# == 2 )) || archci_die "usage: archci-job report ID STATUS";    cmd_report "$1" "$2" ;;
	requeue)   (( $# == 1 )) || archci_die "usage: archci-job requeue ID";          cmd_requeue "$1" ;;
	retry)     (( $# == 1 )) || archci_die "usage: archci-job retry ID | -a|--all"; cmd_retry "$1" ;;
	enqueue)   (( $# >= 1 && $# <= 3 )) || archci_die "usage: archci-job enqueue PKGBASE [PRIO] [ARCH]"; cmd_enqueue "$@" ;;
	housekeeping) cmd_housekeeping ;;
	*) sed -n '2,18p' "$0" >&2; exit 2 ;;
esac
