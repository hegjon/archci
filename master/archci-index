#!/bin/bash
# archci-index -- (re)build the pacman databases on the master from pooled
# packages. Runs as the archci user on a timer. Holds no key.
#
# With ARCHCI_SIGN=1 only packages that already carry a release signature
# (<pkg>.sig, made by the signer) are added, so the database never lists a
# package a client under SigLevel=Required could not verify. With ARCHCI_SIGN=0
# every pooled package is added (used before a signer exists). The database
# itself is not signed (pacman's default is DatabaseOptional).
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

flag=$ARCHCI_HOME/index.needed
[[ ${1:-} == --force ]] || [[ -e $flag ]] || exit 0

exec 9>"$ARCHCI_HOME/lock/repo.lock"
flock 9
rm -f "$flag"

changed=0
shopt -s nullglob
for osdir in "$ARCHCI_HOME"/repo/*/os/"$ARCHCI_ARCH"; do
	[[ -d $osdir ]] || continue
	db=$(basename "$(dirname "$(dirname "$osdir")")")   # <repo> or <repo>-debug
	add=()
	for pkg in "$osdir"/*.pkg.tar.zst; do
		# Only index packages the signer has released (unless signing is off).
		if (( ARCHCI_SIGN )) && [[ ! -f $pkg.sig ]]; then
			continue
		fi
		# Skip packages already recorded in the database at this exact file.
		if [[ -f $osdir/$db.db.tar.gz ]] && \
			bsdtar -xOf "$osdir/$db.db.tar.gz" '*/desc' 2>/dev/null | grep -qxF "${pkg##*/}"; then
			continue
		fi
		add+=("$pkg")
	done
	(( ${#add[@]} )) || continue
	# -R drops older versions of the same package from the db (and their files).
	repo-add -R -q "$osdir/$db.db.tar.gz" "${add[@]}"
	changed=$(( changed + ${#add[@]} ))
	archci_log "indexed ${#add[@]} package(s) into [$db]"
done
shopt -u nullglob

(( changed )) && touch "$ARCHCI_HOME/publish.needed"
exit 0
