#!/bin/bash
# archci-shell -- forced command for worker keys the master authorizes.
#
# authorized_keys (written by archci-authorize):
#   command="/usr/lib/archci/master/archci-shell",restrict  ssh-ed25519 AAAA... worker
#
# A worker may only run the job protocol and rsync into incoming/. The signer
# does not use ssh at all: it exchanges packages with the master through R2.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

read -ra argv <<<"${SSH_ORIGINAL_COMMAND:-}"
case ${argv[0]:-} in
	claim|heartbeat|report|sources-needed|sources-ready|sources-failed) exec "$ARCHCI_MASTER_DIR/archci-job" "${argv[@]}" ;;
	# -no-lock: rrsync 3.5 otherwise holds a lock on incoming/ for the whole
	# transfer, and every other worker's upload fails while one is running
	# (a debug package can take minutes to arrive).
	rsync) exec rrsync -wo -no-del -no-lock "$ARCHCI_HOME/incoming" ;;
	*) archci_log "refused: ${SSH_ORIGINAL_COMMAND:-<none>}"; exit 2 ;;
esac
