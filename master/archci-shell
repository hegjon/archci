#!/bin/bash
# archci-shell -- forced command for worker keys the master authorizes.
#
# authorized_keys (written by archci-authorize):
#   command="/usr/local/lib/archci/master/archci-shell",restrict  ssh-ed25519 AAAA... worker
#
# A worker may only run the job protocol and rsync into incoming/. The signer
# does not use ssh at all: it exchanges packages with the master through R2.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

read -ra argv <<<"${SSH_ORIGINAL_COMMAND:-}"
case ${argv[0]:-} in
	claim|heartbeat|report) exec "$ARCHCI_MASTER_DIR/archci-job" "${argv[@]}" ;;
	rsync) exec rrsync -wo -no-del "$ARCHCI_HOME/incoming" ;;
	*) archci_log "refused: ${SSH_ORIGINAL_COMMAND:-<none>}"; exit 2 ;;
esac
