#!/bin/bash
# archci-shell -- forced command for worker ssh keys on the master.
#
# authorized_keys:  command="/usr/local/lib/archci/master/archci-shell",restrict ssh-ed25519 AAAA... worker
#
# Workers can only claim/heartbeat/report jobs and rsync into incoming/.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

read -ra argv <<<"${SSH_ORIGINAL_COMMAND:-}"
case ${argv[0]:-} in
	claim|heartbeat|report)
		exec "$ARCHCI_MASTER_DIR/archci-job" "${argv[@]}" ;;
	rsync)
		# rrsync (from the rsync package) confines the transfer to this directory.
		exec rrsync -wo -no-del "$ARCHCI_HOME/incoming" ;;
	*)
		archci_log "refused: ${SSH_ORIGINAL_COMMAND:-<none>}"
		exit 2 ;;
esac
