#!/bin/bash
# archci-shell [ROLE] -- forced command for the keys the master authorizes:
# a worker's (ROLE worker, the default), the sourcer's (sourcer, written by
# archci authorize --sourcer), the signer's (signer, --signer) or a web front
# end's (web, --web).
#
# authorized_keys (written by archci-authorize):
#   command="/usr/lib/archci/master/archci-shell",restrict  ssh-ed25519 AAAA... worker
#   command="/usr/lib/archci/master/archci-shell sourcer",restrict  ssh-ed25519 AAAA... sourcer
#   command="/usr/lib/archci/master/archci-shell signer",restrict  ssh-ed25519 AAAA... signer
#   command="/usr/lib/archci/master/archci-shell web",restrict  ssh-ed25519 AAAA... web
#
# The worker and sourcer roles run the job protocol and rsync into
# incoming/. A sourcer key claims, beats for and reports src jobs only (a
# job id ends in ,src); a worker key anything but. The signer role lists
# what waits for a release signature (unsigned), reads the pool (rsync,
# read-only on repo/), returns signatures (rsync, write-only into sigs/),
# parks a file it will not sign (rejected FILE REASON: the master notes
# why beside it and stops offering it) and flags what it signed (signed:
# archci-publish runs at its next tick). The web role reads (archci-web
# snapshot, job ID, log ID, entries ID) and runs the operator's queue
# commands (retry, requeue, enqueue), each logged; it claims nothing and
# uploads nothing.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

role=${1:-worker}
read -ra argv <<<"${SSH_ORIGINAL_COMMAND:-}"
refuse() { archci_log "refused ($role key): ${SSH_ORIGINAL_COMMAND:-<none>}"; exit 2; }
case ${argv[0]:-} in
	claim)
		[[ $role == sourcer && ${argv[2]:-} == src || $role == worker && ${argv[2]:-} != src ]] || refuse
		exec "$ARCHCI_MASTER_DIR/archci-job" "${argv[@]}" ;;
	heartbeat|report)
		[[ $role == sourcer && ${argv[1]:-} == *,src || $role == worker && ${argv[1]:-} != *,src ]] || refuse
		exec "$ARCHCI_MASTER_DIR/archci-job" "${argv[@]}" ;;
	# the signer's key
	unsigned)
		[[ $role == signer ]] || refuse
		exec "$ARCHCI_MASTER_DIR/archci-unsigned" "${argv[@]:1}" ;;
	rejected)
		[[ $role == signer ]] || refuse
		rel=${argv[1]:-}
		[[ -n $rel && $rel != *..* && $rel != /* && $rel == */os/* && -f $ARCHCI_HOME/repo/$rel ]] || refuse
		printf '%s %s\n' "$(archci_now)" "${argv[*]:2}" >"$ARCHCI_HOME/repo/$rel.rejected"
		archci_log "the signer rejected $rel: ${argv[*]:2}" ;;
	signed)
		[[ $role == signer ]] || refuse
		touch "$ARCHCI_HOME/publish.needed" ;;
	# the web key: what a front end reads, and the operator's queue commands
	snapshot|job|log|entries|sse|pkgbuild)
		[[ $role == web ]] || refuse
		exec "$ARCHCI_MASTER_DIR/archci-web" "${argv[@]}" ;;
	retry|requeue|enqueue)
		[[ $role == web ]] || refuse
		archci_log "web key: ${argv[*]}"
		exec "$ARCHCI_MASTER_DIR/archci-job" "${argv[@]}" ;;
	# -no-lock: rrsync 3.5 otherwise holds a lock on incoming/ for the whole
	# transfer, and every other worker's upload fails while one is running
	# (a debug package can take minutes to arrive). The signer's rsync is
	# read-only on the pool when it fetches (rsync's --sender is the master)
	# and write-only into sigs/ when it returns signatures.
	rsync)
		case $role in
			web) refuse ;;
			signer) if [[ " ${argv[*]} " == *" --sender "* ]]; then exec rrsync -ro "$ARCHCI_HOME/repo"
			        else mkdir -p "$ARCHCI_HOME/sigs"; exec rrsync -wo -no-del -no-lock "$ARCHCI_HOME/sigs"; fi ;;
			*) exec rrsync -wo -no-del -no-lock "$ARCHCI_HOME/incoming" ;;
		esac ;;
	*) refuse ;;
esac
