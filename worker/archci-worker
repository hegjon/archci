#!/bin/bash
# archci-worker [INSTANCE] [ARCH] -- pull jobs from the master, build them,
# upload results.
#
# One process per chroot copy; run several via archci-worker@N.service, which
# builds this machine's own arch, or archci-worker-<arch>@N.service, which
# builds ARCH (natively on such a machine, under qemu user-mode emulation on
# another; see docs/ports.md). Instances of different arches
# can run side by side: the worker is known to the master as
# <host>-N or <host>-<arch>-N. Needs only an ssh key that the master has
# authorized with archci-authorize.
#
# Each build runs as archci-build@<repo>-<pkgbase>-<version>-a<attempt>.service,
# a oneshot template unit started with a blocking "systemctl start", so its
# output is in the archci journal namespace (journalctl --namespace=archci
# -u 'archci-build@*'; the namespace is what streams to the master), it has its own
# cgroup, and the unit's TimeoutStartSec is the timeout.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

# A package upgrade replaces this script and the library under a running
# worker; the loop notices (the files' inode, mtime and size against what it
# started with) and re-executes itself between jobs, so a release takes
# effect at the next job boundary with no restart.
self=$(readlink -f "${BASH_SOURCE[0]}")
code_files=("$self" "$ARCHCI_ROOT/lib/archci-common.sh")
code_sig=$(stat -c '%i %Y %s' "${code_files[@]}" | tr '\n' ' ')
orig_args=("$@")

instance=${1:-1}
if [[ -n ${2:-} ]]; then
	archci_valid_arch "$2" || archci_die "invalid arch: $2"
	ARCHCI_ARCH=$2
	instance=$2-$instance
fi
[[ -n $ARCHCI_MASTER ]] || archci_die "ARCHCI_MASTER is not set in $ARCHCI_CONF"
[[ -r $ARCHCI_WORKER_KEY ]] || archci_die "no ssh key at $ARCHCI_WORKER_KEY (archci worker-setup makes one)"
worker="${HOSTNAME%%.*}-$instance"
archci_valid_worker "$worker" || archci_die "hostname makes an invalid worker id: $worker"

ssh_opts=(-i "$ARCHCI_WORKER_KEY" -o BatchMode=yes -o ConnectTimeout=30
	-o ServerAliveInterval=30 -o ServerAliveCountMax=4
	-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/etc/archci/known_hosts)
master() { ssh "${ssh_opts[@]}" "$ARCHCI_MASTER" "$@"; }

jobsdir=$ARCHCI_WORKER_HOME/jobs
claim=$jobsdir/claim-$instance.tmp
mkdir -p "$jobsdir"

job_id=
unit=
reported=1
on_term() {
	trap - TERM INT
	[[ -n $unit ]] && systemctl stop "$unit.service" 2>/dev/null || true
	if [[ -n $job_id && $reported == 0 ]]; then
		archci_log "shutting down, handing $job_id back to the master"
		master report "$job_id" abandoned || true
	fi
	exit 0   # a stop is not a failure: the unit ends inactive, not failed
}
trap on_term TERM INT

archci_valid_arch "$ARCHCI_ARCH" || archci_die "invalid ARCHCI_ARCH: $ARCHCI_ARCH"
archci_log "worker $worker ($ARCHCI_ARCH) started, master $ARCHCI_MASTER"
down=0
while true; do
	if [[ $(stat -c '%i %Y %s' "${code_files[@]}" 2>/dev/null | tr '\n' ' ') != "$code_sig" ]]; then
		archci_log "archci-worker or its library changed on disk; restarting on the new code"
		exec "$self" "${orig_args[@]}"
	fi
	# the poll carries the host's stats, so the master's hosts table stays
	# current while this worker is idle (heartbeats only flow during a build)
	# shellcheck disable=SC2046  # the stats are separate key=value words on purpose
	if ! master claim "$worker" "$ARCHCI_ARCH" $(archci_worker_stats) >"$claim"; then
		(( down )) || archci_log "master unreachable, retrying every ${ARCHCI_IDLE_SLEEP}s"   # once, not once a minute all weekend
		down=1
		rm -f "$claim"
		sleep "$ARCHCI_IDLE_SLEEP"
		continue
	fi
	(( down )) && archci_log "master reachable again"
	down=0
	if [[ ! -s $claim ]]; then
		rm -f "$claim"
		sleep "$ARCHCI_IDLE_SLEEP"
		continue
	fi
	if ! archci_read_job "$claim"; then
		archci_log "master sent an unreadable job, ignoring"
		rm -f "$claim"
		sleep "$ARCHCI_IDLE_SLEEP"
		continue
	fi
	reported=0
	# Unit instance and job directory share a name made of safe unit-name characters.
	name=$(printf '%s' "$job_repo-$job_pkgbase-$job_version-$job_arch-a$job_attempt" | tr -c 'A-Za-z0-9:_.-' '_')
	jobdir=$jobsdir/$name
	outdir=$jobdir/out
	rm -rf "$jobdir"
	mkdir -p "$outdir"
	mv "$claim" "$jobdir/job"
	printf '%s\n' "$ARCHCI_ARCH" >"$jobdir/arch"   # the arch this instance builds, for archci-build
	archci_log "building $job_id as archci-build@$name"

	unit=archci-build@$name
	date +%s%6N >"$jobdir/started"   # the job's start, for the first CPU sample (archci_job_stats)
	# Keep the master's housekeeping from calling the job stale while the build runs. Each beat
	# carries this machine's load, memory, chroot disk use and core count, and
	# the job's own CPU, memory and build-tree size from its cgroup, which the
	# master keeps with the job for archci-top.
	(
		trap - TERM INT
		# The first beat goes soon after the start, and beats come every 10 s
		# until one has carried the job's own stats (the build's scope only
		# exists once makechrootpkg has set the chroot up and installed the
		# dependencies), then every ARCHCI_HEARTBEAT_SECONDS.
		# A beat also goes as soon as the build enters a new phase (archci-build
		# writes JOBDIR/phase), so archci top shows it without waiting a minute.
		hb_down=0 wait=5 jobstats='' slept=0 seen_phase=''
		while sleep 5; do
			(( slept += 5 ))
			(( slept >= wait )) || [[ $(stat -c %Y "$jobdir/phase" 2>/dev/null) != "$seen_phase" ]] || continue
			slept=0; seen_phase=$(stat -c %Y "$jobdir/phase" 2>/dev/null || true)
			jobstats=$(archci_job_stats "$jobdir" "$unit")
			wait=$(( ${#jobstats} ? ARCHCI_HEARTBEAT_SECONDS : 10 ))
			# shellcheck disable=SC2046,SC2086  # the stats are separate key=value words on purpose
			if master heartbeat "$job_id" $(archci_worker_stats) $jobstats; then
				(( hb_down )) && archci_log "heartbeat for $job_id reaches the master again"
				hb_down=0
			else
				(( hb_down )) || archci_log "heartbeat for $job_id failed; the build goes on"
				hb_down=1
			fi
		done
	) &
	heartbeat=$!

	start=$(date +%s)
	systemctl reset-failed "$unit.service" 2>/dev/null || true
	systemctl start "$unit.service" || true   # blocks until the oneshot has finished
	kill "$heartbeat" 2>/dev/null || true
	wait "$heartbeat" 2>/dev/null || true
	# The journal is the build log; keep a copy with the packages for the master.
	journalctl --namespace=archci -u "$unit" --since="@$start" -o cat --no-pager >"$outdir/build.log" 2>/dev/null || true
	systemctl reset-failed "$unit.service" 2>/dev/null || true
	status=failure
	[[ -f $outdir/result && $(<"$outdir/result") == success ]] && status=success
	archci_log "$job_id: $status after $(( ($(date +%s) - start) / 60 )) min (journalctl --namespace=archci -u $unit)"
	unit=

	# Upload the results, then report. While the master is unreachable (a
	# reboot, a night, a weekend) the finished build is kept and retried every
	# 30 s for as long as it takes; a heartbeat first keeps the master's
	# housekeeping from requeueing the job as stale when it comes back. Only ssh
	# failures (exit 255) mean "unreachable": a heartbeat or report the master
	# itself refuses says the job is no longer ours (taken by housekeeping, or re-claimed by
	# another worker), and only then are the results dropped.
	uploaded=0 try=0 dropped=0
	while true; do
		(( ++try ))
		rc=0; master heartbeat "$job_id" phase=upload || rc=$?
		if (( rc == 255 )); then
			(( try == 1 )) && archci_log "master unreachable, keeping $job_id's results until it is back"
			sleep "$ARCHCI_DELIVERY_RETRY_SECONDS"; continue
		elif (( rc )); then
			archci_log "$job_id is no longer ours; dropping its results"; dropped=1; break
		fi
		if (( ! uploaded )); then
			if rsync -a --timeout=300 -e "ssh ${ssh_opts[*]}" "$outdir/" "$ARCHCI_MASTER:$job_id/"; then
				uploaded=1
			else
				archci_log "upload of $job_id failed (try $try)"
				sleep "$ARCHCI_DELIVERY_RETRY_SECONDS"; continue
			fi
		fi
		rc=0; master report "$job_id" "$status" || rc=$?
		(( rc == 0 )) && { reported=1; break; }
		(( rc == 255 )) || { archci_log "the master refused the report for $job_id; dropping it"; dropped=1; break; }
		archci_log "could not report $job_id (try $try)"
		sleep "$ARCHCI_DELIVERY_RETRY_SECONDS"
	done
	(( reported && try > 1 )) && archci_log "$job_id delivered after $try tries"
	rm -rf "$jobdir"
	job_id=
done
