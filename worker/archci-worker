#!/bin/bash
# archci-worker [INSTANCE] [ARCH] -- pull jobs from the master, build them,
# upload results.
#
# One process per chroot copy; run several via archci-worker@N.service, which
# builds this machine's own arch, or archci-worker-<arch>@N.service, which
# builds ARCH (natively on such a machine, under qemu user-mode emulation on
# another; see docs/ports.md). Instances of different arches
# can run side by side: the worker is known to the master as
# <host>-N or <host>-<arch>-N. Needs only an ssh key that the master has
# authorized with archci-authorize.
#
# Each build runs as archci-build@<repo>-<pkgbase>-<version>-a<attempt>.service,
# a oneshot template unit started with a blocking "systemctl start", so its
# output is in the archci journal namespace (journalctl --namespace=archci
# -u 'archci-build@*'; the namespace is what streams to the master), it has its own
# cgroup, and the unit's TimeoutStartSec is the timeout.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

instance=${1:-1}
if [[ -n ${2:-} ]]; then
	archci_valid_arch "$2" || archci_die "invalid arch: $2"
	ARCHCI_ARCH=$2
	instance=$2-$instance
fi
[[ -n $ARCHCI_MASTER ]] || archci_die "ARCHCI_MASTER is not set in $ARCHCI_CONF"
[[ -r $ARCHCI_WORKER_KEY ]] || archci_die "no ssh key at $ARCHCI_WORKER_KEY (archci worker-setup makes one)"
worker="${HOSTNAME%%.*}-$instance"
archci_valid_worker "$worker" || archci_die "hostname makes an invalid worker id: $worker"

ssh_opts=(-i "$ARCHCI_WORKER_KEY" -o BatchMode=yes -o ConnectTimeout=30
	-o ServerAliveInterval=30 -o ServerAliveCountMax=4
	-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/etc/archci/known_hosts)
master() { ssh "${ssh_opts[@]}" "$ARCHCI_MASTER" "$@"; }

jobsdir=$ARCHCI_WORKER_HOME/jobs
claim=$jobsdir/claim-$instance.tmp
mkdir -p "$jobsdir"

job_id=
unit=
reported=1
on_term() {
	trap - TERM INT
	[[ -n $unit ]] && systemctl stop "$unit.service" 2>/dev/null || true
	if [[ -n $job_id && $reported == 0 ]]; then
		archci_log "shutting down, handing $job_id back to the master"
		master report "$job_id" abandoned || true
	fi
	exit 143
}
trap on_term TERM INT

archci_valid_arch "$ARCHCI_ARCH" || archci_die "invalid ARCHCI_ARCH: $ARCHCI_ARCH"
archci_log "worker $worker ($ARCHCI_ARCH) started, master $ARCHCI_MASTER"
while true; do
	if ! master claim "$worker" "$ARCHCI_ARCH" >"$claim"; then
		archci_log "master unreachable, retrying in ${ARCHCI_IDLE_SLEEP}s"
		rm -f "$claim"
		sleep "$ARCHCI_IDLE_SLEEP"
		continue
	fi
	if [[ ! -s $claim ]]; then
		rm -f "$claim"
		sleep "$ARCHCI_IDLE_SLEEP"
		continue
	fi
	if ! archci_read_job "$claim"; then
		archci_log "master sent an unreadable job, ignoring"
		rm -f "$claim"
		sleep "$ARCHCI_IDLE_SLEEP"
		continue
	fi
	reported=0
	# Unit instance and job directory share a name made of safe unit-name characters.
	name=$(printf '%s' "$job_repo-$job_pkgbase-$job_version-$job_arch-a$job_attempt" | tr -c 'A-Za-z0-9:_.-' '_')
	jobdir=$jobsdir/$name
	outdir=$jobdir/out
	rm -rf "$jobdir"
	mkdir -p "$outdir"
	mv "$claim" "$jobdir/job"
	printf '%s\n' "$ARCHCI_ARCH" >"$jobdir/arch"   # the arch this instance builds, for archci-build
	archci_log "building $job_id as archci-build@$name"

	unit=archci-build@$name
	# Keep the master's stale-job reaper away while the build runs. Each beat
	# carries this machine's load, memory, chroot disk use and core count, and
	# the job's own CPU, memory and build-tree size from its cgroup, which the
	# master keeps with the job for archci-top and archci-status.
	(
		trap - TERM INT
		while sleep "$ARCHCI_HEARTBEAT_SECONDS"; do
			# shellcheck disable=SC2046  # the stats are separate key=value words on purpose
			master heartbeat "$job_id" $(archci_worker_stats) $(archci_job_stats "$jobdir" "$unit") || archci_log "heartbeat for $job_id failed"
		done
	) &
	heartbeat=$!

	start=$(date +%s)
	systemctl reset-failed "$unit.service" 2>/dev/null || true
	systemctl start "$unit.service" || true   # blocks until the oneshot has finished
	kill "$heartbeat" 2>/dev/null || true
	wait "$heartbeat" 2>/dev/null || true
	# The journal is the build log; keep a copy with the packages for the master.
	journalctl --namespace=archci -u "$unit" --since="@$start" -o cat --no-pager >"$outdir/build.log" 2>/dev/null || true
	systemctl reset-failed "$unit.service" 2>/dev/null || true
	status=failure
	[[ -f $outdir/result && $(<"$outdir/result") == success ]] && status=success
	archci_log "$job_id: $status after $(( ($(date +%s) - start) / 60 )) min (journalctl --namespace=archci -u $unit)"
	unit=

	for try in 1 2 3; do
		rsync -a --timeout=300 -e "ssh ${ssh_opts[*]}" "$outdir/" "$ARCHCI_MASTER:$job_id/" && break
		archci_log "upload of $job_id failed (try $try)"
		sleep 30
	done
	if master report "$job_id" "$status"; then
		reported=1
	else
		archci_log "could not report $job_id; the master will requeue it"
	fi
	rm -rf "$jobdir"
	job_id=
done
