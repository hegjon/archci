#!/bin/bash
# archci-build JOBFILE OUTDIR [COPY] -- build one job in a clean devtools chroot.
#
# Runs as root on a worker, normally inside archci-build@<name>.service started
# by archci-worker, so each build has its own unit, cgroup, journal and
# TimeoutStartSec. Packages and makepkg logs end up in OUTDIR, together with a
# "result" file saying success or failure; the worker trusts that file, not the
# unit's exit status, because a build killed by SIGTERM (e.g. an external stop)
# is counted a clean exit by systemd. (A TimeoutStartSec timeout, by contrast,
# already fails the unit.) COPY is the chroot copy to use; it defaults to archci-<N> for the
# worker instance N found in the job file's worker= line.
# To reproduce a build by hand:  archci-build /path/to/job /tmp/out manual
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/archci-common.sh"

jobfile=${1:-} outdir=${2:-}
[[ -f $jobfile && -n $outdir ]] || archci_die "usage: archci-build JOBFILE OUTDIR [COPY]"
archci_read_job "$jobfile" || archci_die "$jobfile is not a valid job file"
instance=${3:-${job_worker##*-}}
instance=${instance:-manual}
# The worker instance that claimed the job says which arch it builds (an
# archci-worker-<arch>@ instance differs from the machine's ARCHCI_ARCH).
[[ -f ${jobfile%/*}/arch ]] && ARCHCI_ARCH=$(<"${jobfile%/*}/arch")
(( EUID == 0 )) || archci_die "must run as root (makechrootpkg needs it)"
for tool in mkarchroot makechrootpkg arch-nspawn; do
	command -v "$tool" >/dev/null || archci_die "devtools is not installed"
done
id -u "$ARCHCI_BUILD_USER" >/dev/null 2>&1 || archci_die "build user $ARCHCI_BUILD_USER does not exist"

# devtools' own helpers: lock, lock_close, is_subvolume, subvolume_delete_recursive, ...
# Its common.sh is not nounset-clean (it reads DEVTOOLS_COLOR unguarded), so
# drop -u before sourcing; the rest of this script does not rely on it.
export DEVTOOLS_COLOR=never
set +u
source /usr/share/devtools/lib/common.sh
source /usr/share/devtools/lib/archroot.sh

say() { printf "==> $1\n" "${@:2}"; }

# The arch we build in: the job's, or this worker's own for an "any" package.
arch=$job_arch
[[ $arch == any ]] && arch=$ARCHCI_ARCH
[[ $arch == "$ARCHCI_ARCH" ]] || archci_die "job $job_id is for $job_arch but this worker builds $ARCHCI_ARCH"
profile=${job_profile:-$(archci_profile "$job_repo")}
chroot=$ARCHCI_CHROOTS/$profile-$arch
# Chroot configs. devtools only ships x86_64 ones, so a port arch takes its
# makepkg.conf (and optionally its pacman <profile>.conf) from an overlay:
# /etc/archci/<arch>/ (local), then arch/<arch>/ shipped with archci, then
# devtools. The devtools pacman.conf includes the host's mirrorlist and
# arch-nspawn copies the host's pacman trust, so a native port worker whose own
# pacman already uses the port's repo and key needs no pacman override.
pacconf=$(archci_arch_conf "$arch" "$profile.conf" /usr/share/devtools/pacman.conf.d/"$profile.conf")
mkconf=$(archci_arch_conf "$arch" makepkg.conf /usr/share/devtools/makepkg.conf.d/"$arch.conf")
[[ -f $pacconf ]] || archci_die "no pacman.conf for repo $job_repo on $arch ($pacconf)"
# With the released repository's URL, the chroot resolves dependencies from
# what the farm has built before the mirrors.
if [[ -n $ARCHCI_RELEASE_URL ]]; then
	archci_chroot_pacconf "$pacconf" "$ARCHCI_WORKER_HOME/chroot-conf/$job_repo-$profile-$arch.conf" "$job_repo" "$arch"
	pacconf=$ARCHCI_WORKER_HOME/chroot-conf/$job_repo-$profile-$arch.conf
fi
[[ -f $mkconf ]] || archci_die "no makepkg.conf for $arch (devtools has none; add /etc/archci/$arch/makepkg.conf)"
base_packages=(base-devel)
[[ $profile == multilib* ]] && base_packages+=(multilib-devel)
# The chroot's pacman cache: a port's pacman.conf names one of its own (its
# "any" packages share names with the host's but not bytes); the host's
# otherwise. arch-nspawn reads it from the pacman.conf, mkarchroot needs -c.
cachedir=$(pacman-conf --config "$pacconf" CacheDir | head -1)
: "${cachedir:=/var/cache/pacman/pkg/}"
mkdir -p "$cachedir"
copy=archci-$instance
srcdir=$ARCHCI_WORKER_HOME/build/$instance/$job_pkgbase
printf '%s\n' "$chroot/$copy" >"${jobfile%/*}/copydir"   # for the worker's per-job heartbeat stats

echo "==> archci-build $job_id on $HOSTNAME at $(archci_now)"
echo "    repo=$job_repo arch=$job_arch profile=$profile chroot=$chroot copy=$copy commit=$job_commit"
echo "    pacman.conf=$pacconf makepkg.conf=$mkconf cache=$cachedir"

# --- clean chroot: create once, refresh periodically, recreate on devtools bumps
prepare_root() {
	local have=
	[[ -f $chroot/root/.arch-chroot ]] && have=$(<"$chroot/root/.arch-chroot")
	if [[ ! -d $chroot/root || $have != "$CHROOT_VERSION" ]]; then
		say "Creating chroot %s (version %s)" "$chroot/root" "$CHROOT_VERSION"
		local c
		for c in "$chroot"/*/; do
			[[ -d $c ]] || continue
			subvolume_delete_recursive "${c%/}" || true
			rm -rf --one-file-system "${c%/}"
		done
		rm -rf --one-file-system "$chroot"
		(umask 0022; mkdir -p "$chroot")
		mkarchroot -C "$pacconf" -M "$mkconf" -c "$cachedir" "$chroot/root" "${base_packages[@]}"
		touch "$chroot/root.updated"
	elif [[ -z $(find "$chroot/root.updated" -mmin -"$ARCHCI_CHROOT_UPDATE_MINUTES" 2>/dev/null) ]] ||
	     ! cmp -s "$pacconf" "$chroot/root/etc/pacman.conf"; then
		# also when the pacman.conf changed (a repository or cache added): the
		# update writes it into the root, and makechrootpkg's own pacman in
		# each copy reads that one, not ours
		say "Updating chroot %s" "$chroot/root"
		arch-nspawn -C "$pacconf" -M "$mkconf" -c "$cachedir" "$chroot/root" pacman -Syuu --noconfirm
		touch "$chroot/root.updated"
	fi
}
# The environment every build sees: ARCHCI_BUILD_ENV as a makepkg.conf
# drop-in in the clean chroot, which each build copy inherits.
build_env() {
	local conf=$chroot/root/etc/makepkg.conf.d/archci.conf kv
	if [[ -z $ARCHCI_BUILD_ENV ]]; then rm -f "$conf"; return; fi
	{
		echo "# written by archci-build from ARCHCI_BUILD_ENV"
		for kv in $ARCHCI_BUILD_ENV; do printf "export %s='%s'\n" "${kv%%=*}" "${kv#*=}"; done
	} >"$conf.new"
	cmp -s "$conf.new" "$conf" 2>/dev/null || install -Dm644 "$conf.new" "$conf"
	rm -f "$conf.new"
}
mkdir -p "$chroot"
lock 9 "$chroot/root.lock" "Waiting for the clean chroot"
prepare_root
build_env
lock_close 9

# --- sources: the package directory of the PKGBUILD repository at exactly
# the job's commit. One bare mirror per worker host is shared by its
# instances (fetches serialized by a lock); the directory is exported from it
# with git archive, so no working tree is ever checked out.
subdir=$ARCHCI_PKGBUILDS_DIR/$job_pkgbase
say "Fetching %s at %s from %s" "$subdir" "$job_commit" "$ARCHCI_PKGBUILDS_URL"
export GIT_TERMINAL_PROMPT=0
mirror=$ARCHCI_WORKER_HOME/pkgbuilds.git
(
	exec 7>"$mirror.lock"
	flock 7
	if [[ ! -d $mirror ]]; then
		git clone -q --bare "$ARCHCI_PKGBUILDS_URL" "$mirror"
	fi
	# The URL is config; follow it even on an existing mirror.
	git -C "$mirror" remote set-url origin "$ARCHCI_PKGBUILDS_URL"
	if ! git -C "$mirror" cat-file -e "$job_commit^{commit}" 2>/dev/null; then
		# Fetch the bare sha; a server that refuses that still serves the branch.
		git -C "$mirror" fetch -q origin "$job_commit" 2>/dev/null ||
			git -C "$mirror" fetch -q origin "+refs/heads/$ARCHCI_PKGBUILDS_BRANCH:refs/heads/$ARCHCI_PKGBUILDS_BRANCH"
	fi
	git -C "$mirror" cat-file -e "$job_commit^{commit}" 2>/dev/null
) || archci_die "commit $job_commit is not in $ARCHCI_PKGBUILDS_URL"
rm -rf "$srcdir"
mkdir -p "$srcdir"
depth=$(( $(printf '%s' "$subdir" | tr -cd / | wc -c) + 1 ))
git -C "$mirror" archive --format=tar "$job_commit" "$subdir" | tar -x --strip-components="$depth" -C "$srcdir" ||
	archci_die "no $subdir in $ARCHCI_PKGBUILDS_URL at $job_commit"
[[ -f $srcdir/PKGBUILD ]] || archci_die "no PKGBUILD in $subdir at $job_commit"
chmod -R a+rX "$srcdir"

# --- build
mkdir -p "$outdir" "$ARCHCI_WORKER_HOME/srcdest"
chown "$ARCHCI_BUILD_USER" "$ARCHCI_WORKER_HOME/srcdest" "$outdir"
export PKGDEST=$outdir LOGDEST=$outdir SRCPKGDEST=$outdir
export SRCDEST=$ARCHCI_WORKER_HOME/srcdest
SOURCE_DATE_EPOCH=$(git -C "$mirror" log -1 --format=%ct "$job_commit")
export SOURCE_DATE_EPOCH
export BUILDTOOL=archci BUILDTOOLVER=1
export PACKAGER=$ARCHCI_PACKAGER

say "Building %s %s in %s" "$job_pkgbase" "$job_version" "$copy"
cd "$srcdir"
# Upstream source signatures. makechrootpkg verifies the sources on the host,
# as $ARCHCI_BUILD_USER with its GNUPGHOME (makepkg --verifysource), before
# the chroot build, which then skips integrity checks. The keys a PKGBUILD's
# validpgpkeys names come with it in keys/pgp/<fingerprint>.asc, as in Arch's
# packaging repositories; import them into a keyring of ours for that user.
# A package whose keys are missing fails its signature check, unless
# ARCHCI_MAKEPKG_ARGS says --skippgpcheck.
export GNUPGHOME=$ARCHCI_WORKER_HOME/gnupg
install -d -m 700 -o "$ARCHCI_BUILD_USER" -g "$(id -gn "$ARCHCI_BUILD_USER")" "$GNUPGHOME"
if compgen -G "$srcdir/keys/pgp/*.asc" >/dev/null; then
	runuser -u "$ARCHCI_BUILD_USER" -- env GNUPGHOME="$GNUPGHOME" gpg --batch --quiet --import "$srcdir"/keys/pgp/*.asc 2>/dev/null ||
		echo "==> WARNING: importing keys/pgp/*.asc failed; the signature check will say"
	say "Imported %s upstream signing key(s) from keys/pgp" "$(find "$srcdir/keys/pgp" -name '*.asc' | wc -l)"
fi
# keys/pgp/ lags upstream: a maintainer's new signing subkey or extended
# expiry is not in the copy Arch's repository carries until someone updates
# it, and a PKGBUILD may name a key it ships no file for. Refresh every
# fingerprint validpgpkeys names from the keyservers (a key already there
# gains what it lacks); a lookup that fails leaves what keys/pgp gave.
if [[ -n $ARCHCI_KEYSERVERS ]]; then
	# (--printsrcinfo insists on a writable BUILDDIR, though it builds nothing)
	mapfile -t fingerprints < <(runuser -u "$ARCHCI_BUILD_USER" -- env BUILDDIR="$ARCHCI_WORKER_HOME/srcdest" makepkg --printsrcinfo 2>/dev/null | sed -n 's/^\tvalidpgpkeys = //p')
	if (( ${#fingerprints[@]} )); then
		for keyserver in $ARCHCI_KEYSERVERS; do
			if runuser -u "$ARCHCI_BUILD_USER" -- env GNUPGHOME="$GNUPGHOME" timeout 120 \
				gpg --batch --quiet --keyserver "$keyserver" --recv-keys "${fingerprints[@]}" 2>/dev/null; then
				say "Refreshed %s signing key(s) from %s" "${#fingerprints[@]}" "$keyserver"
			else
				echo "==> WARNING: could not refresh all of ${#fingerprints[@]} signing key(s) from $keyserver"
			fi
		done
	fi
fi
mcp_args=(-c -r "$chroot" -l "$copy" -U "$ARCHCI_BUILD_USER")
# ARCHCI_MAKEPKG_ARGS is passed to makepkg after -- (default: none).
extra_makepkg_args=()
[[ -n $ARCHCI_MAKEPKG_ARGS ]] && read -ra extra_makepkg_args <<<"$ARCHCI_MAKEPKG_ARGS"
# PKGBUILDs carried from Arch declare arch=(x86_64) unless a patch in the
# repository adds the port arch; a port arch builds them anyway (the Arch
# Linux Ports RFC keeps the arch array as is and has the tooling ignore it).
if [[ $job_arch != any && $job_arch != x86_64 && $ARCHCI_IGNOREARCH == 1 ]]; then
	extra_makepkg_args+=(--ignorearch)
fi
# Another arch than the machine's means qemu user-mode emulation, where test
# suites fail on the emulation more than on the package.
if [[ $arch != "$(uname -m)" && $ARCHCI_EMULATED_NOCHECK == 1 ]]; then
	extra_makepkg_args+=(--nocheck)
	say "Building %s under emulation: check() skipped (ARCHCI_EMULATED_NOCHECK)" "$arch"
fi
(( ${#extra_makepkg_args[@]} )) && mcp_args+=(-- "${extra_makepkg_args[@]}")
# Through archci_watchdog's pipe on purpose: systemd-nspawn (arch-nspawn's
# --console=autopipe)
# passes the container's stdout through when it is a pipe or a file, but drops
# it when it is the unit's journal stream socket, which left every line makepkg
# printed inside the chroot out of the journal and of build.log. pipefail
# makes rc makechrootpkg's own status.
# A build silent for ARCHCI_BUILD_MAX_IDLE_MINUTES is a stuck test suite: kill it
# rather than hold the worker until the unit's TimeoutStartSec.
rc=0
archci_watchdog "$(( ARCHCI_BUILD_MAX_IDLE_MINUTES * 60 ))" -- makechrootpkg "${mcp_args[@]}" || rc=$?
if (( rc == 124 )); then
	# the container's own processes live in a scope of their own; make sure none survive
	pkill -KILL -f -- "--directory=$chroot/$copy" 2>/dev/null || true
	echo "==> build killed after $ARCHCI_BUILD_MAX_IDLE_MINUTES min without output"
fi
(( rc == 0 )) || echo "==> makechrootpkg exited with $rc"

shopt -s nullglob
pkgs=("$outdir"/*.pkg.tar.zst)
if (( rc == 0 && ${#pkgs[@]} == 0 )); then
	echo "==> build reported success but produced no packages"
	rc=1
fi

# Builder signature: internal provenance the signer verifies before it adds the
# client-facing release signature. Each package gets a detached <pkg>.buildsig.
# A package with no valid builder signature is rejected by the signer, so a
# missing builder key is a hard error.
if (( rc == 0 && ${#pkgs[@]} )); then
	if [[ ! -d $ARCHCI_BUILDER_GNUPGHOME ]]; then
		echo "==> no builder key at $ARCHCI_BUILDER_GNUPGHOME (archci-worker-setup makes one)"
		rc=1
	else
		for pkg in "${pkgs[@]}"; do
			if gpg --homedir "$ARCHCI_BUILDER_GNUPGHOME" --batch --yes \
					--detach-sign -u "$ARCHCI_BUILDER_KEY" -o "$pkg.buildsig" "$pkg"; then
				echo "==> builder-signed ${pkg##*/}"
			else
				echo "==> failed to builder-sign ${pkg##*/}"
				rc=1; break
			fi
		done
	fi
fi
if (( rc == 0 )); then echo success; else echo failure; fi >"$outdir/result"
echo "==> archci-build finished with $rc at $(archci_now): ${pkgs[*]##*/}"
rm -rf "$srcdir"
exit "$rc"
