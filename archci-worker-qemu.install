# shellcheck shell=bash
# archci-worker-qemu-<arch>: build another architecture on this worker under
# qemu user-mode emulation. The package ships the pieces devtools lacks for
# that (docs/ports.md); this script activates the two that need it. Shared by
# every archci-worker-qemu-<arch> package: it acts on whatever is installed.

post_install() {
  local k a
  # The chroot inherits the host's pacman trust (mkarchroot and arch-nspawn
  # copy it in), so a port repo key the package ships must be trusted here.
  for k in /usr/share/pacman/keyrings/archci-ports-*.gpg; do
    [[ -e $k ]] || continue
    k=${k##*/}; k=${k%.gpg}
    if [[ -x /usr/bin/pacman-key && -f /etc/pacman.d/gnupg/pubring.gpg ]]; then
      pacman-key --populate "$k"
    else
      echo "==> run: pacman-key --init && pacman-key --populate $k"
    fi
  done
  # Re-register the emulators with the C flag from /etc/binfmt.d.
  systemctl restart systemd-binfmt.service 2>/dev/null || true
  for a in /etc/binfmt.d/qemu-*-static.conf; do
    [[ -e $a ]] || continue
    a=${a##*/qemu-}; a=${a%-static.conf}
    if [[ $(uname -m) == "$a" ]]; then
      echo "==> WARNING: this is a $a machine; it builds $a natively with archci-worker@N," >&2
      echo "    and the qemu-$a binfmt registration is not wanted here. Remove archci-worker-qemu-$a." >&2
    else
      echo "==> Start a $a worker instance (the master must list $a in ARCHCI_ARCHES):"
      echo "      systemctl enable --now archci-worker-$a@1"
    fi
  done
}

post_upgrade() {
  post_install "$1"
}

post_remove() {
  systemctl restart systemd-binfmt.service 2>/dev/null || true
  echo "==> Port repo keys stay in the pacman keyring; list them with pacman-key --list-keys"
  echo "    and drop one with pacman-key --delete <fingerprint>."
}
